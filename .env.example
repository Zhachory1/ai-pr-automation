# --- Agent fleet support substrate (docker compose) ---
# Copy to .env, fill values, never commit .env.
#
# Compose owns queue control and producers. Host-native Hermes keeps provider/GitHub effect
# credentials and executes profile-scoped Runs API calls. Controller receives only Postgres access
# and profile API keys; producers receive a read-only GitHub token.

# Host-absolute path to your coding root. NOT relative. coderag mounts this read-only.
CODE_ROOT=/Users/zhach/code

# Our request-tracking Postgres
REQUESTS_DB_USER=fleet
REQUESTS_DB_PASSWORD=change-me
REQUESTS_DB_NAME=fleet
REQUESTS_DB_PORT=5432
# (REQUESTS_DB_PASSWORD is required by docker-compose.yml — no default.)

# Unified UI (https://localhost:8080; Fleet Controller at https://fleet.localhost:8080).
# Files must stay outside CODE_ROOT and .git.
FLEET_CONTROLLER_USERNAME=fleet
FLEET_CONTROLLER_SESSION_SECRET_FILE=/Users/YOU/.config/ai-pr-automation/fleet-controller-session-secret
FLEET_CONTROLLER_TLS_CA_CERT_FILE=/Users/YOU/.config/ai-pr-automation-ui/fleet-controller-ca.crt
FLEET_CONTROLLER_TLS_CERT_FILE=/Users/YOU/.config/ai-pr-automation-ui/fleet-controller.crt
FLEET_CONTROLLER_TLS_KEY_FILE=/Users/YOU/.config/ai-pr-automation-ui/fleet-controller.key
FLEET_CONTROLLER_SESSION_SECONDS=43200
# Profile-scoped Runs API key bundle (generated by hermes-native sync-support; controller-only).
HERMES_API_KEYS_FILE=/Users/Shared/ai-pr-automation-runtime/secrets/hermes-api-keys.json
# Dedicated signed Kanban bridge key (generated by hermes-native sync-support; controller-only).
HERMES_KANBAN_BRIDGE_KEY_FILE=/Users/Shared/ai-pr-automation-runtime/hermes-bridge-secrets/key.json
# Read-only token used only by Compose discovery producers.
GITHUB_READ_TOKEN_FILE=/Users/Shared/ai-pr-automation-runtime/secrets/github-read-token
# Canonical operator scope-of-attention allowlist and Docker-readable mirror maintained by fleet.sh.
HERMES_AUTHORITY_SOURCE_FILE=/usr/local/etc/ai-pr-automation/authority.yaml
HERMES_DOCKER_AUTHORITY_FILE=/Users/Shared/zhach-ai-pr-automation/authority.yaml
# STATUS_PORT=8080

# Fleet Controller decision-UI scope. These label which repositories the operator expects work for;
# host-native producers own the actual discovery/enqueue.
PR_PRODUCER_REPOSITORIES=
PR_PRODUCER_ORGS=
PR_PRODUCER_ALLOW_ALL_REPOS=false
# Controller deterministic effect paths. Hermes profiles never receive publication or DB access.
# DOC_WRITE_DAILY_CAP=30
DOC_WRITER_STAGE_HOST=/Users/Shared/ai-pr-automation-runtime/doc-writer
DOC_WRITER_INBOX_HOST=/Users/YOU/private-docs/inbox
HANDOFF_ROOT=/Users/Shared/ai-pr-automation-runtime/safety-handoffs
PR_SAFETY_SNAPSHOT_ROOT=/Users/Shared/ai-pr-automation-runtime/safety-snapshots
PR_SAFETY_POLICY_PATH=/usr/local/etc/ai-pr-automation/pr-safety-policy-v1.md
PR_SAFETY_POLICY_VERSION=v1
PR_SAFETY_POLICY_DIGEST=
# Opt-in only. single preserves current one-model safety analysis; kanban uses fixed council graph.
PR_SAFETY_ANALYSIS_ENGINE=single
PR_SAFETY_MERGED_PR_AUTHORS=Zhachory1,zhach1
MEMORY_SOURCE_HOST=/Users/YOU/private-docs
MEMORY_CURATOR_STATE_HOST=/Users/Shared/ai-pr-automation-runtime/memory-curator
# PR_PRODUCER_INTERVAL_SECONDS=300
# PR_SAFETY_PRODUCER_INTERVAL_SECONDS=60
# HERMES_MEMORY_CURATE_INTERVAL_SECONDS=21600

# hindsight (agent memory). hindsight runs an LLM to extract facts on every retain, so it needs
# a keyed provider. Use a real API key; keyless subscription providers (claude-code) do NOT work
# headless in a container (no logged-in session). See docker/README.
HINDSIGHT_DB_PASSWORD=change-me
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY=
# HINDSIGHT_SHARED_BANK=fleet-shared

# coderag (shared code-graph daemon) + swarmvault (shared doc vault). Images built locally.
CODERAG_VERSION=latest
SWARMVAULT_VERSION=latest
# Finder-visible SwarmVault host directory. Must be outside CODE_ROOT.
SWARMVAULT_VAULT="/Users/YOU/Documents/agent-fleet/swarmvault"
