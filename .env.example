# --- Agent fleet substrate (docker compose) ---
# Copy to .env, fill values, never commit .env.

# Host-absolute path to your coding root. NOT relative. coderag mounts this read-only.
CODE_ROOT=/Users/zhach/code

# Non-root container uid/gid for the agent-server workers (#92). MUST be the uid that owns CODE_ROOT
# on the host, so the maintain worker can write worktrees under it. Default 501 = the macOS host user;
# on Linux set these to your `id -u` / `id -g`.
FLEET_UID=501
FLEET_GID=501

# Our request-tracking Postgres
REQUESTS_DB_USER=fleet
REQUESTS_DB_PASSWORD=change-me
REQUESTS_DB_NAME=fleet
REQUESTS_DB_PORT=5432
# (REQUESTS_DB_PASSWORD is required by docker-compose.yml — no default.)

# Scheduled PR discovery. Configure at least one repository/org unless allow-all is deliberate.
PR_PRODUCER_REPOSITORIES=
PR_PRODUCER_ORGS=
PR_PRODUCER_ALLOW_ALL_REPOS=false
PR_PRODUCER_INTERVAL_SECONDS=900
PR_PRODUCER_GH_TIMEOUT_SECONDS=60
PR_PRODUCER_MAX_UPDATED_AGE_DAYS=0
PR_PRODUCER_MAX_ATTEMPTS=3

# Queue-worker leases. Heartbeat must be at most one third of lease duration.
AGENT_SERVER_LEASE_SECONDS=120
AGENT_SERVER_LEASE_HEARTBEAT=30
AGENT_SERVER_LEASE_DB_TIMEOUT=10
AGENT_SERVER_MAINTAIN_REPLICAS=1
# Must exceed AGENT_SERVER_PER_REQUEST_TIMEOUT plus setup/write-gate cleanup time.
AGENT_SERVER_STOP_GRACE_PERIOD=35m

# hindsight (agent memory). hindsight runs an LLM to extract facts on every retain, so it needs
# a keyed provider. Use a real API key; keyless subscription providers (claude-code) do NOT work
# headless in a container (no logged-in session). See docker/README.
HINDSIGHT_DB_PASSWORD=change-me
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY=

# coderag (shared code-graph daemon) + swarmvault (shared doc vault). Images built locally.
CODERAG_VERSION=latest
SWARMVAULT_VERSION=latest
# Finder-visible SwarmVault host directory. Must be outside CODE_ROOT.
SWARMVAULT_VAULT="/Users/YOU/Documents/agent-fleet/swarmvault"

# --- draft-only PR safety analyst ---
# All paths must be host-absolute. Snapshot and policy roots mount read-only into PR-safety worker;
# HANDOFF_ROOT and PR_SAFETY_WORK_ROOT are worker-owned local storage.
PR_SAFETY_SNAPSHOT_ROOT=/Users/zhach/.local/share/ai-pr-automation/safety-snapshots
PR_SAFETY_POLICY_ROOT=/Users/zhach/.local/share/ai-pr-automation/safety-policies
# Pinned, regular file beneath PR_SAFETY_POLICY_ROOT. Compute digest with: shasum -a 256 policy.md
PR_SAFETY_POLICY_PATH=/Users/zhach/.local/share/ai-pr-automation/safety-policies/policy.md
PR_SAFETY_POLICY_VERSION=v1
PR_SAFETY_POLICY_DIGEST=
PR_SAFETY_WORK_ROOT=/Users/zhach/.local/share/ai-pr-automation/safety-work
PR_SAFETY_SERVER_STOP_GRACE_PERIOD=35m
HANDOFF_ROOT=/Users/zhach/.local/share/ai-pr-automation/safety-handoffs
# OPENAI_API_KEY is the analyst model credential. The analyst also receives read-only investigation
# credentials below; none carry GitHub/CI/Datadog write scope. Keep write-scoped tokens out of these.
OPENAI_API_KEY=
# Read-only investigation credentials passed to the agent subprocess:
#   GH_TOKEN            fine-grained/classic token with read scopes only (contents/PR/checks: read)
#   BUILDKITE_API_TOKEN read-only Buildkite API token (used by the Buildkite MCP)
#   DD_PAT              Datadog Personal Access Token (ddpat_...), standalone bearer, read scopes only
GH_TOKEN=
BUILDKITE_API_TOKEN=
DD_PAT=
# Analyst model. Provider-qualified so it binds the OpenAI provider (must match the egress allowlist).
PR_SAFETY_ANALYST_MODEL=openai/gpt-5.6-luna

# --- merged-PR producer (host launchd; see scripts/pr-safety-merged-pr-producer-launch.sh) ---
# Reviews MERGED PRs authored by these GitHub logins across the org (comma-separated). The fleet
# GH_TOKEN above must be SAML-authorized for the org. Snapshots each merge commit read-only.
PR_SAFETY_MERGED_PR_AUTHORS=roktfleet,brucerokt
# Most-recent merged PRs to scan per author each run (look-back window; the event ledger dedupes).
# Kept small to avoid a first-run stampede of concurrent full-repo clones. Default 10.
# PR_SAFETY_MERGED_PR_SEARCH_LIMIT=10
# Snapshot retention: keep at most this many newest snapshots; older ones are GC'd after each run
# unless still referenced by a queued/running review. Default 25; 0 disables.
# PR_SAFETY_SNAPSHOT_KEEP=25

# --- memory-curator (docker compose --profile memory-curator) ---
# Host source roots mounted READ-ONLY into the curator container.
MEMORY_CURATOR_TASKS_HOST=/Users/CHANGE_ME/.mewrite/agent/tasks
MEMORY_CURATOR_PRIVATE_DOCS_HOST=/Users/CHANGE_ME/private-docs
# Optional tuning (defaults shown):
# MEMORY_CURATOR_MODEL=openai/gpt-5.6-sol
# MEMORY_CURATOR_INTERVAL=21600            # seconds between runs (6h)
# MEMORY_CURATOR_MAX_MEMORIES=15
# MEMORY_CURATOR_MAX_SOURCE_DOCS=40
# MEMORY_CURATOR_PROMPT_MAX_BYTES=96000    # keep the argv prompt under the container ARG_MAX ceiling
