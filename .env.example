# --- Agent fleet support substrate (docker compose) ---
# Copy to .env, fill values, never commit .env.
#
# Compose runs direct review and maintenance crons against the personal Hermes Runs API.
# `scripts/fleet.sh support-up` starts support services without a discovery token.
# Configure owner-only discovery token and per-profile API keys before `scripts/fleet.sh up`.

# Host-absolute path to your coding root. NOT relative. coderag mounts this read-only.
CODE_ROOT=/Users/zhach/code

# Historical requests_pgdata is preserved by Compose but no longer started.
# Unified UI (https://localhost:8080; Hermes Runs API health at https://hermes.localhost:8080/health).
# TLS files must stay outside CODE_ROOT and .git.
FLEET_CONTROLLER_TLS_CERT_FILE=/Users/YOU/.config/ai-pr-automation-ui/fleet-controller.crt
FLEET_CONTROLLER_TLS_KEY_FILE=/Users/YOU/.config/ai-pr-automation-ui/fleet-controller.key
# Both direct PR crons share a discovery token; each mounts its own Runs API key.
# Create all three owner-only files before starting PR cron producers; support-up needs none of them.
# Do not mount the full key bundle here.
GITHUB_DISCOVERY_TOKEN_FILE=/Users/Shared/ai-pr-automation-runtime/secrets/github-discovery-token
HERMES_REVIEW_API_KEY_FILE=/Users/Shared/ai-pr-automation-runtime/secrets/hermes-review-key
HERMES_MAINTAIN_API_KEY_FILE=/Users/Shared/ai-pr-automation-runtime/secrets/hermes-maintain-key
PR_REVIEW_CRON_SCHEDULE="*/5 * * * *"
PR_MAINTAIN_CRON_SCHEDULE="*/5 * * * *"
# Canonical operator scope-of-attention allowlist and Docker-readable mirror maintained by fleet.sh.
# fleet.sh uses shell exports, not these .env values, for non-default authority paths.
HERMES_AUTHORITY_SOURCE_FILE=/usr/local/etc/ai-pr-automation/authority.yaml
HERMES_DOCKER_AUTHORITY_FILE=/Users/Shared/zhach-ai-pr-automation/authority.yaml
# STATUS_PORT=8080
# Signal REST container: operator UI at https://localhost:8080/signal/;
# host Hermes can call http://127.0.0.1:18080/v2/send through this loopback-only port.
# SIGNAL_LOCAL_PORT=18080
# Do not point the old Hermes SIGNAL_HTTP_URL at this REST API; it expects /api/v1/check.

# Experimental manual producer invocation only: neither Compose nor host launchd forwards these
# settings from .env. Default discovery remains --assignee @me / --author @me. To use owner-wide
# discovery, wire each variable explicitly to the intended producer and grant owner/* authority.
# PR_REVIEW_DISCOVER_ALL_OWNERS=Zhachory1,zhach1
# PR_MAINTAIN_DISCOVER_ALL_OWNERS=Zhachory1,zhach1
# The discovery token must identify the same GitHub login as the host maintenance profile:
# --author @me and own-reply filtering both use that token's login.

# hindsight (agent memory). hindsight runs an LLM to extract facts on every retain, so it needs
# a keyed provider. Use a real API key; keyless subscription providers (claude-code) do NOT work
# headless in a container (no logged-in session). See docker/README.
HINDSIGHT_DB_PASSWORD=change-me
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY=
# HINDSIGHT_SHARED_BANK=fleet-shared

# coderag shared code-graph daemon. Built locally from the pinned upstream ref.
CODERAG_VERSION=latest
