    },
    "council-security": {
      "source": "security-engineer",
      "role": "security",
      "model": "claude-haiku-4-5-20251001"
    },
    "council-reliability": {
      "source": "site-reliability-engineer",
      "role": "reliability",
      "model": "claude-haiku-4-5-20251001"
    },
    "council-architect": {
      "source": "technical-architect",
      "role": "architecture",
      "model": "claude-haiku-4-5-20251001"
    },
    "council-verifier": {
      "source": "verifier",
      "role": "verification",
      "model": "claude-haiku-4-5-20251001"
