# Render these absolute, local paths into the owner-only week-planner profile .env.
# OAuth credentials, tokens, and personal rules never belong in this file or Git.
HERMES_WEEK_CALENDAR_PYTHON=/ABSOLUTE/PATH/TO/hermes-agent/venv/bin/python
HERMES_WEEK_CALENDAR_SCRIPT=/ABSOLUTE/PATH/TO/ai-pr-automation/scripts/hermes-week-calendar.py
HERMES_WEEK_PLANNER_HOME=/ABSOLUTE/PATH/TO/.hermes/profiles/week-planner
