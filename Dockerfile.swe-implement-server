# swe-implement-server image: serial worker for the 'swe-implement' queue kind. Like agent-server
# (git + gh + jq + psql + node/mewritecode) since it clones repos and runs the swe-implementer
# harness, plus language toolchains (python/make/g++/node/go/just) so the agent can run repos'
# validation commands in-container instead of reporting "command not found" (#65).
# Build: docker build -f Dockerfile.swe-implement-server -t agent-fleet/swe-implement-server .
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      bash git jq curl ca-certificates coreutils postgresql-client gnupg \
      python3 make g++ \
 && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g @zhachory1/mewrite-code

# Language toolchains for in-container validation. Only the ones that actually surfaced as missing
# (go, just) — python3/make/g++/node are already installed above. We deliberately do NOT try to bake
# every ROKT toolchain (see #65): the draft PR's own CI remains the authoritative signal; this just
# lets the swe-implementer run the common validation commands instead of reporting "command not found".
ARG GO_VERSION=1.23.4
ARG JUST_VERSION=1.36.0
RUN arch="$(dpkg --print-architecture)" \
 && case "$arch" in \
      amd64) go_arch=amd64; just_arch=x86_64-unknown-linux-musl ;; \
      arm64) go_arch=arm64; just_arch=aarch64-unknown-linux-musl ;; \
      *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac \
 && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${go_arch}.tar.gz" | tar -C /usr/local -xz \
 && curl -fsSL "https://github.com/casey/just/releases/download/${JUST_VERSION}/just-${JUST_VERSION}-${just_arch}.tar.gz" \
      | tar -C /usr/local/bin -xz just \
 && /usr/local/go/bin/go version && just --version
# GOTOOLCHAIN=auto (Go's default) lets `go` fetch the exact version a repo's go.mod pins (repos
# routinely require a newer Go than we bake); the bundled GO_VERSION is just the bootstrap. This
# needs egress to proxy.golang.org, which the worker already has (it clones + pushes).
ENV PATH="/usr/local/go/bin:${PATH}" GOTOOLCHAIN=auto

WORKDIR /app
COPY bin/ ./bin/
COPY lib/ ./lib/
COPY agent-config/ ./agent-config/
RUN chmod +x bin/*

ENV MEWRITE_CODING_AGENT_DIR=/app/agent-config
# The harness defaults to ~/.mewrite/agents; in-container the persona is vendored here.
ENV SWE_IMPLEMENTER_AGENT=/app/agent-config/agents/swe-implementer.md

# Drop root: run as a non-root user (#92). Writes only to the /work named volume; reads the mounted
# handoff dir read-only. Pre-create /work owned by fleet so Docker copies that ownership onto a FRESH
# empty named volume (otherwise the mount lands root-owned and unwritable). No host code-root mount.
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin fleet \
 && mkdir -p /work \
 && chown -R fleet:fleet /app /work
USER fleet

# Serial worker for kind=swe-implement. gh/push use GH_TOKEN; mewritecode uses OPENAI_API_KEY.
# No creds baked in; all via env (compose env_file: .env).
ENTRYPOINT ["bin/swe-implement-server"]
