# Isolated draft-only analyst. Carries read tooling (git, gh, curl) and read MCP config only.
# No psql, no host-code, no write credentials are baked in; credentials arrive at runtime via env.
FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git python3 make g++ curl ca-certificates gnupg \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*
RUN npm install -g @zhachory1/mewrite-code mcp-remote@0.3.0
WORKDIR /app
RUN mkdir -p /output /input
COPY agent-config/skills/pr-safety-review/ /app/agent-config/skills/pr-safety-review/
COPY agent-config/pr-safety-mcp.json /app/agent-config/mcp.json
# Raise the analyst's max output tokens above the 16384 default so large multi-finding reviews
# are not truncated into invalid JSON (observed: a full predictor review cut off mid-array).
COPY agent-config/pr-safety-models.json /app/agent-config/models.json
ENV MEWRITE_CODING_AGENT_DIR=/app/agent-config
USER 65532:65532
ENTRYPOINT ["mewritecode", "exec"]
