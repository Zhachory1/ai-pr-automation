# Local status and human-review web view for the agent fleet (M3). Thin: python3 + psql client only.
# Build: docker build -f Dockerfile.status -t agent-fleet/status .
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 postgresql-client ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY bin/status-server ./bin/status-server
RUN chmod +x bin/status-server
# Only queue-state POSTs are allowed; it cannot invoke GitHub. Config + PGPASSWORD via env.
ENTRYPOINT ["python3", "bin/status-server"]
