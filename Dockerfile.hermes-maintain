FROM nousresearch/hermes-agent@sha256:6d7285e1476d0661fc347e3d55245c99decb781d76d39d67582166d2c9561874

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash git gh jq ca-certificates coreutils findutils gawk grep sed util-linux postgresql-client \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY bin/agent-server bin/hermes-maintain-runner.sh ./bin/
COPY lib/queue.sh ./lib/queue.sh
RUN chmod +x bin/agent-server bin/hermes-maintain-runner.sh

ENTRYPOINT ["bin/agent-server"]
