[Unit]
Description=AI pull-request maintenance automation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=__HOME__
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PR_AUTOMATION_MAINTENANCE_RUNNER=__RUNNER__
Environment=PR_AUTOMATION_REPOSITORIES=__REPOSITORIES__
Environment=PR_AUTOMATION_GITHUB_ACCOUNT=__GITHUB_ACCOUNT__
ExecStart=__INSTALL_DIR__/bin/pr-automation maintain

[Install]
WantedBy=default.target
