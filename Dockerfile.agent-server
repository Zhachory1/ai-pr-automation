# agent-server image: leased workers scalable per kind. Carries gh + git + jq + psql + coreutils and the
# agent runner. Postgres/Redis/hindsight run in OTHER containers; this reaches them by service name.
# Build: docker build -f Dockerfile.agent-server -t agent-fleet/agent-server .
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      bash git jq curl ca-certificates coreutils util-linux postgresql-client gnupg \
      python3 make g++ \
 && rm -rf /var/lib/apt/lists/*

# GitHub CLI (gh)
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

# Node.js >=20 (mewritecode is a Node CLI; npx also drives the buildkite MCP via mcp-remote)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# --- agent runner: mewritecode (the public engine roktcode wraps) ---
# roktcode is private (internal registry) and macOS-only, so it can't go in a public Linux image.
# mewritecode is public on npm and is the same CLI (`mewritecode exec`). It reads OPENAI_API_KEY
# from env. Skills + MCP load from $MEWRITE_CODING_AGENT_DIR (set below to the vendored config).
RUN npm install -g @zhachory1/mewrite-code mcp-remote@0.3.0

WORKDIR /app
COPY bin/ ./bin/
COPY lib/ ./lib/
COPY agent-config/ ./agent-config/
RUN mkdir -p /app/pr-safety-agent-config/skills /app/pr-safety-agent-config/sessions \
 && cp -R /app/agent-config/skills/pr-safety-review /app/pr-safety-agent-config/skills/ \
 && cp /app/agent-config/pr-safety-mcp.json /app/pr-safety-agent-config/mcp.json \
 && cp /app/agent-config/pr-safety-models.json /app/pr-safety-agent-config/models.json \
 && chmod +x bin/*

# mewritecode discovers skills/agents/mcp from this dir (vendored: pr-review + deps, personas,
# Buildkite MCP plus internal Coderag, SwarmVault, and Hindsight HTTP MCP bridges; Buildkite auth is
# BUILDKITE_API_TOKEN via env at runtime).
ENV MEWRITE_CODING_AGENT_DIR=/app/agent-config

# AGENT_SERVER_KIND selects review/maintain. PR safety overrides entrypoint with its specialized handler.
# gh uses GH_TOKEN; mewritecode uses OPENAI_API_KEY; buildkite MCP uses BUILDKITE_API_TOKEN.
# Coderag, SwarmVault, and Hindsight MCP bridges use only internal Compose DNS.
# All injected via env (compose env_file: .env). No creds baked into the image.
#
# NOTE: this image intentionally does NOT bake a non-root USER. The maintain worker writes into the
# host code-root bind mount (${CODE_ROOT}:${CODE_ROOT}:rw), so it must run as the uid that OWNS that
# host directory. That uid is host-specific, so it is set at runtime via compose `user:` (FLEET_UID,
# default 501 = the human host owner) rather than hardcoded here. See docker-compose.yml + #92.
ENTRYPOINT ["bin/agent-server"]
