FROM python:3.11.11-slim-bookworm@sha256:081075da77b2b55c23c088251026fb69a7b2bf92471e491ff5fd75c192fd38e5

ARG GH_VERSION=2.102.0
RUN apt-get update && apt-get install -y --no-install-recommends bash cron jq curl ca-certificates \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
 && echo 'deb [signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main' \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update && apt-get install -y --no-install-recommends "gh=${GH_VERSION}" \
 && gh pr checks --help | grep -Fq -- '--json' \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY bin/hermes-pr-producer /app/bin/hermes-pr-producer
COPY scripts/hermes-authority.py scripts/hermes_direct_pr_journal.py scripts/hermes_run_request.py scripts/hermes-review-submit.py scripts/hermes-maintain-submit.py scripts/hermes-kanban-submit.py /app/scripts/
COPY scripts/hermes-review-cron-entrypoint.sh scripts/hermes-maintain-cron-entrypoint.sh /app/bin/
RUN chmod 0555 /app/bin/* /app/scripts/*
ENTRYPOINT ["/app/bin/hermes-review-cron-entrypoint.sh"]
