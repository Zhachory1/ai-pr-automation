#!/usr/bin/env python3
import argparse
import hashlib
import json
import os
import re
import signal
import sys
import time
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.parse import quote, urlparse
from urllib.request import HTTPRedirectHandler, ProxyHandler, Request, build_opener

MAX_REQUEST_BYTES = 1024 * 1024
MAX_RESPONSE_BYTES = 512 * 1024
MAX_OUTPUT_BYTES = 256 * 1024
ALLOWED_REQUEST_KEYS = {"input", "instructions", "model", "provider"}
ALLOWED_STATUSES = {
    "queued", "running", "waiting_for_approval", "stopping",
    "completed", "failed", "cancelled", "interrupted",
}
TERMINAL_STATUSES = {"completed", "failed", "cancelled", "interrupted"}
STOP_REQUESTED = False


class RejectRedirects(HTTPRedirectHandler):
    def redirect_request(self, *_):
        return None


OPENER = build_opener(ProxyHandler({}), RejectRedirects())


def emit(status, **fields):
    print(json.dumps({"status": status, **fields}, sort_keys=True, separators=(",", ":")))


def read_json(response):
    data = response.read(MAX_RESPONSE_BYTES + 1)
    if len(data) > MAX_RESPONSE_BYTES:
        raise ValueError("Hermes response exceeds byte cap")
    payload = json.loads(data)
    if not isinstance(payload, dict):
        raise ValueError("Hermes response must be a JSON object")
    return payload


def request(method, url, api_key, body=None, idempotency_key=None, timeout=10):
    headers = {"Authorization": f"Bearer {api_key}"}
    if body is not None:
        headers["Content-Type"] = "application/json"
    if idempotency_key:
        headers["Idempotency-Key"] = idempotency_key
    return OPENER.open(Request(url, data=body, headers=headers, method=method), timeout=timeout)


def validate(args):
    parsed = urlparse(args.url)
    if (parsed.scheme not in {"http", "https"} or not parsed.netloc or parsed.username or parsed.password
            or parsed.path not in {"", "/"} or parsed.query or parsed.fragment):
        raise ValueError("invalid Hermes URL")
    if len(args.api_key) < 16:
        raise ValueError("Hermes API key must be at least 16 characters")
    if not re.fullmatch(r"doc:[1-9][0-9]*:(draft|council)", args.idempotency_key):
        raise ValueError("invalid idempotency key")
    if not re.fullmatch(r"[0-9a-f]{64}", args.expected_digest):
        raise ValueError("invalid expected request digest")
    if args.timeout <= 0 or args.poll_interval <= 0:
        raise ValueError("timeouts must be positive")


def load_body(args):
    with Path(args.request_file).open("rb") as source:
        data = source.read(MAX_REQUEST_BYTES + 1)
    if len(data) > MAX_REQUEST_BYTES:
        raise ValueError("Hermes request exceeds byte cap")
    if hashlib.sha256(data).hexdigest() != args.expected_digest:
        raise ValueError("Hermes request digest mismatch")
    body = json.loads(data)
    if not isinstance(body, dict) or set(body) != ALLOWED_REQUEST_KEYS:
        raise ValueError("Hermes request must contain exactly input, instructions, model, provider")
    if not isinstance(body["input"], str) or not isinstance(body["instructions"], str):
        raise ValueError("Hermes input and instructions must be strings")
    if body["provider"] != args.provider or body["model"] != args.model:
        raise ValueError("Hermes provider/model override rejected")
    return data


def request_shutdown(*_):
    global STOP_REQUESTED
    STOP_REQUESTED = True


def stop_run(args, run_id):
    try:
        response = request(
            "POST", f"{args.url}/v1/runs/{quote(run_id, safe='')}/stop",
            args.api_key, body=b"{}", timeout=min(10, args.poll_interval),
        )
        confirmed = 200 <= response.status < 300
        response.close()
        return confirmed
    except Exception:
        return False


def submit(args, body):
    try:
        response = request(
            "POST", f"{args.url}/v1/runs", args.api_key, body=body,
            idempotency_key=args.idempotency_key, timeout=min(30, args.poll_interval),
        )
        if response.status != 202:
            raise ValueError(f"Hermes submit returned HTTP {response.status}")
        replayed = response.headers.get("Idempotency-Replayed", "").lower() == "true"
        try:
            payload = read_json(response)
        finally:
            response.close()
        run_id = payload.get("run_id")
        if not isinstance(run_id, str) or not run_id:
            raise ValueError("Hermes submit omitted run_id")
        return run_id, replayed
    except (ValueError, json.JSONDecodeError) as error:
        emit("reconcile", raw_status="invalid_submit_response", error=str(error))
        raise SystemExit(3)
    except HTTPError as error:
        code = error.code
        error.close()
        if 300 <= code < 400:
            emit("reconcile", raw_status=f"http_{code}", error="Hermes redirect rejected")
            raise SystemExit(3)
        if code == 409:
            emit("reconcile", raw_status="idempotency_conflict", error="Hermes idempotency conflict")
            raise SystemExit(3)
        if code >= 500:
            emit("submit_unknown", raw_status=f"http_{code}", error="Hermes submit outcome unknown")
            raise SystemExit(4)
        emit("failed", raw_status=f"http_{code}", error=f"Hermes submit returned HTTP {code}")
        raise SystemExit(2)
    except (TimeoutError, URLError, OSError):
        emit("submit_unknown", raw_status="transport_unknown", error="Hermes submit outcome unknown")
        raise SystemExit(4)


def safe_usage(value):
    if not isinstance(value, dict):
        return {}
    result = {}
    for key in ("input_tokens", "output_tokens", "total_tokens", "reasoning_tokens"):
        item = value.get(key)
        if isinstance(item, int) and not isinstance(item, bool) and item >= 0:
            result[key] = item
    return result


def status_of(payload):
    status = payload.get("status")
    if not isinstance(status, str) or status not in ALLOWED_STATUSES:
        raise ValueError("unknown Hermes status")
    return status


def settle_terminal(run_id, status, payload, replayed):
    if status == "completed":
        output = payload.get("output")
        if not isinstance(output, str):
            emit("failed", run_id=run_id, raw_status=status, error="completed run omitted text output")
            raise SystemExit(2)
        try:
            encoded = output.encode("utf-8")
        except UnicodeEncodeError:
            emit("failed", run_id=run_id, raw_status=status, error="Hermes output is not valid UTF-8")
            raise SystemExit(2)
        if len(encoded) > MAX_OUTPUT_BYTES:
            emit("failed", run_id=run_id, raw_status=status, error="Hermes output exceeds byte cap")
            raise SystemExit(2)
        emit("completed", run_id=run_id, raw_status=status, replayed=replayed, output=output,
             output_digest=hashlib.sha256(encoded).hexdigest(), usage=safe_usage(payload.get("usage")))
        return True
    if status in TERMINAL_STATUSES:
        emit("failed", run_id=run_id, raw_status=status,
             error=str(payload.get("error") or f"Hermes run {status}"))
        raise SystemExit(2)
    return False


def confirm_stop(args, run_id, replayed, previous):
    stop_run(args, run_id)
    deadline = time.monotonic() + min(5, max(0.1, args.poll_interval * 3))
    while time.monotonic() < deadline:
        try:
            response = request(
                "GET", f"{args.url}/v1/runs/{quote(run_id, safe='')}",
                args.api_key, timeout=min(10, args.poll_interval),
            )
            try:
                payload = read_json(response)
            finally:
                response.close()
            status = status_of(payload)
            if settle_terminal(run_id, status, payload, replayed):
                return
            previous = status
        except HTTPError as error:
            error.close()
        except (TimeoutError, URLError, OSError, ValueError, json.JSONDecodeError):
            pass
        time.sleep(args.poll_interval)
    emit("stop_unconfirmed", run_id=run_id, raw_status=previous or "unknown",
         error="Hermes stop outcome unconfirmed")
    raise SystemExit(4)


def poll(args, run_id, replayed):
    deadline = time.monotonic() + args.timeout
    previous = None
    while time.monotonic() < deadline and not STOP_REQUESTED:
        try:
            response = request(
                "GET", f"{args.url}/v1/runs/{quote(run_id, safe='')}",
                args.api_key, timeout=min(30, args.poll_interval),
            )
            try:
                payload = read_json(response)
            finally:
                response.close()
        except (ValueError, json.JSONDecodeError) as error:
            emit("reconcile", run_id=run_id, raw_status="invalid_poll_response", error=str(error))
            raise SystemExit(3)
        except HTTPError as error:
            code = error.code
            error.close()
            if code >= 500:
                time.sleep(args.poll_interval)
                continue
            if 300 <= code < 400 or code == 404:
                emit("reconcile", run_id=run_id, raw_status=f"http_{code}",
                     error=f"Hermes poll returned HTTP {code}")
                raise SystemExit(3)
            emit("failed", run_id=run_id, raw_status=f"http_{code}",
                 error=f"Hermes poll returned HTTP {code}")
            raise SystemExit(2)
        except (TimeoutError, URLError, OSError):
            time.sleep(args.poll_interval)
            continue
        try:
            status = status_of(payload)
        except ValueError as error:
            emit("reconcile", run_id=run_id, raw_status="invalid_status", error=str(error))
            raise SystemExit(3)
        if status != previous:
            print(f"hermes-run: {run_id} {status}", file=sys.stderr)
            previous = status
        if status == "waiting_for_approval":
            stop_run(args, run_id)
            emit("reconcile", run_id=run_id, raw_status=status, error="zero-tool run requested approval")
            raise SystemExit(3)
        if settle_terminal(run_id, status, payload, replayed):
            return
        time.sleep(args.poll_interval)
    confirm_stop(args, run_id, replayed, previous)


def parser():
    result = argparse.ArgumentParser(description="Submit or poll one bounded Hermes run")
    result.add_argument("--url", default=os.environ.get("HERMES_DOC_URL", ""))
    result.set_defaults(api_key=os.environ.get("HERMES_DOC_API_KEY", ""))
    result.add_argument("--request-file", required=True)
    result.add_argument("--idempotency-key", required=True)
    result.add_argument("--expected-digest", required=True)
    result.add_argument("--run-id")
    result.add_argument("--provider", default="openai-api")
    result.add_argument("--model", default="gpt-5.6-sol")
    result.add_argument("--timeout", type=float, default=1000)
    result.add_argument("--poll-interval", type=float, default=10)
    return result


def main():
    signal.signal(signal.SIGTERM, request_shutdown)
    signal.signal(signal.SIGINT, request_shutdown)
    args = parser().parse_args()
    try:
        validate(args)
        body = load_body(args)
    except (OSError, ValueError, json.JSONDecodeError) as error:
        emit("failed", raw_status="invalid_request", error=str(error))
        raise SystemExit(2)
    run_id, replayed = (args.run_id, False) if args.run_id else submit(args, body)
    poll(args, run_id, replayed)


if __name__ == "__main__":
    main()
