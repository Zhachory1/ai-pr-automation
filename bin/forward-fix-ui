#!/usr/bin/env python3
"""Forward-fix web UI for the agent fleet.

A single auto-refreshing page to submit a forward-fix task (handoff / GitHub issue / free-form
prompt) and watch its request row drain. Submitting only ENQUEUES a `forward-fix` request into the
request Postgres; the host-side `forward-fix-server` claims it and runs the harness (fresh clone,
swe-implementer, draft PR). This UI holds no GitHub/push creds and never runs the harness itself —
that separation is deliberate (creds live with the server, not the viewer).

Binds 127.0.0.1 in-code. No auth by design (localhost single-user); the one POST (enqueue) is
CSRF-guarded (Host + Origin allowlist + per-render token). Config from env:
REQUESTS_DB_HOST/PORT/USER/NAME + PGPASSWORD; HANDOFF_ROOT for the handoff picker.
"""
import html
import json
import os
import re
import secrets
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs

DB = {
    "host": os.environ.get("REQUESTS_DB_HOST", "localhost"),
    "port": os.environ.get("REQUESTS_DB_PORT", "5432"),
    "user": os.environ.get("REQUESTS_DB_USER", "fleet"),
    "name": os.environ.get("REQUESTS_DB_NAME", "fleet"),
}
PORT = int(os.environ.get("FORWARD_FIX_UI_PORT", "8090"))
REFRESH_SECONDS = int(os.environ.get("FORWARD_FIX_UI_REFRESH_SECONDS", "6"))
HANDOFF_ROOT = os.environ.get("HANDOFF_ROOT", "")
CSRF_TOKEN = secrets.token_urlsafe(32)
ALLOWED_HOSTS = {f"127.0.0.1:{PORT}", f"localhost:{PORT}"}
ALLOWED_ORIGINS = {f"http://127.0.0.1:{PORT}", f"http://localhost:{PORT}"}
REPO_RE = re.compile(r"^[^/\s]+/[^/\s]+$")
ISSUE_RE = re.compile(r"^[^/\s]+/[^#\s]+#[1-9][0-9]*$")


def _psql(sql: str) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["psql", "-h", DB["host"], "-p", DB["port"], "-U", DB["user"], "-d", DB["name"],
         "-v", "ON_ERROR_STOP=1", "-tAqc", sql],
        capture_output=True, text=True,
        env={**os.environ, "PGPASSWORD": os.environ.get("PGPASSWORD", "")})


def query(sql: str) -> list[list[str]]:
    p = _psql(sql)
    if p.returncode != 0:
        raise RuntimeError(p.stderr.strip() or "psql failed")
    return [line.split("|") for line in p.stdout.splitlines() if line]


def enqueue(payload: dict, dedupe_key: str) -> str:
    """Enqueue a forward-fix request via a parameterized psql call (payload as a bound literal —
    never f-string SQL). Returns a human result string."""
    payload_json = json.dumps(payload, separators=(",", ":"))
    # psql -v binding + quote_literal keeps attacker-influenced text out of SQL syntax.
    p = subprocess.run(
        ["psql", "-h", DB["host"], "-p", DB["port"], "-U", DB["user"], "-d", DB["name"],
         "-v", "ON_ERROR_STOP=1", "-tAq",
         "-v", f"payload={payload_json}", "-v", f"dk={dedupe_key}",
         "-c",
         "INSERT INTO requests(kind, payload, dedupe_key) "
         "SELECT 'forward-fix', :'payload'::jsonb, :'dk' "
         "WHERE NOT EXISTS (SELECT 1 FROM requests WHERE kind='forward-fix' "
         "AND dedupe_key=:'dk' AND status IN ('queued','running')) "
         "ON CONFLICT DO NOTHING RETURNING 1;"],
        capture_output=True, text=True,
        env={**os.environ, "PGPASSWORD": os.environ.get("PGPASSWORD", "")})
    if p.returncode != 0:
        return f"rejected: {p.stderr.strip() or 'db error'}"
    return "enqueued" if p.stdout.strip() == "1" else "already queued/running (deduped)"


def list_handoffs() -> list[str]:
    if not HANDOFF_ROOT or not os.path.isdir(HANDOFF_ROOT):
        return []
    out = []
    for name in sorted(os.listdir(HANDOFF_ROOT), reverse=True):
        if not name.endswith(".md"):
            continue
        path = os.path.join(HANDOFF_ROOT, name)
        try:
            with open(path, encoding="utf-8", errors="replace") as fh:
                text = fh.read()
        except OSError:
            continue
        # only offer handoffs that have actionable concrete breakage
        m = re.search(r"^## Concrete breakage\s*(.*?)(?=^## |\Z)", text, re.M | re.S)
        body = (m.group(1) if m else "").strip()
        meaningful = [ln for ln in body.splitlines()
                      if ln.strip() and not re.fullmatch(r"\s*[Nn]one\.?\s*", ln)]
        if meaningful:
            out.append(path)
    return out[:100]


def e(v) -> str:
    return html.escape("" if v is None else str(v))


def chip(status: str) -> str:
    s = status if status in ("queued", "running", "done", "failed", "superseded") else "queued"
    return f'<span class="chip s-{s}">{e(status)}</span>'


def pr_link(ref: str) -> str:
    ref = (ref or "").strip()
    if ref.startswith("http"):
        return f'<a href="{e(ref)}" target="_blank" rel="noopener">draft PR</a>'
    return e(ref)


def requests_table(rows: list[list[str]]) -> str:
    if not rows:
        return "<p class=empty>no forward-fix requests yet</p>"
    body = "".join(
        "<tr>"
        f"<td>{e(r[0])}</td><td>{chip(r[1])}</td><td>{e(r[2])}</td>"
        f"<td>{pr_link(r[3])}</td><td>{e(r[4])}</td><td>{e(r[5])}</td></tr>"
        for r in rows)
    return ("<table><thead><tr><th>id</th><th>status</th><th>task</th><th>result</th>"
            "<th>detail</th><th>updated</th></tr></thead>"
            f"<tbody>{body}</tbody></table>")


def render(flash: str = "") -> str:
    try:
        rows = query(
            "SELECT id, status, dedupe_key, coalesce(posted_ref,''), coalesce(fail_response,''), "
            "to_char(coalesce(finished_at, started_at, created_at),'MM-DD HH24:MI') "
            "FROM requests WHERE kind='forward-fix' ORDER BY id DESC LIMIT 40")
        db_err = None
    except Exception as ex:
        rows, db_err = [], str(ex)
    handoffs = list_handoffs()
    opts = "".join(f'<option value="{e(p)}">{e(os.path.basename(p))}</option>' for p in handoffs)
    banner = f"<p class=err>DB unreachable: {e(db_err)}</p>" if db_err else ""
    flash_html = f"<p class=flash>{e(flash)}</p>" if flash else ""
    handoff_form = (
        f'<option value="">— pick a handoff ({len(handoffs)} with concrete breakage) —</option>{opts}'
        if handoffs else '<option value="">(no handoffs with concrete breakage found)</option>')
    return f"""<!doctype html><html><head><meta charset=utf-8>
<meta http-equiv=refresh content="{REFRESH_SECONDS};url=/">
<title>forward-fix</title>
<style>
 :root{{--bg:#0f1117;--card:#181b24;--fg:#e6e8ee;--mut:#8b90a0;--line:#262a36;--acc:#e6197f}}
 *{{box-sizing:border-box}}
 body{{font:14px/1.55 -apple-system,system-ui,sans-serif;margin:0;padding:2rem;color:var(--fg);background:var(--bg)}}
 h1{{font-size:1.25rem;margin:0 0 1rem;display:flex;align-items:center;gap:.5rem}}
 h2{{font-size:.95rem;margin:0 0 .6rem}}
 .sub{{color:var(--mut);font-size:.8rem;font-weight:400}}
 section{{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:1rem 1.1rem;margin:1rem 0}}
 label{{display:block;color:var(--mut);font-size:.8rem;margin:.6rem 0 .2rem}}
 input,select,textarea{{font:inherit;width:100%;background:var(--bg);color:var(--fg);border:1px solid var(--line);border-radius:6px;padding:.4rem .5rem}}
 textarea{{min-height:5rem;resize:vertical}}
 .row{{display:flex;gap:1rem;flex-wrap:wrap}} .row>div{{flex:1;min-width:16rem}}
 fieldset{{border:1px solid var(--line);border-radius:8px;margin:.5rem 0;padding:.5rem .8rem}}
 legend{{color:var(--acc);font-size:.8rem;padding:0 .4rem}}
 button{{font:inherit;font-weight:600;background:#12324f;color:#5ab0ff;border:1px solid #1d4a72;border-radius:6px;padding:.45rem 1rem;cursor:pointer;margin-top:.8rem}}
 button:hover{{background:#1d4a72}}
 table{{border-collapse:collapse;width:100%}}
 th,td{{text-align:left;padding:.35rem .6rem;border-bottom:1px solid var(--line);vertical-align:top;font-size:.85rem}}
 th{{color:var(--mut);font-weight:600;font-size:.75rem;text-transform:uppercase}}
 td{{font-family:ui-monospace,Menlo,monospace;max-width:52ch;overflow-wrap:anywhere}}
 .empty,.hint{{color:var(--mut)}} .err{{color:#ff6b6b;font-weight:600}}
 .flash{{color:#111;background:#7ee787;border-radius:6px;padding:.4rem .7rem;font-weight:600}}
 .chip{{display:inline-block;padding:.05rem .5rem;border-radius:999px;font-size:.75rem;font-weight:600;font-family:system-ui}}
 .s-queued{{background:#2b2f3a;color:#c8ccd8}} .s-running{{background:#12324f;color:#5ab0ff}}
 .s-done{{background:#123a22;color:#7ee787}} .s-failed{{background:#3a1620;color:#ff8095}} .s-superseded{{background:#2b2f3a;color:#8b90a0}}
</style></head><body>
<h1><span style="color:var(--acc)">◉</span> forward-fix <span class=sub>submit a task → draft PR · refreshes {REFRESH_SECONDS}s</span></h1>
{banner}{flash_html}
<section>
<h2>Submit a task <span class=sub>enqueues a forward-fix request; the server opens a draft PR</span></h2>
<form method=post action=/submit onsubmit="return confirm('Enqueue this forward-fix task?')">
<input type=hidden name=token value="{e(CSRF_TOKEN)}">
<label>Source</label>
<select name=source onchange="for(const f of ['h','i','p'])document.getElementById(f).style.display=this.value==={{handoff:'h',issue:'i',prompt:'p'}}[this.value]?'':'none';document.getElementById({{handoff:'h',issue:'i',prompt:'p'}}[this.value]).style.display=''">
<option value=handoff>handoff</option><option value=issue>GitHub issue</option><option value=prompt>prompt</option>
</select>
<fieldset id=h><legend>handoff</legend>
<label>handoff document</label><select name=handoff_path>{handoff_form}</select></fieldset>
<fieldset id=i style=display:none><legend>GitHub issue</legend>
<label>issue (owner/repo#N)</label><input name=issue placeholder="ROKT/cpi#123"></fieldset>
<fieldset id=p style=display:none><legend>prompt</legend>
<label>repo (owner/repo)</label><input name=prompt_repo placeholder="ROKT/cpi">
<label>task prompt</label><textarea name=prompt placeholder="Describe the fix..."></textarea></fieldset>
<label><input type=checkbox name=no_pr value=1 style=width:auto> commit only, do not open a PR (--no-pr)</label>
<button type=submit>enqueue forward-fix</button>
</form>
<p class=hint>Only handoffs with a non-empty <code>## Concrete breakage</code> section are offered. Human-decision findings are not auto-fixed.</p>
</section>
<section><h2>Forward-fix requests</h2>{requests_table(rows)}</section>
</body></html>"""


class Handler(BaseHTTPRequestHandler):
    _lock = threading.Lock(); _cache = None; _cache_ts = 0.0

    @classmethod
    def cached_page(cls) -> bytes:
        now = time.monotonic()
        with cls._lock:
            if cls._cache is None or (now - cls._cache_ts) >= REFRESH_SECONDS:
                cls._cache = render().encode(); cls._cache_ts = now
            return cls._cache

    def do_GET(self):
        if self.path not in ("/", "/index.html"):
            self.send_response(404); self.end_headers(); return
        try:
            page = self.cached_page()
        except Exception as ex:
            self.send_response(500); self.end_headers(); self.wfile.write(f"error: {ex}".encode()); return
        self.send_response(200)
        self.send_header("content-type", "text/html; charset=utf-8")
        self.send_header("content-length", str(len(page)))
        self.end_headers(); self.wfile.write(page)

    def _csrf_ok(self, params) -> bool:
        if self.headers.get("Host", "") not in ALLOWED_HOSTS:
            return False
        origin = self.headers.get("Origin")
        if origin is not None and origin not in ALLOWED_ORIGINS:
            return False
        return secrets.compare_digest(params.get("token", [""])[0], CSRF_TOKEN)

    def _redirect(self, flash: str):
        with Handler._lock:
            Handler._cache = None
        page = render(flash=flash).encode()
        self.send_response(200)
        self.send_header("content-type", "text/html; charset=utf-8")
        self.send_header("content-length", str(len(page)))
        self.end_headers(); self.wfile.write(page)

    def do_POST(self):
        length = int(self.headers.get("Content-Length", "0") or "0")
        body = self.rfile.read(length).decode("utf-8", "replace") if length else ""
        params = parse_qs(body)
        if not self._csrf_ok(params):
            self.send_response(403); self.end_headers(); self.wfile.write(b"forbidden (csrf)"); return
        if self.path != "/submit":
            self.send_response(404); self.end_headers(); return
        result = self._submit(params)
        print(f"WRITE /submit {result}", flush=True)
        self._redirect(result)

    def _submit(self, params) -> str:
        source = params.get("source", [""])[0]
        no_pr = params.get("no_pr", [""])[0] == "1"
        if source == "handoff":
            path = params.get("handoff_path", [""])[0].strip()
            if not path or not HANDOFF_ROOT:
                return "rejected: no handoff selected"
            # confine to HANDOFF_ROOT (no traversal), must be an existing regular .md file
            rp = os.path.realpath(path)
            if not (rp.startswith(os.path.realpath(HANDOFF_ROOT) + os.sep)
                    and os.path.isfile(rp) and rp.endswith(".md")):
                return "rejected: handoff path not under HANDOFF_ROOT"
            payload = {"source": "handoff", "handoff_path": rp, "no_pr": no_pr}
            dk = f"handoff:{os.path.basename(rp)}"
        elif source == "issue":
            iss = params.get("issue", [""])[0].strip()
            if not ISSUE_RE.match(iss):
                return "rejected: issue must be owner/repo#N"
            payload = {"source": "issue", "issue": iss, "no_pr": no_pr}
            dk = f"issue:{iss}"
        elif source == "prompt":
            repo = params.get("prompt_repo", [""])[0].strip()
            prompt = params.get("prompt", [""])[0].strip()
            if not REPO_RE.match(repo):
                return "rejected: prompt needs a valid repo (owner/repo)"
            if not prompt:
                return "rejected: prompt is empty"
            payload = {"source": "prompt", "repo": repo, "prompt": prompt, "no_pr": no_pr}
            dk = f"prompt:{repo}:{abs(hash(prompt)) & 0xffffffff:08x}"
        else:
            return "rejected: unknown source"
        try:
            return enqueue(payload, dk)
        except Exception as ex:
            return f"rejected: {ex}"

    def log_message(self, *a):
        pass


if __name__ == "__main__":
    ThreadingHTTPServer((os.environ.get("FORWARD_FIX_UI_BIND", "127.0.0.1"), PORT), Handler).serve_forever()
