#!/usr/bin/env bash
# Runs analyst with only its existing model-provider credential and fixed mounts.
set -euo pipefail

prompt="${1:?prompt file}"
: "${OPENAI_API_KEY:?set OPENAI_API_KEY}"
: "${PR_SAFETY_SNAPSHOT_PATH:?}"
: "${PR_SAFETY_POLICY_PATH:?}"
: "${PR_SAFETY_HANDOFF_DRAFT:?}"
: "${PR_SAFETY_RESULT_FILE:?}"

image="${PR_SAFETY_ANALYST_IMAGE:-agent-fleet/pr-safety-analyst:latest}"
# Pin the model so it cannot drift to the provider default. Approved provider is OpenAI only
# (matches the egress allowlist and policy); a non-openai pattern would be blocked by the proxy.
model="${PR_SAFETY_ANALYST_MODEL:-openai/gpt-5.6-luna}"
network="${PR_SAFETY_ANALYST_NETWORK:?set PR_SAFETY_ANALYST_NETWORK}"
proxy="${PR_SAFETY_ANALYST_PROXY:?set PR_SAFETY_ANALYST_PROXY}"
[[ "$network" == agent-fleet-pr-safety-analyst && "$proxy" == http://pr-safety-egress:3128 ]] || { echo "invalid PR safety egress configuration" >&2; exit 2; }
docker run --rm --stop-timeout 10 --network "$network" --read-only --user 65532:65532 --cap-drop ALL --security-opt no-new-privileges \
  --pids-limit 256 --memory 2g --cpus 2 --tmpfs /tmp:rw,noexec,nosuid,nodev,mode=1777 \
  --tmpfs /app/agent-config/sessions:rw,nosuid,nodev,mode=1777 -e HOME=/tmp \
  --mount "type=bind,src=$PR_SAFETY_SNAPSHOT_PATH,dst=/snapshot,readonly" \
  --mount "type=bind,src=$PR_SAFETY_POLICY_PATH,dst=/policy,readonly" \
  --mount "type=bind,src=$PR_SAFETY_HANDOFF_DRAFT,dst=/output/handoff.md" \
  --mount "type=bind,src=$prompt,dst=/input/prompt.md,readonly" \
  --workdir /snapshot -e OPENAI_API_KEY -e PR_SAFETY_HANDOFF_DRAFT=/output/handoff.md \
  -e GH_TOKEN -e BUILDKITE_API_TOKEN -e DD_PAT \
  -e HTTPS_PROXY="$proxy" -e HTTP_PROXY="$proxy" -e NODE_USE_ENV_PROXY=1 \
  -e NO_PROXY=coderag,swarmvault-mcp,hindsight -e no_proxy=coderag,swarmvault-mcp,hindsight \
  "$image" --model "$model" "$(<"$prompt")" > "$PR_SAFETY_RESULT_FILE"
