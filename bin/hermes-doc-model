#!/usr/bin/env bash
set -euo pipefail
umask 077

HERE="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/queue.sh
. "$HERE/lib/queue.sh"

RENDERER="${HERMES_DOC_REQUEST_BIN:-$HERE/bin/hermes-doc-request}"
ADAPTER="${HERMES_RUN_BIN:-$HERE/bin/hermes-run}"
REPLAY_SECONDS="${HERMES_DOC_REPLAY_SECONDS:-82800}"
RUN_TIMEOUT="${HERMES_DOC_RUN_TIMEOUT:-1000}"
POLL_INTERVAL="${HERMES_DOC_POLL_INTERVAL:-10}"

emit() { jq -cn "$@"; }
fail() { emit --arg status "$1" --arg reason "$2" '{status:$status,reason:$reason}'; exit "$3"; }
need() { command -v "$1" >/dev/null 2>&1 || { echo "hermes-doc-model: missing dependency: $1" >&2; exit 2; }; }
need jq; need python3
[[ -x "$RENDERER" && -x "$ADAPTER" ]] || fail failed "missing Hermes renderer or adapter" 2

phase="${1:-}"; shift || true
request_id=""; nonce=""; generation=""; stage_root=""; payload=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --request-id) request_id="${2:?}"; shift 2 ;;
    --queue-nonce) nonce="${2:?}"; shift 2 ;;
    --runtime-generation) generation="${2:?}"; shift 2 ;;
    --stage-root) stage_root="${2:?}"; shift 2 ;;
    --payload) payload="${2:?}"; shift 2 ;;
    *) fail failed "unknown argument: $1" 2 ;;
  esac
done
[[ "$phase" == draft || "$phase" == council ]] || fail failed "phase must be draft or council" 2
[[ "$request_id" =~ ^[1-9][0-9]*$ ]] || fail failed "request ID must be positive" 2
[[ -n "$nonce" ]] || fail failed "queue nonce is required" 2
[[ "$generation" =~ ^[0-9a-f]{64}$ ]] || fail failed "runtime generation must be SHA-256" 2
[[ -d "$stage_root" ]] || fail failed "stage root does not exist" 2
api_key="${HERMES_DOC_API_KEY:-}"
[[ -n "${HERMES_DOC_URL:-}" && ${#api_key} -ge 16 ]] || fail failed "Hermes URL and API key are required" 2
[[ "$REPLAY_SECONDS" =~ ^[1-9][0-9]*$ ]] || fail failed "replay seconds must be positive" 2
if [[ "$phase" == draft ]]; then
  [[ -n "$payload" ]] || fail failed "draft payload is required" 2
else
  [[ -z "$payload" ]] || fail failed "council does not accept payload" 2
fi

render_file="$(mktemp)"; adapter_file="$(mktemp)"; trap 'rm -f "$render_file" "$adapter_file"' EXIT
render_args=("$phase" --stage-root "$stage_root" --request-id "$request_id")
[[ "$phase" == draft ]] && render_args+=(--payload "$payload")
rc=0; "$RENDERER" "${render_args[@]}" >"$render_file" || rc=$?
if (( rc != 0 )); then
  reason="$(jq -r '.error // "request rendering failed"' "$render_file" 2>/dev/null || echo 'request rendering failed')"
  [[ "$reason" == *"already exists with different bytes"* ]] && fail reconcile "$reason" 3
  fail failed "$reason" 2
fi
jq -e 'type == "object" and .status == "rendered"' "$render_file" >/dev/null 2>&1 \
  || fail failed "renderer returned invalid metadata" 2
request_digest="$(jq -r .request_digest "$render_file")"
renderer_generation="$(jq -r .renderer_generation "$render_file")"
request_file="$stage_root/$(jq -r .request_file "$render_file")"
verify_request() {
  python3 - "$request_file" "$request_digest" <<'PY'
import hashlib, os, stat, sys
path, expected = sys.argv[1:]
fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
with os.fdopen(fd, "rb") as source:
    if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
        raise ValueError("request is not a regular file")
    if hashlib.sha256(source.read()).hexdigest() != expected:
        raise ValueError("request digest mismatch")
PY
}

row="$(hermes_doc_run_begin "$request_id" "$phase" "$request_digest" "$generation" "$REPLAY_SECONDS" "$nonce")"
[[ -n "$row" ]] || fail reconcile "queue lease lost before Hermes phase binding" 3
if [[ "$(jq -r .request_digest <<<"$row")" != "$request_digest" || \
      "$(jq -r .runtime_generation <<<"$row")" != "$generation" ]]; then
  fail reconcile "Hermes phase body or runtime generation mismatch" 3
fi

response_rel="requests/$request_id/$phase-response.json"
response_file="$stage_root/$response_rel"
run_id_file="$stage_root/requests/$request_id/$phase-run-id"
run_id_ack_file="$stage_root/requests/$request_id/$phase-run-id-ack"
ack_run_id() {
  python3 - "$run_id_ack_file" "$1" <<'PY'
import os, sys
path, run_id = sys.argv[1:]
data = (run_id + "\n").encode()
try:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
except FileExistsError:
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb") as source:
        if source.read() != data:
            raise ValueError("run ID acknowledgement mismatch")
else:
    with os.fdopen(fd, "wb") as output:
        output.write(data); output.flush(); os.fsync(output.fileno())
PY
}
read_run_id_file() {
  python3 - "$run_id_file" <<'PY'
import os, stat, sys
fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOFOLLOW)
with os.fdopen(fd, "rb") as source:
    if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
        raise ValueError("run ID evidence is not regular")
    data = source.read(1025)
if not data.endswith(b"\n") or len(data) > 1024 or b"\n" in data[:-1]:
    raise ValueError("run ID evidence is invalid")
value = data[:-1].decode("ascii")
if not value:
    raise ValueError("run ID evidence is empty")
print(value)
PY
}
verify_response() {
  python3 - "$response_file" "$1" <<'PY'
import hashlib, json, os, stat, sys
path, expected = sys.argv[1:]
fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
try:
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        raise ValueError("response is not a regular file")
    with os.fdopen(fd, "rb") as source:
        envelope = json.load(source)
finally:
    try: os.close(fd)
    except OSError: pass
output = envelope.get("output") if isinstance(envelope, dict) else None
if not isinstance(output, str) or hashlib.sha256(output.encode()).hexdigest() != expected:
    raise ValueError("completed output digest mismatch")
PY
}
stage_response() {
  python3 - "$adapter_file" "$response_file" "$1" <<'PY'
import hashlib, json, os, stat, sys
source, target, expected = sys.argv[1:]
raw = open(source, "rb").read()
envelope = json.loads(raw)
output = envelope.get("output") if isinstance(envelope, dict) else None
if not isinstance(output, str) or hashlib.sha256(output.encode()).hexdigest() != expected:
    raise ValueError("adapter output digest mismatch")
try:
    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
except FileExistsError:
    fd = os.open(target, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise ValueError("existing response is not a regular file")
        with os.fdopen(fd, "rb") as existing:
            saved = json.load(existing)
    finally:
        try: os.close(fd)
        except OSError: pass
    saved_output = saved.get("output") if isinstance(saved, dict) else None
    if not isinstance(saved_output, str) or hashlib.sha256(saved_output.encode()).hexdigest() != expected:
        raise ValueError("existing response digest mismatch")
else:
    with os.fdopen(fd, "wb") as output_file:
        output_file.write(raw)
        output_file.flush()
        os.fsync(output_file.fileno())
    directory = os.open(os.path.dirname(target), os.O_RDONLY | os.O_DIRECTORY)
    try: os.fsync(directory)
    finally: os.close(directory)
PY
}
settle() {
  local state="$1" run_id="$2" raw_status="$3" output_digest="$4" usage="$5" reason="$6" result
  if ! result="$(hermes_doc_run_finish "$request_id" "$phase" "$state" "$run_id" "$raw_status" \
    "$output_digest" "$usage" "$reason" "$nonce")"; then
    fail reconcile "Hermes phase settlement could not be confirmed" 3
  fi
  [[ -n "$result" ]] || fail reconcile "queue lease lost before Hermes phase settlement" 3
  if [[ "$state" == completed ]]; then
    emit --arg status completed --arg phase "$phase" --arg response_file "$response_rel" \
      --arg output_digest "$output_digest" --arg runtime_generation "$generation" \
      --arg renderer_generation "$renderer_generation" \
      '{status:$status,phase:$phase,response_file:$response_file,output_digest:$output_digest,
        runtime_generation:$runtime_generation,renderer_generation:$renderer_generation}'
    exit 0
  fi
  fail "$state" "$reason" "$([[ "$state" == reconcile ]] && echo 3 || echo 2)"
}

state="$(jq -r .state <<<"$row")"
case "$state" in
  completed)
    output_digest="$(jq -r '.output_digest // empty' <<<"$row")"
    verify_response "$output_digest" 2>/dev/null || fail reconcile "completed Hermes output is missing or invalid" 3
    emit --arg status completed --arg phase "$phase" --arg response_file "$response_rel" \
      --arg output_digest "$output_digest" --arg runtime_generation "$generation" \
      --arg renderer_generation "$renderer_generation" \
      '{status:$status,phase:$phase,response_file:$response_file,output_digest:$output_digest,
        runtime_generation:$runtime_generation,renderer_generation:$renderer_generation}'
    exit 0 ;;
  failed) fail failed "$(jq -r '.error // "Hermes phase failed"' <<<"$row")" 2 ;;
  reconcile) fail reconcile "$(jq -r '.error // "Hermes phase requires reconciliation"' <<<"$row")" 3 ;;
  submitting)
    durable_run_id="$(jq -r '.hermes_run_id // empty' <<<"$row")"
    if [[ -e "$run_id_file" ]]; then
      file_run_id="$(read_run_id_file 2>/dev/null)" || fail reconcile "Hermes run ID evidence is invalid" 3
      if [[ -n "$durable_run_id" && "$durable_run_id" != "$file_run_id" ]]; then
        fail reconcile "Hermes run ID evidence mismatch" 3
      fi
      if [[ -z "$durable_run_id" ]]; then
        recorded="$(hermes_doc_run_record_id "$request_id" "$phase" "$file_run_id" "$nonce")" \
          || fail reconcile "Hermes run ID recovery could not be persisted" 3
        [[ "$recorded" == "$file_run_id" ]] || fail reconcile "queue lease lost during Hermes run ID recovery" 3
        row="$(jq -c --arg id "$file_run_id" '.hermes_run_id=$id' <<<"$row")"
      fi
      ack_run_id "$file_run_id" 2>/dev/null || fail reconcile "Hermes run ID acknowledgement failed" 3
    fi ;;
  *) fail reconcile "unknown durable Hermes phase state" 3 ;;
esac

while true; do
  run_id="$(jq -r '.hermes_run_id // empty' <<<"$row")"
  submit_count="$(jq -r .submit_count <<<"$row")"
  adapter_args=(--url "$HERMES_DOC_URL" --request-file "$request_file" \
    --expected-digest "$request_digest" --idempotency-key "doc:$request_id:$phase" \
    --run-id-file "$run_id_file" --run-id-ack-file "$run_id_ack_file" \
    --timeout "$RUN_TIMEOUT" --poll-interval "$POLL_INTERVAL")
  if [[ -n "$run_id" ]]; then
    adapter_args+=(--run-id "$run_id")
  else
    if (( submit_count >= 2 )) || ! python3 - "$(jq -r .replay_until <<<"$row")" <<'PY'
import datetime, sys
value = sys.argv[1].replace("Z", "+00:00")
raise SystemExit(0 if datetime.datetime.fromisoformat(value) > datetime.datetime.now(datetime.timezone.utc) else 1)
PY
    then
      settle reconcile "" replay_exhausted "" '{}' "Hermes submit replay exhausted"
    fi
    verify_request 2>/dev/null || settle reconcile "" request_evidence_lost "" '{}' "Hermes request evidence lost before submit"
    reserved="$(hermes_doc_run_reserve_submit "$request_id" "$phase" "$nonce")"
    [[ -n "$reserved" ]] || settle reconcile "" replay_unavailable "" '{}' "Hermes submit reservation unavailable"
    submit_count="$reserved"
  fi

  rc=0
  "$ADAPTER" "${adapter_args[@]}" >"$adapter_file" &
  adapter_pid="$!"
  while kill -0 "$adapter_pid" 2>/dev/null && [[ ! -e "$run_id_file" ]]; do sleep 0.05; done
  if [[ -e "$run_id_file" ]]; then
    file_run_id="$(read_run_id_file 2>/dev/null)" || {
      kill -TERM "$adapter_pid" 2>/dev/null || true; wait "$adapter_pid" 2>/dev/null || true
      settle reconcile "$run_id" invalid_run_id_evidence "" '{}' "Hermes run ID evidence is invalid"
    }
    if [[ -n "$run_id" && "$run_id" != "$file_run_id" ]]; then
      kill -TERM "$adapter_pid" 2>/dev/null || true; wait "$adapter_pid" 2>/dev/null || true
      settle reconcile "$run_id" run_id_mismatch "" '{}' "Hermes run ID evidence mismatch"
    fi
    if [[ -z "$run_id" ]]; then
      if ! recorded="$(hermes_doc_run_record_id "$request_id" "$phase" "$file_run_id" "$nonce")" \
          || [[ "$recorded" != "$file_run_id" ]]; then
        kill -TERM "$adapter_pid" 2>/dev/null || true; wait "$adapter_pid" 2>/dev/null || true
        fail reconcile "Hermes run ID could not be persisted before polling" 3
      fi
      run_id="$file_run_id"
      row="$(jq -c --arg id "$file_run_id" '.hermes_run_id=$id' <<<"$row")"
    fi
    if ! ack_run_id "$file_run_id" 2>/dev/null; then
      kill -TERM "$adapter_pid" 2>/dev/null || true; wait "$adapter_pid" 2>/dev/null || true
      fail reconcile "Hermes run ID acknowledgement failed" 3
    fi
  fi
  wait "$adapter_pid" || rc=$?
  if ! jq -e 'type == "object" and (.status | type == "string")' "$adapter_file" >/dev/null 2>&1; then
    settle reconcile "$run_id" invalid_adapter_response "" '{}' "Hermes adapter returned invalid metadata"
  fi
  adapter_status="$(jq -r .status "$adapter_file")"
  result_run_id="$(jq -r '.run_id // empty' "$adapter_file")"
  raw_status="$(jq -r '.raw_status // .status // "unknown"' "$adapter_file")"
  reason="$(jq -r '.error // "Hermes adapter failed"' "$adapter_file")"
  usage="$(jq -c '.usage // {}' "$adapter_file")"

  if (( rc == 0 )) && [[ "$adapter_status" == completed ]]; then
    output_digest="$(jq -r '.output_digest // empty' "$adapter_file")"
    if [[ -z "$result_run_id" ]] || ! [[ "$output_digest" =~ ^[0-9a-f]{64}$ ]] || \
       ! stage_response "$output_digest" 2>/dev/null; then
      settle reconcile "$result_run_id" invalid_output "" "$usage" "Hermes completed output is invalid"
    fi
    settle completed "$result_run_id" "$raw_status" "$output_digest" "$usage" ""
  fi
  if [[ "$adapter_status" == submit_unknown && -z "$result_run_id" && "$submit_count" -lt 2 ]]; then
    if ! row="$(hermes_doc_run_begin "$request_id" "$phase" "$request_digest" "$generation" "$REPLAY_SECONDS" "$nonce")"; then
      fail reconcile "Hermes submit recovery state unavailable" 3
    fi
    [[ -n "$row" ]] || fail reconcile "queue lease lost after unknown Hermes submit" 3
    continue
  fi
  if [[ "$adapter_status" == reconcile || "$adapter_status" == submit_unknown || "$adapter_status" == stop_unconfirmed || \
        "$raw_status" == completed ]]; then
    settle reconcile "$result_run_id" "$raw_status" "" "$usage" "$reason"
  fi
  settle failed "$result_run_id" "$raw_status" "" "$usage" "$reason"
done
