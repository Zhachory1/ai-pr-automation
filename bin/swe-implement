#!/usr/bin/env bash
# Standalone SWE-implement harness.
#
# Takes a task from one of three sources, normalizes it to a common brief, runs the swe-implementer
# persona (via mewritecode exec) against a DISPOSABLE fresh clone of the target repo at its default
# branch, and — only if a commit was produced — creates the commit on a remote branch via the
# GitHub API (signed/"Verified" by GitHub) and opens a DRAFT PR.
#
#   swe-implement --handoff <file>                 repo/base come from the handoff identity
#   swe-implement --issue  <owner/repo#N>          task = the GitHub issue title+body
#   swe-implement --prompt "<text>" --repo <owner/repo>
#
# It never touches the author's PR branch or any existing working checkout; it clones fresh into a
# temp dir. It authors as the push-capable token identity. --no-pr stops at a committed local branch.
set -euo pipefail

AGENT_DEF="${SWE_IMPLEMENTER_AGENT:-$HOME/.mewrite/agents/swe-implementer.md}"
MODEL="${SWE_IMPLEMENT_MODEL:-openai/gpt-5.6-terra}"
MEWRITE="${MEWRITECODE_BIN:-mewritecode}"
GH_HOST=github.com
open_pr=1
mode="" src="" repo="" prompt_text=""

die() { echo "swe-implement: $*" >&2; exit 2; }
log() { printf '%s swe-implement %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*"; }

while (($#)); do
  case "$1" in
    --handoff) mode=handoff; src="${2:?}"; shift 2 ;;
    --issue)   mode=issue;   src="${2:?}"; shift 2 ;;
    --prompt)  mode=prompt;  prompt_text="${2:?}"; shift 2 ;;
    --repo)    repo="${2:?}"; shift 2 ;;
    --no-pr)   open_pr=0; shift ;;
    --model)   MODEL="${2:?}"; shift 2 ;;
    *) die "unknown arg: $1" ;;
  esac
done

command -v "$MEWRITE" >/dev/null || die "missing mewritecode"
command -v gh  >/dev/null || die "missing gh"
command -v git >/dev/null || die "missing git"
: "${GH_TOKEN:?set GH_TOKEN (push + SAML authorized for the target org)}"
[[ -f "$AGENT_DEF" ]] || die "missing agent definition: $AGENT_DEF"
[[ "$mode" ]] || die "one of --handoff / --issue / --prompt is required"

# --- normalize input to: repo, base_ref (optional), task_text -------------------------------------
# source_ref is provenance for the PR body. The agent's commit subject/body become PR metadata.
base_ref="" task_text="" source_ref="" fallback_title=""
case "$mode" in
  handoff)
    [[ -f "$src" && ! -L "$src" ]] || die "handoff not a regular file: $src"
    # identity block: <!-- pr-safety identity ... repo: X ... base_sha: Y ... -->
    repo="$(sed -n 's/^repo:[[:space:]]*//p' "$src" | head -1)"
    base_ref="$(sed -n 's/^base_sha:[[:space:]]*//p' "$src" | head -1)"
    local_pr="$(sed -n 's/^pr:[[:space:]]*//p' "$src" | head -1)"
    [[ "$repo" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]] || die "handoff has no valid repo identity"
    source_ref="handoff $(basename "$src") ($repo#${local_pr:-?})"
    fallback_title="Fix PR-safety breakage from ${repo##*/}#${local_pr:-?}"
    # only the concrete-breakage section is implementable; a section that is blank or just "None."
    # (the analyst's empty-section marker) is nothing to fix.
    task_text="$(awk '/^## Concrete breakage/{f=1;next} /^## /{f=0} f' "$src")"
    meaningful="$(printf '%s' "$task_text" | grep -v '^[[:space:]]*$' | grep -viE '^[[:space:]]*none\.?[[:space:]]*$' || true)"
    [[ -n "$meaningful" ]] || die "handoff has no actionable '## Concrete breakage' content to fix"
    ;;
  issue)
    [[ "$src" =~ ^([^/]+/[^#]+)#([1-9][0-9]*)$ ]] || die "issue must be owner/repo#N"
    repo="${BASH_REMATCH[1]}"; num="${BASH_REMATCH[2]}"
    view="$(gh issue view "$num" --repo "$repo" --json title,body,url 2>&1)" || die "gh issue view failed: $view"
    source_ref="$(jq -r '.url' <<<"$view")"
    task_text="$(jq -r '"Title: "+.title+"\n\n"+(.body // "")' <<<"$view")"
    fallback_title="$(jq -r '.title' <<<"$view" | cut -c1-72)"
    ;;
  prompt)
    [[ "$repo" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]] || die "--prompt requires --repo owner/repo"
    source_ref="prompt"
    task_text="$prompt_text"
    fallback_title="$(printf '%s' "$prompt_text" | tr '\n' ' ' | cut -c1-72)"
    ;;
esac

# --- disposable fresh clone at the repo default branch (never an existing checkout) ---------------
work="$(mktemp -d "${TMPDIR:-/tmp}/swe-implement.XXXXXX")"
cleanup() { rm -rf "$work"; }
trap cleanup EXIT
log "cloning $repo (fresh, default branch) into $work"
gh repo clone "$repo" "$work/repo" -- --depth=50 >/dev/null 2>&1 || die "clone failed for $repo"
cd "$work/repo"
default_branch="$(git symbolic-ref --short HEAD)"
base_sha="$(git rev-parse HEAD)"
slug="$(printf '%s' "$source_ref" | tr -c 'A-Za-z0-9' '-' | sed 's/-\{2,\}/-/g;s/^-//;s/-$//' | cut -c1-40)"
branch="swe-implement/${slug:-task}-$(date +%s)"
git switch -c "$branch" >/dev/null 2>&1 || die "could not create branch"
log "branch $branch off $default_branch@${base_sha:0:10}"

# Configure a commit identity on THIS clone (not global): the swe-implementer runs `git commit`,
# and a fresh container clone has no user.name/user.email, so git refuses and the agent (correctly)
# will not fabricate an author. Use the push token's own GitHub login, same as agent-server maintain.
git_login="$(GH_TOKEN="$GH_TOKEN" gh api user --jq .login 2>/dev/null || true)"
git_login="${git_login:-swe-implement-bot}"
git config user.name "$git_login"
git config user.email "${git_login}@users.noreply.github.com"

# Let the agent's validation build private modules. Go's `go mod download` shells out to git over
# https, which has no credentials in the container. Inject a token rewrite via GIT_CONFIG_* env (NOT
# on-disk config, so the token isn't persisted) and mark the target org private so Go skips the
# public checksum DB. Only affects git subprocesses reaching github.com (module fetch); the agent's
# in-clone git ops are offline and the API commit path uses gh, not git.
owner="${repo%%/*}"
export GOPRIVATE="github.com/${owner}" GOFLAGS="${GOFLAGS:-}"
export GIT_CONFIG_COUNT=1
export GIT_CONFIG_KEY_0="url.https://x-access-token:${GH_TOKEN}@github.com/.insteadOf"
export GIT_CONFIG_VALUE_0="https://github.com/"

# --- build the prompt: swe-implementer persona + normalized brief ---------------------------------
persona="$(awk 'BEGIN{fm=0} /^---$/{fm++;next} fm>=2{print}' "$AGENT_DEF")"
promptfile="$work/prompt.md"
{
  printf '%s\n\n' "$persona"
  printf -- '---\n\n# Forward-fix task\n\n'
  printf -- 'The harness has ALREADY satisfied your context requirements; do not block on them:\n'
  printf -- '- Approval to implement: GRANTED (operator invoked this harness explicitly).\n'
  printf -- '- Repository: `%s`. Repository path: the current working directory (a fresh clone).\n' "$repo"
  printf -- '- Branch: `%s`, already created off `%s` at `%s`; base is correct and the tree is clean.\n' "$branch" "$default_branch" "${base_sha:0:10}"
  printf -- '- Identity is handled by the harness; you do NOT need a pr-safety identity block to proceed.\n'
  printf -- '- Source of this task: %s\n\n' "$source_ref"
  printf 'This is an implementation against the CURRENT default branch, not a re-review of the original PR.\n'
  printf 'Re-verify each item still holds in the current tree, then implement the smallest correct change,\n'
  printf 'add/adjust the tests the repo requires, run the repo'\''s own validation, and STOP with a commit on\n'
  printf 'this branch. If an item no longer applies (already fixed on the default branch), skip it and say so.\n'
  printf 'Do not push or open a PR. Do not touch any other repository.\n\n'
  printf '## Task\n\n%s\n' "$task_text"
} > "$promptfile"

log "running swe-implementer ($MODEL)"
"$MEWRITE" exec --model "$MODEL" --cwd "$work/repo" "$(<"$promptfile")" 2>&1 | tee "$work/agent.log" || true

# --- only proceed if the agent actually committed something --------------------------------------
if [[ "$(git rev-parse HEAD)" == "$base_sha" ]]; then
  log "no commit produced — nothing to open a PR for. agent log at $work/agent.log"
  log "(leaving clone in place for inspection: $work)"; trap - EXIT
  exit 1
fi
git -c core.pager=cat diff --stat "$base_sha"..HEAD | sed 's/^/swe-implement diff: /' >&2

if (( ! open_pr )); then
  log "committed on $branch (--no-pr): inspect at $work/repo"; trap - EXIT
  exit 0
fi

# --- create the commit on the remote branch via the GitHub API, then open a DRAFT PR -------------
# Replay the agent's local commit through GraphQL createCommitOnBranch instead of `git push`, so the
# resulting commit is signed by GitHub (committer=GitHub, "Verified") without shipping a signing key
# into the container. The local commit is used only to compute the tree delta.
log "creating signed commit on $branch via GitHub API and opening DRAFT PR"
commit_title="$(git log -1 --format='%s' HEAD)"
commit_body="$(git log -1 --format='%b' HEAD)"
diff_stat="$(git -c core.pager=cat diff --stat "$base_sha"..HEAD)"

# The remote branch ref must exist at base before createCommitOnBranch (expectedHeadOid = base).
gh api --method POST "repos/$repo/git/refs" -f ref="refs/heads/$branch" -f sha="$base_sha" >/dev/null 2>&1 \
  || die "could not create remote branch $branch (needs push + SAML on $repo; already exists?)"
drop_remote_branch() { gh api --method DELETE "repos/$repo/git/refs/heads/$branch" >/dev/null 2>&1 || true; }

# Build fileChanges from the local diff. --no-renames turns a rename into delete-old + add-new, which
# is exactly the additions/deletions shape createCommitOnBranch wants. base64 is binary-safe.
adds_nd="$work/adds.ndjson"; dels_nd="$work/dels.ndjson"; : >"$adds_nd"; : >"$dels_nd"
while IFS= read -r -d '' status && IFS= read -r -d '' path; do
  case "$status" in
    D) jq -cn --arg p "$path" '{path:$p}' >>"$dels_nd" ;;
    *) b64="$(git show "HEAD:$path" | base64 | tr -d '\n')"
       jq -cn --arg p "$path" --arg c "$b64" '{path:$p, contents:$c}' >>"$adds_nd" ;;
  esac
done < <(git diff --name-status --no-renames -z "$base_sha" HEAD)

commit_oid="$(jq -cn \
  --arg repo "$repo" --arg br "$branch" --arg oid "$base_sha" \
  --arg h "$(git log -1 --format='%s' HEAD)" --arg b "$(git log -1 --format='%b' HEAD)" \
  --slurpfile a <(jq -cs '.' "$adds_nd") --slurpfile d <(jq -cs '.' "$dels_nd") '
  {query:"mutation($input: CreateCommitOnBranchInput!){createCommitOnBranch(input:$input){commit{oid}}}",
   variables:{input:{
     branch:{repositoryNameWithOwner:$repo, branchName:$br},
     message:{headline:$h, body:$b},
     expectedHeadOid:$oid,
     fileChanges:{additions:$a[0], deletions:$d[0]}}}}' \
  | gh api graphql --input - --jq '.data.createCommitOnBranch.commit.oid' 2>&1)" \
  && [[ -n "$commit_oid" && "$commit_oid" != null ]] \
  || { drop_remote_branch; die "createCommitOnBranch failed: ${commit_oid:-no oid}"; }
log "signed commit $commit_oid on $branch"
title="${commit_title:-${fallback_title:-swe-implement: ${source_ref}}}"
title="${title:0:72}"
if [[ -n "$commit_body" ]]; then summary="${commit_body:0:8000}"; else summary="${task_text:0:4000}"; fi
body="$(printf '## Summary\n\n%s\n\n## Diff\n\n```text\n%s\n```\n\n## Source\n\n- Task: %s\n- Base: `%s@%s`\n- Agent: `swe-implementer` (`%s`)\n\nDraft generated from a fresh default-branch clone. Human review and merge are required.\n' "$summary" "$diff_stat" "$source_ref" "$default_branch" "${base_sha:0:10}" "$MODEL")"
url="$(gh pr create --repo "$repo" --base "$default_branch" --head "$branch" --draft --title "$title" --body "$body" 2>&1)" || { drop_remote_branch; die "gh pr create failed: $url"; }
log "draft PR: $url"
if [[ "$url" =~ ^https://github.com/[^/]+/[^/]+/pull/([1-9][0-9]*)$ ]]; then
  review_request="$(jq -cn --arg repo "$repo" --arg pr "${BASH_REMATCH[1]}" --arg url "$url" --arg title "$title" --arg head "$commit_oid" \
    '{repo:$repo, pr:$pr, url:$url, title:$title, head_sha:$head}')"
  log "draft PR review request: $review_request"
else
  log "WARN: could not build pr-review request from draft PR url: $url"
fi
trap - EXIT   # keep the clone for the pushed branch's provenance
