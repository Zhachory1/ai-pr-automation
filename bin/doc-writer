#!/usr/bin/env bash
# doc-writer harness: run a Rokt PRD/DD persona (with the bundled handbook) over a request payload,
# parse the draft + machine-readable open_questions, and either (a) hand the draft + questions back to
# the server for the human-review answer loop, or (b) on finalize/no-questions, run council and write
# exact finished bytes for human publication approval.
#
# Contract: reads one JSON payload via --payload '<json>'. Emits ONE result JSON to stdout:
#   staged  : {"status":"open_questions","draft_path":..,"open_questions":[..],"round":N}
#   final   : {"status":"awaiting_approval","staged_path":..,"target_path":..,
#              "content_digest":..,"document_generation":..,"council":"reviewed|skipped"}
#   error   : nonzero exit + {"status":"error","reason":..}
# All human-facing artifacts are files; stdout is machine JSON only (logs go to stderr).
set -euo pipefail
umask 077

HERE="$(cd "$(dirname "$0")/.." && pwd)"
MEWRITE="${MEWRITECODE_BIN:-mewritecode}"
MODEL="${DOC_WRITER_MODEL:-openai/gpt-5.6-sol}"
RUNTIME="${DOC_WRITER_RUNTIME:-legacy}"
HERMES_MODEL_BIN="${HERMES_DOC_MODEL_BIN:-$HERE/bin/hermes-doc-model}"
QUEUE_NONCE="${DOC_WRITER_QUEUE_NONCE:-}"
APPROVED_GENERATION="${HERMES_DOC_APPROVED_GENERATION:-}"
CONFIG_ROOT="${MEWRITE_CODING_AGENT_DIR:-$HERE/agent-config/doc-writer}"
AGENTS_DIR="${DOC_WRITER_AGENTS_DIR:-$CONFIG_ROOT/agents}"
HANDBOOK_DIR="${DOC_WRITER_HANDBOOK_DIR:-$CONFIG_ROOT/handbook}"
STAGE_DIR="${DOC_WRITER_STAGE_DIR:-$HOME/.local/share/ai-pr-automation/doc-writer}"
INBOX_DIR="${DOC_WRITER_INBOX_DIR:-$HOME/private-docs/inbox}"
ROUND_CAP="${DOC_WRITER_ROUND_CAP:-4}"
# Agent + council budgets must SUM to under the worker's PER_REQUEST_TIMEOUT (1800s) so the worker
# never SIGKILLs the harness mid-council and loses an otherwise-finished draft.
RUN_TIMEOUT="${DOC_WRITER_TIMEOUT:-1000}"           # agent draft budget
COUNCIL_TIMEOUT="${DOC_WRITER_COUNCIL_TIMEOUT:-500}"  # council review budget (only on finalize)
COUNCIL_SKILL="${DOC_WRITER_COUNCIL_SKILL:-}"   # optional path to the council skill; empty = try default
PUBLICATION_BIN="${DOC_WRITER_PUBLICATION_BIN:-$HERE/bin/doc-writer-publication}"
REQUEST_ID="${DOC_WRITER_REQUEST_ID:-}"
GENERATED_AT="${DOC_WRITER_GENERATED_AT:-$(date '+%Y-%m-%dT%H:%M:%S%z')}"

log() { printf '%s doc-writer %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >&2; }
emit() { printf '%s\n' "$1"; }                 # the one machine-JSON line on stdout
die() { log "FATAL: $*"; jq -cn --arg r "$*" '{status:"error",reason:$r}'; exit 2; }

# Council review of a finalized draft, written to $2. This is a SINGLE-LENS review (one adversarial
# pass with named dissents) run via mewritecode in-container — not the full multi-persona council
# orchestrator (which needs AGENT_FLEET_HOME + lib helpers not present here). A bundled review rubric
# is used if present. Degrades gracefully (M3): returns nonzero on any failure so the caller writes
# the NOT-REVIEWED banner rather than passing off an un-reviewed doc.
run_council() {
  local draft="$1" out="$2"
  [[ "${DOC_WRITER_COUNCIL:-on}" == on ]] || { log "council disabled (DOC_WRITER_COUNCIL=off); skipping"; return 1; }
  # An explicit COUNCIL_SKILL that points at a missing file means "force skip" (used by tests).
  [[ -n "$COUNCIL_SKILL" && ! -f "$COUNCIL_SKILL" ]] && { log "council skill path set but missing; skipping"; return 1; }
  local rubric=""
  local bundled="$AGENTS_DIR/../skills/council/SKILL.md"
  [[ -f "$bundled" ]] && rubric="Review rubric (from the council skill):\n$(head -c 8000 "$bundled")\n\n"
  local prompt
  prompt="You are an adversarial single-lens reviewer. Critically review the DRAFT DOCUMENT below (a Rokt PRD or Design Doc). Give a concise verdict (accept / accept-with-nits / request-changes), the top issues (each: the problem, why it matters, smallest fix), the strongest counterargument, and any named dissent. Do not rewrite the doc. ${rubric}\n---\nDRAFT:\n\n$(head -c 60000 "$draft")"
  local rev; rev="$("$TIMEOUT_BIN" "${COUNCIL_TIMEOUT}s" "$MEWRITE" exec --model "$MODEL" --cwd "$CONFIG_ROOT" "$prompt" 2>/dev/null)" || return 1
  [[ -n "$rev" ]] || return 1
  printf '%s\n' "$rev" > "$out"; return 0
}

run_hermes() {
  local phase="$1" out="$2" payload="$3" timeout="$4" metadata helper_status digest rc=0 response
  local -a args
  metadata="$work/$phase-model.json"
  args=("$phase" --request-id "$REQUEST_ID" --queue-nonce "$QUEUE_NONCE" \
    --runtime-generation "$APPROVED_GENERATION" --stage-root "$STAGE_DIR")
  [[ "$phase" == draft ]] && args+=(--payload "$payload")
  HERMES_DOC_RUN_TIMEOUT="$timeout" "$HERMES_MODEL_BIN" "${args[@]}" >"$metadata" || rc=$?
  if (( rc != 0 )); then
    helper_status="$(jq -r '.status // empty' "$metadata" 2>/dev/null || true)"
    if [[ "$helper_status" == reconcile || "$helper_status" == failed ]]; then
      emit "$(jq -c --arg status "$helper_status" --arg phase "$phase" \
        '{status:$status,reason:(.reason // ("Hermes "+$phase+" failed"))}' "$metadata")"
      [[ "$helper_status" == reconcile ]] && exit 3 || exit 2
    fi
    die "Hermes $phase failed without terminal metadata"
  fi
  response="$(jq -r '.response_file // empty' "$metadata")"
  digest="$(jq -r '.output_digest // empty' "$metadata")"
  [[ "$response" == "requests/$REQUEST_ID/$phase-response.json" && "$digest" =~ ^[0-9a-f]{64}$ ]] \
    || die "Hermes $phase returned invalid response metadata"
  python3 - "$STAGE_DIR" "$REQUEST_ID" "$phase-response.json" "$out" "$digest" <<'PY'
import hashlib, json, os, stat, sys
root, request_id, name, target, expected = sys.argv[1:]
fds = []
try:
    parent = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW); fds.append(parent)
    requests = os.open("requests", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent); fds.append(requests)
    directory = os.open(request_id, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=requests); fds.append(directory)
    source_fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=directory)
    with os.fdopen(source_fd, encoding="utf-8") as source:
        if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
            raise ValueError("Hermes response is not a regular file")
        envelope = json.load(source)
finally:
    for descriptor in reversed(fds): os.close(descriptor)
output = envelope.get("output") if isinstance(envelope, dict) else None
if not isinstance(output, str) or hashlib.sha256(output.encode()).hexdigest() != expected:
    raise SystemExit("Hermes response output digest mismatch")
with open(target, "w", encoding="utf-8") as destination:
    destination.write(output)
PY
}

need() { command -v "$1" >/dev/null 2>&1 || { echo "doc-writer: missing dependency: $1" >&2; exit 2; }; }
need jq; need python3
case "$RUNTIME" in legacy|hermes) ;; *) die "DOC_WRITER_RUNTIME must be legacy or hermes" ;; esac
if [[ "$RUNTIME" == legacy ]]; then
  command -v "$MEWRITE" >/dev/null || die "missing mewritecode ($MEWRITE)"
else
  [[ -x "$HERMES_MODEL_BIN" ]] || die "missing Hermes model helper: $HERMES_MODEL_BIN"
  [[ -n "$QUEUE_NONCE" ]] || die "DOC_WRITER_QUEUE_NONCE is required in Hermes mode"
  [[ "$APPROVED_GENERATION" =~ ^[0-9a-f]{64}$ ]] || die "HERMES_DOC_APPROVED_GENERATION must be SHA-256"
fi
[[ -x "$PUBLICATION_BIN" ]] || die "missing publication helper: $PUBLICATION_BIN"
[[ "$REQUEST_ID" =~ ^[1-9][0-9]*$ ]] || die "DOC_WRITER_REQUEST_ID must be a positive integer"
[[ -d "$HANDBOOK_DIR" ]] || die "missing handbook dir: $HANDBOOK_DIR"
TIMEOUT_BIN="$(command -v timeout || command -v gtimeout || true)"
[[ "$RUNTIME" == hermes || -n "$TIMEOUT_BIN" ]] || die "GNU timeout required"

PAYLOAD=""
while [[ $# -gt 0 ]]; do case "$1" in --payload) PAYLOAD="${2:?}"; shift 2;; *) die "unknown arg: $1";; esac; done
[[ -n "$PAYLOAD" ]] || die "missing --payload"
echo "$PAYLOAD" | jq -e . >/dev/null 2>&1 || die "payload is not valid JSON"

get() { printf '%s' "$PAYLOAD" | jq -r "$1 // empty"; }
doc_type="$(get '.doc_type')"; title="$(get '.title')"; requirements="$(get '.requirements')"
round="$(get '.round')"; [[ "$round" =~ ^[0-9]+$ ]] || round=1
prior_draft="$(get '.prior_draft')"; answers="$(get '.answers')"; finalize="$(get '.finalize')"
[[ -n "$title" ]] || die "payload missing title"
[[ -n "$requirements" || -n "$prior_draft" ]] || die "payload needs requirements or prior_draft"
# Defense-in-depth: prior_draft is only ever the harness's own staged draft path (round-tripped by
# status-server), but assert it resolves INSIDE $STAGE_DIR before we read it into the prompt, so a
# future direct-enqueue path or a bug can't make the harness slurp an arbitrary file.
if [[ -n "$prior_draft" ]]; then
  rp_stage="$(cd "$STAGE_DIR" 2>/dev/null && pwd -P || true)"
  rp_draft="$(cd "$(dirname "$prior_draft")" 2>/dev/null && pwd -P || true)/$(basename "$prior_draft")"
  [[ -n "$rp_stage" && "$rp_draft" == "$rp_stage"/* ]] || die "prior_draft must be inside $STAGE_DIR: $prior_draft"
fi

case "$doc_type" in
  seprd|mlprd|launchpad) persona_file="$AGENTS_DIR/prd-writer.md"; kind_label="PRD" ;;
  dd)                    persona_file="$AGENTS_DIR/dd-writer.md";  kind_label="DD"  ;;
  *) die "unknown doc_type: $doc_type (want seprd|mlprd|launchpad|dd)" ;;
esac
[[ -f "$persona_file" ]] || die "missing persona: $persona_file"

# slug: lowercase, [a-z0-9-] only, collapse dashes, cap length. Prevents path tricks + clobber-by-title.
slug="$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' \
        | sed 's/-\{2,\}/-/g; s/^-//; s/-$//' | cut -c1-48)"
slug="${slug:-untitled}"

target_name() {
  local date_str="${GENERATED_AT:0:10}" target="${doc_type}-${GENERATED_AT:0:10}-${slug}.md" n
  [[ "$date_str" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "DOC_WRITER_GENERATED_AT must start with YYYY-MM-DD"
  if [[ -e "$INBOX_DIR/$target" ]]; then
    n=2
    while [[ -e "$INBOX_DIR/${doc_type}-${date_str}-${slug}-${n}.md" ]]; do n=$((n+1)); done
    target="${doc_type}-${date_str}-${slug}-${n}.md"
  fi
  printf '%s' "$target"
}

if [[ "$RUNTIME" == legacy ]]; then
  generation_hash="$(python3 - "$MODEL" "$doc_type" "$0" "$persona_file" "$HANDBOOK_DIR" "$PUBLICATION_BIN" <<'PY'
import hashlib, pathlib, sys
model, doc_type, harness, persona, handbook, publisher = sys.argv[1:]
h = hashlib.sha256()
for value in ("legacy-doc-writer-v1", model, doc_type):
    h.update(value.encode()); h.update(b"\0")
for path in [pathlib.Path(harness), pathlib.Path(persona), pathlib.Path(publisher),
             *sorted(pathlib.Path(handbook).glob("*.md"))]:
    h.update(path.name.encode()); h.update(b"\0"); h.update(path.read_bytes()); h.update(b"\0")
print(h.hexdigest())
PY
)"
  document_generation="legacy:$generation_hash"
else
  document_generation="hermes:$APPROVED_GENERATION"
fi

[[ -d "$INBOX_DIR" ]] || die "missing inbox dir: $INBOX_DIR"
request_stage="$STAGE_DIR/requests/$REQUEST_ID"
mkdir -p "$request_stage"
existing_publish="$request_stage/publish.md"
if [[ -f "$existing_publish" && ! -L "$existing_publish" ]]; then
  staged="$($PUBLICATION_BIN stage --stage-root "$STAGE_DIR" --request-id "$REQUEST_ID" < "$existing_publish")"
  [[ "$(jq -r '.status // empty' <<<"$staged")" == staged ]] || die "existing publication staging invalid"
  grep -q '^human_reviewed: true$' "$existing_publish" || die "existing publication lacks approval marker"
  council_state=skipped; grep -q '^council_reviewed: true$' "$existing_publish" && council_state=reviewed
  stored_generation="$(awk '/^document_generation: /{print $2; exit}' "$existing_publish")"
  [[ "$stored_generation" =~ ^(legacy|hermes):[0-9a-f]{64}$ ]] || die "existing publication generation invalid"
  emit "$(jq -cn --arg p "$(jq -r .staged_path <<<"$staged")" --arg t "$(target_name)" \
    --arg d "$(jq -r .content_digest <<<"$staged")" --arg g "$stored_generation" --arg c "$council_state" \
    '{status:"awaiting_approval",staged_path:$p,target_path:$t,content_digest:$d,
      document_generation:$g,council:$c}')"
  exit 0
fi

mkdir -p "$STAGE_DIR"
work="$(mktemp -d "${TMPDIR:-/tmp}/doc-writer.XXXXXX")"; trap 'rm -rf "$work"' EXIT
persona="$(awk 'BEGIN{fm=0} /^---$/{fm++;next} fm>=2{print}' "$persona_file")"

# --- build the prompt: persona + handbook path + this request/round ------------------------------
promptfile="$work/prompt.md"
{
  printf '%s\n\n---\n\n# This request\n\n' "$persona"
  printf 'Handbook files are readable at: %s  (Read the relevant ones before drafting.)\n\n' "$HANDBOOK_DIR"
  printf -- '- doc_type: %s\n- title: %s\n- round: %s\n\n' "$doc_type" "$title" "$round"
  if [[ -n "$prior_draft" && -f "$prior_draft" ]]; then
    printf '## Prior draft (revise this)\n\n```\n'; head -c 60000 "$prior_draft"; printf '\n```\n\n'
    printf '## Human answers to your Open Questions\n\n%s\n\n' "$answers"
    printf 'Fold these answers in, remove resolved Open Questions, keep the rest.\n\n'
  else
    printf '## Requirements\n\n%s\n\n' "$requirements"
  fi
  printf 'Produce the document per your template, then the final open_questions JSON block.\n'
} > "$promptfile"

if [[ "$RUNTIME" == legacy ]]; then
  log "running $kind_label persona ($MODEL) round $round for '$title'"
  raw="$("$TIMEOUT_BIN" "${RUN_TIMEOUT}s" "$MEWRITE" exec --model "$MODEL" --cwd "$CONFIG_ROOT" \
         "$(<"$promptfile")" 2>"$work/agent.err" </dev/null)" || { die "agent run failed/timed out: $(tail -c 300 "$work/agent.err")"; }
else
  log "running $kind_label persona (hermes) round $round for '$title'"
  run_hermes draft "$work/raw-hermes.txt" "$PAYLOAD" "$RUN_TIMEOUT"
  raw="$(cat "$work/raw-hermes.txt")"
fi

# --- split the draft from the trailing open_questions JSON block ----------------------------------
# Parse the LAST brace-balanced object that has an open_questions list (handles nested braces inside
# a question, unlike a [^{}] class), strip that exact object (and any fence) from the draft, and
# default to "needs human" on absent/malformed (never a silent finalize). One pass writes oq + draft.
printf '%s' "$raw" > "$work/raw.txt"
python3 - "$work/raw.txt" "$work/oq.json" "$work/draft.md" <<'PY'
import sys, json
raw = open(sys.argv[1]).read()

def balanced_objects(s):
    # yield (start, end) index spans of every top-level-ish brace-balanced {...} object.
    depth = 0; start = None; instr = False; esc = False
    for i, c in enumerate(s):
        if instr:
            if esc: esc = False
            elif c == "\\": esc = True
            elif c == '"': instr = False
            continue
        if c == '"': instr = True
        elif c == '{':
            if depth == 0: start = i
            depth += 1
        elif c == '}':
            if depth > 0:
                depth -= 1
                if depth == 0 and start is not None:
                    yield (start, i + 1)

picked = None; span = None
for a, b in balanced_objects(raw):
    frag = raw[a:b]
    try:
        d = json.loads(frag)
    except Exception:
        continue
    if isinstance(d, dict) and isinstance(d.get("open_questions"), list):
        picked = [str(q) for q in d["open_questions"]][:20]; span = (a, b)

if picked is None:
    open(sys.argv[2], "w").write("__NEEDS_HUMAN__")
    open(sys.argv[3], "w").write(raw.strip())
else:
    open(sys.argv[2], "w").write(json.dumps(picked))
    a, b = span
    draft = raw[:a]
    # also drop an immediately-preceding ```json fence and a trailing ``` after the object.
    import re
    draft = re.sub(r"```(?:json)?\s*$", "", draft.rstrip(), flags=re.S)
    tail = raw[b:]
    tail = re.sub(r"^\s*```", "", tail.lstrip(), flags=re.S)
    open(sys.argv[3], "w").write((draft + tail).strip())
PY
oq="$(cat "$work/oq.json")"
draft="$(cat "$work/draft.md")"
[[ -n "$draft" ]] || die "agent produced no draft"

if [[ "$oq" == "__NEEDS_HUMAN__" ]]; then
  log "no parseable open_questions block; treating as needs-human (safe default)"
  oq='["The generated draft did not include a machine-readable questions block; please review it directly and refine or finalize."]'
fi
oq_count="$(printf '%s' "$oq" | jq 'length')"

# --- route: queue for answers, or finalize (council + write) -------------------------------------
draftfile="$request_stage/draft.md"
printf '%s\n' "$draft" > "$draftfile"

# finalize when: caller forced it, OR no open questions, OR round cap reached.
force_final=0
[[ "$finalize" == "true" ]] && force_final=1
(( oq_count == 0 )) && force_final=1
(( round >= ROUND_CAP )) && { force_final=1; log "round cap $ROUND_CAP reached; finalizing"; }

if (( ! force_final )); then
  log "round $round: $oq_count open question(s); handing back for human answers"
  emit "$(jq -cn --arg p "$draftfile" --argjson oq "$oq" --argjson r "$round" \
    '{status:"open_questions", draft_path:$p, open_questions:$oq, round:$r}')"
  exit 0
fi

# --- finalize: council review, then stage exact bytes for publication approval ---------------------
council_state="skipped"; council_note="council skipped: infra unavailable in this environment"
council_out="$work/council.md"
if [[ "${DOC_WRITER_COUNCIL:-on}" != on ]]; then
  log "council disabled (DOC_WRITER_COUNCIL=off); skipping"
elif [[ "$RUNTIME" == hermes ]]; then
  run_hermes council "$council_out" "" "$COUNCIL_TIMEOUT"
  council_state="reviewed"; council_note="$(cat "$council_out")"
elif run_council "$draftfile" "$council_out"; then
  council_state="reviewed"; council_note="$(cat "$council_out")"
fi

target="$(target_name)"
final="$work/final.md"
{
  printf -- '---\n'
  printf 'written_by: doc-writer-agent\n'
  printf 'human_reviewed: true\n'
  printf 'council_reviewed: %s\n' "$([[ "$council_state" == reviewed ]] && echo true || echo false)"
  printf 'document_generation: %s\n' "$document_generation"
  printf 'doc_type: %s\n' "$doc_type"
  printf 'generated: %s\n' "$GENERATED_AT"
  printf -- '---\n\n'
  if [[ "$council_state" != reviewed ]]; then
    printf '> \342\232\240 COUNCIL SKIPPED \342\200\224 NOT REVIEWED. %s\n\n' "$council_note"
  fi
  printf '%s\n\n' "$draft"
  printf -- '---\n\n## Council Review\n\n%s\n' "$council_note"
} > "$final"

staged="$($PUBLICATION_BIN stage --stage-root "$STAGE_DIR" --request-id "$REQUEST_ID" < "$final")"
[[ "$(jq -r '.status // empty' <<<"$staged")" == staged ]] || die "publication staging failed"
log "staged request $REQUEST_ID for exact publication approval (council=$council_state)"
emit "$(jq -cn --arg p "$(jq -r .staged_path <<<"$staged")" --arg t "$target" \
  --arg d "$(jq -r .content_digest <<<"$staged")" --arg g "$document_generation" --arg c "$council_state" \
  '{status:"awaiting_approval", staged_path:$p, target_path:$t, content_digest:$d,
    document_generation:$g, council:$c}')"
