#!/usr/bin/env bash
# hermes-pr-producer — discovery producer for the host-native fleet. Finds matching open PRs and
# enqueues one requests row per PR head for the dispatcher to consume. Never invokes a model.
#
#   hermes-pr-producer review    -> PRs assigned to the fleet account   (kind=pr-review)
#   hermes-pr-producer maintain  -> PRs authored by the fleet account   (kind=pr-maintain)
#
# Repo scope comes from the operator authority YAML (scope-of-attention, not security; see
# docs/hermes/DD-authority-and-memory.md). The collapsed queue API takes no proof. Review dedupe is
# per exact head; direct maintenance dedupe is per canonical actionable-feedback snapshot.
set -euo pipefail
umask 077

MODE="${1:-}"
case "$MODE" in
  review)   KIND=pr-review;   GH_FILTER=--assignee ;;
  maintain) KIND=pr-maintain; GH_FILTER=--author ;;
  *) echo "usage: hermes-pr-producer <review|maintain>" >&2; exit 2 ;;
esac

HERE="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd || echo /usr/local/libexec/ai-pr-automation)"
: "${REQUESTS_DB_USER:=hermes_runtime}"; : "${REQUESTS_DB_NAME:=fleet}"
: "${REQUESTS_DB_HOST:=127.0.0.1}"; : "${REQUESTS_DB_PORT:=5432}"
GH_TIMEOUT_SECONDS="${PR_PRODUCER_GH_TIMEOUT_SECONDS:-60}"
MAX_UPDATED_AGE_DAYS="${PR_PRODUCER_MAX_UPDATED_AGE_DAYS:-0}"   # 0 disables
AUTHORITY="${HERMES_AUTHORITY_FILE:-/usr/local/etc/ai-pr-automation/authority.yaml}"
AUTHORITY_BIN="${HERMES_AUTHORITY_BIN:-$HERE/scripts/hermes-authority.py}"
[[ -x "$AUTHORITY_BIN" ]] || AUTHORITY_BIN="${HERMES_AUTHORITY_BIN:-/usr/local/libexec/ai-pr-automation/hermes-authority.py}"
if [[ "$MODE" == review ]]; then QUEUE_VAR=PR_REVIEW_QUEUE_ENGINE; else QUEUE_VAR=PR_MAINTAIN_QUEUE_ENGINE; fi
QUEUE_ENGINE="${!QUEUE_VAR:-postgres}"
[[ "$QUEUE_ENGINE" == postgres || "$QUEUE_ENGINE" == kanban ]] \
  || { echo "$QUEUE_VAR must be postgres or kanban" >&2; exit 2; }

ts() { date '+%Y-%m-%dT%H:%M:%S%z'; }
log() { echo "$(ts) hermes-pr-producer[$MODE] $*" >&2; }
need() { command -v "$1" >/dev/null 2>&1 || { echo "missing dependency: $1" >&2; exit 2; }; }
need gh; need jq; need python3
TIMEOUT_BIN="$(command -v timeout || command -v gtimeout || true)"
[[ -n "$TIMEOUT_BIN" ]] || { echo "GNU timeout required (coreutils)" >&2; exit 2; }
if [[ "$QUEUE_ENGINE" == postgres ]]; then
  need psql
else
  for required in HERMES_BIN HERMES_HOME HERMES_PYTHON HERMES_PR_KANBAN_ENQUEUE HERMES_PR_KANBAN_WORK_ROOT; do
    [[ -n "${!required:-}" ]] || { echo "$required is required for Kanban $MODE" >&2; exit 2; }
  done
  [[ "$HERMES_PR_KANBAN_WORK_ROOT" == /* ]] || { echo "HERMES_PR_KANBAN_WORK_ROOT must be absolute" >&2; exit 2; }
  [[ -x "$HERMES_BIN" && -x "$HERMES_PYTHON" && -f "$HERMES_PR_KANBAN_ENQUEUE" && -d "$HERMES_HOME" ]] \
    || { echo "host Hermes Kanban enqueue support is unavailable" >&2; exit 2; }
  mkdir -p "$HERMES_PR_KANBAN_WORK_ROOT"; chmod 0700 "$HERMES_PR_KANBAN_WORK_ROOT"
fi
psqlq() { psql -qAt -v ON_ERROR_STOP=1 -h "$REQUESTS_DB_HOST" -p "$REQUESTS_DB_PORT" -U "$REQUESTS_DB_USER" -d "$REQUESTS_DB_NAME" "$@"; }
gh_read() { "$TIMEOUT_BIN" --kill-after=5s "${GH_TIMEOUT_SECONDS}s" gh "$@"; }

direct_enqueue() {
  local kind="$1" payload="$2" operation result checked
  operation="$(jq -r .operation_id <<<"$payload")"
  result="$(printf '%s' "$payload" | "$TIMEOUT_BIN" --kill-after=5s 120s "$HERMES_PYTHON" -B "$HERMES_PR_KANBAN_ENQUEUE" \
    --kind "$kind" --hermes-home "$HERMES_HOME" --hermes-bin "$HERMES_BIN" \
    --workspace-root "$HERMES_PR_KANBAN_WORK_ROOT" 2>/dev/null | head -c 4096)" || return
  checked="$(jq -ceS --arg kind "$kind" --arg board "$kind" --arg op "$operation" \
    '. as $r | select(type=="object" and keys==["board","kind","operation_id","status","task_id"] and .kind==$kind and .board==$board and .operation_id==$op and (.task_id|type=="string" and test("^t_[0-9a-f]{8}$")) and (["active","done","ready","review"]|index($r.status)!=null))' \
    <<<"$result" 2>/dev/null)" || return
  [[ "$result" == "$checked" ]]
}

feedback_snapshot() {
  local repo="$1" number="$2" login="$3" dir owner name
  dir="$DISCOVERY_TMP/${repo//\//_}-$number"; owner="${repo%%/*}"; name="${repo#*/}"; mkdir -p "$dir"
  gh_read api --paginate "repos/$repo/pulls/$number/reviews?per_page=100" >"$dir/reviews" 2>/dev/null || return
  gh_read api graphql --paginate -F owner="$owner" -F name="$name" -F number="$number" -f query='query($owner:String!,$name:String!,$number:Int!,$endCursor:String){repository(owner:$owner,name:$name){pullRequest(number:$number){reviewThreads(first:100,after:$endCursor){nodes{id isResolved isOutdated comments(last:100){nodes{id databaseId author{login} body createdAt updatedAt}}} pageInfo{hasNextPage endCursor}}}}}' >"$dir/threads" 2>/dev/null || return
  if ! gh_read pr checks "$number" -R "$repo" --json name,bucket,state,link >"$dir/checks" 2>/dev/null; then
    jq -e 'type=="array"' "$dir/checks" >/dev/null 2>&1 || return
  fi
  jq -ecnSj --arg login "${login,,}" --slurpfile rp "$dir/reviews" \
    --slurpfile tp "$dir/threads" --slurpfile kp "$dir/checks" '
      def pages($p): if ($p|length>0 and all(.[];type=="array")) then ($p|add) else error("invalid pages") end;
      def external: (.author|type=="string") and ((.author|ascii_downcase)!=$login);
      (pages($rp)) as $reviews | (pages($kp)) as $checks |
      ($tp|map(.data.repository.pullRequest.reviewThreads.nodes) |
        if length>0 and all(.[];type=="array") then add else error("invalid threads") end) as $threads |
      {reviews:([$reviews[] | {id,author:.user.login,body,submittedAt:.submitted_at} |
          select(.id!=null and external and (.body|type=="string" and test("\\S")))] | sort_by(.id|tostring) | unique_by(.id)),
       threads:([$threads[] | select(.id|type=="string") | select(.isResolved==false and .isOutdated==false) |
          {id,isResolved,isOutdated,comments:([.comments.nodes[] | {id,databaseId,author:.author.login,body,createdAt,updatedAt} |
            select(.id|type=="string") | select(external and (.body|type=="string" and test("\\S")))] |
            sort_by([.id,(.databaseId|tostring)]) | unique_by(.id))} | select(.comments|length>0)] | sort_by(.id) | unique_by(.id)),
       checks:([$checks[] | {name,bucket,state,link} | select(.bucket=="fail")] |
          sort_by([.name,.link,.state]) | unique_by([.name,.link,.state]))}' >"$dir/snapshot.json" 2>/dev/null || return
  "$HERMES_PYTHON" -c '
import hashlib,json,sys
value=json.load(open(sys.argv[1])); digest=lambda raw: hashlib.sha256(raw).hexdigest()
body=lambda item: digest(item["body"].encode())
items=[["review",str(item["id"]),body(item)] for item in value["reviews"]]
items += [["thread",thread["id"],item["id"],body(item)] for thread in value["threads"] for item in thread["comments"]]
items += [["check",digest(json.dumps(item,sort_keys=True,separators=(",",":"),ensure_ascii=False).encode())] for item in value["checks"]]
print("empty" if not items else digest(json.dumps(sorted(items),separators=(",",":"),ensure_ascii=False).encode()))
' "$dir/snapshot.json" 2>/dev/null
}

maintenance_round() {
  PYTHONPATH="$(dirname "$HERMES_PR_KANBAN_ENQUEUE")" "$HERMES_PYTHON" -B -c '
import json,os,pathlib,re,stat,sys
from hermes_direct_pr_journal import identity
root,repo,number,current=pathlib.Path(sys.argv[1]),sys.argv[2].lower(),int(sys.argv[3]),sys.argv[4]
info=root.lstat()
if not stat.S_ISDIR(info.st_mode) or root.is_symlink() or info.st_uid!=os.geteuid() or stat.S_IMODE(info.st_mode)!=0o700: raise SystemExit(1)
requests=[]
for entry in os.scandir(root):
 if re.fullmatch(r"pr-maintain-[0-9a-f]{64}",entry.name) and entry.is_dir(follow_symlinks=False):
  path=pathlib.Path(entry.path)/"request.json"
  try: path.lstat()
  except FileNotFoundError: continue
  requests.append(path)
  if len(requests)>1000: raise SystemExit(1)
digests={}
for path in sorted(requests):
 try:
  descriptor=os.open(path,os.O_RDONLY|os.O_NOFOLLOW)
  with os.fdopen(descriptor,"rb") as stream:
   i=os.fstat(descriptor)
   if not stat.S_ISREG(i.st_mode) or i.st_uid!=os.geteuid() or i.st_nlink!=1 or stat.S_IMODE(i.st_mode)!=0o440: continue
   raw=stream.read(16385)
  if len(raw)>16384: continue
  value=json.loads(raw)
  canonical=json.dumps(value,sort_keys=True,separators=(",",":"),ensure_ascii=False,allow_nan=False).encode()
  if raw!=canonical or set(value)!={"operation_id","repo","number","url","title","head_sha","feedback_digest","round"}: continue
  operation=identity("pr-maintain",value["repo"],value["number"],value["head_sha"],value["feedback_digest"])
  if value["operation_id"]!=operation["operation_id"] or value["repo"].lower()!=repo or value["number"]!=number: continue
  if type(value["round"]) is not int or value["round"] not in range(1,4): continue
  digests.setdefault(value["feedback_digest"],value["operation_id"])
 except (OSError,ValueError,KeyError,TypeError): continue
if current in digests: print("duplicate:"+digests[current])
elif len(digests)>=3: print("capped")
else: print(len(digests)+1)
' "$HERMES_PR_KANBAN_WORK_ROOT" "$1" "$2" "$3" 2>/dev/null
}

maintenance_request() {
  PYTHONPATH="$(dirname "$HERMES_PR_KANBAN_ENQUEUE")" "$HERMES_PYTHON" -B -c '
import json,os,re,stat,sys
from hermes_direct_pr_journal import identity
root,operation,repo,number,feedback=sys.argv[1:]; number=int(number); uid=os.geteuid()
def directory(descriptor):
 i=os.fstat(descriptor)
 if not stat.S_ISDIR(i.st_mode) or i.st_uid!=uid or stat.S_IMODE(i.st_mode)!=0o700: raise SystemExit(1)
if not re.fullmatch(r"pr-maintain-[0-9a-f]{64}",operation): raise SystemExit(1)
root_fd=os.open(root,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
try:
 directory(root_fd); operation_fd=os.open(operation,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=root_fd)
 try:
  directory(operation_fd); request_fd=os.open("request.json",os.O_RDONLY|os.O_NOFOLLOW,dir_fd=operation_fd)
  with os.fdopen(request_fd,"rb") as stream:
   i=os.fstat(request_fd)
   if not stat.S_ISREG(i.st_mode) or i.st_uid!=uid or i.st_nlink!=1 or stat.S_IMODE(i.st_mode)!=0o440: raise SystemExit(1)
   raw=stream.read(16385)
 finally: os.close(operation_fd)
finally: os.close(root_fd)
if len(raw)>16384: raise SystemExit(1)
value=json.loads(raw); canonical=json.dumps(value,sort_keys=True,separators=(",",":"),ensure_ascii=False,allow_nan=False).encode()
if raw!=canonical or set(value)!={"operation_id","repo","number","url","title","head_sha","feedback_digest","round"}: raise SystemExit(1)
expected=identity("pr-maintain",value["repo"],value["number"],value["head_sha"],value["feedback_digest"])["operation_id"]
if value["operation_id"]!=operation or expected!=operation or value["repo"].lower()!=repo.lower() or value["number"]!=number or value["feedback_digest"]!=feedback: raise SystemExit(1)
request_repo=value["repo"]
if value["url"]!=f"https://github.com/{request_repo}/pull/{number}" or not isinstance(value["title"],str) or not 0<len(value["title"])<=256 or type(value["round"]) is not int or value["round"] not in range(1,4): raise SystemExit(1)
sys.stdout.buffer.write(raw)
' "$HERMES_PR_KANBAN_WORK_ROOT" "$1" "$2" "$3" "$4" 2>/dev/null
}

# Load the granted-repo allowlist once. Empty grant = nothing to do (not an error).
mapfile -t GRANTED < <(python3 "$AUTHORITY_BIN" --file "$AUTHORITY" 2>/dev/null | jq -r '.repos[]?' || true)
if (( ${#GRANTED[@]} == 0 )); then log "no repos granted in $AUTHORITY; nothing to discover"; exit 0; fi
repo_granted() { local r="$1"; local g; for g in "${GRANTED[@]}"; do [[ "$g" == "$r" || "$g" == "${r%%/*}/*" ]] && return 0; done; return 1; }

log "discovering PRs ($GH_FILTER @me) across ${#GRANTED[@]} granted repo(s)"
gh_status=0
prs="$("$TIMEOUT_BIN" --kill-after=5s "${GH_TIMEOUT_SECONDS}s" \
  gh search prs "$GH_FILTER" @me --state open \
    --json number,title,url,repository,updatedAt --limit 1000 \
    --jq '.[] | [.repository.nameWithOwner, (.number|tostring), .url, .title, (.updatedAt|fromdateiso8601|tostring)] | @tsv' \
  2>/dev/null)" || gh_status=$?
if (( gh_status != 0 )); then log "WARN: gh search failed (exit $gh_status); enqueued nothing"; exit 3; fi
if [[ -z "$prs" ]]; then log "no matching open PRs"; exit 0; fi

DISCOVERY_TMP=""; login=""; login_attempted=0; login_ok=0
if [[ "$QUEUE_ENGINE" == kanban && "$KIND" == pr-maintain ]]; then
  DISCOVERY_TMP="$(mktemp -d "${TMPDIR:-/tmp}/hermes-pr-producer.XXXXXX")"
  trap 'rm -rf "$DISCOVERY_TMP"' EXIT
fi
now_epoch="$(date +%s)"; cutoff=$(( now_epoch - (MAX_UPDATED_AGE_DAYS * 86400) ))
enq=0 dedupe=0 skip=0 failed=0
while IFS=$'\t' read -r repo number url title updated_epoch; do
  [[ -z "$repo" ]] && continue
  if ! repo_granted "$repo"; then skip=$((skip+1)); continue; fi
  if (( MAX_UPDATED_AGE_DAYS > 0 )) && [[ "$updated_epoch" =~ ^[0-9]+$ ]] && (( updated_epoch < cutoff )); then
    skip=$((skip+1)); continue
  fi
  sha="$("$TIMEOUT_BIN" --kill-after=5s "${GH_TIMEOUT_SECONDS}s" gh pr view "$number" -R "$repo" --json headRefOid --jq .headRefOid 2>/dev/null || true)"
  if [[ -z "$sha" ]]; then log "skip $repo#$number: could not resolve head sha"; skip=$((skip+1)); continue; fi
  if [[ "$QUEUE_ENGINE" == kanban ]]; then
    feedback=""; round=""
    if [[ "$KIND" == pr-maintain ]]; then
      if (( login_attempted == 0 )); then
        login_attempted=1
        if login="$(gh_read api user --jq .login 2>/dev/null)" && [[ -n "$login" ]]; then login_ok=1; fi
      fi
      if (( login_ok == 0 )); then
        failed=$((failed+1)); log "feedback API failed for $repo#$number@$sha"; continue
      fi
      if ! feedback="$(feedback_snapshot "$repo" "$number" "$login")"; then
        failed=$((failed+1)); log "feedback API failed for $repo#$number@$sha"; continue
      fi
      if [[ "$feedback" == empty ]]; then skip=$((skip+1)); log "skip $repo#$number@$sha: no actionable feedback"; continue; fi
      if ! round="$(maintenance_round "$repo" "$number" "$feedback")"; then
        failed=$((failed+1)); log "maintenance history failed for $repo#$number@$sha"; continue
      fi
      if [[ "$round" == duplicate:* ]]; then
        operation="${round#duplicate:}"
        if payload="$(maintenance_request "$operation" "$repo" "$number" "$feedback")" && direct_enqueue "$KIND" "$payload"; then
          enq=$((enq+1)); log "reconciled $KIND $repo#$number via $operation"
        else
          failed=$((failed+1)); log "kanban reconcile failed for $repo#$number via $operation"
        fi
        continue
      fi
      if [[ "$round" == capped ]]; then skip=$((skip+1)); log "skip $repo#$number@$sha: maintenance round cap reached"; continue; fi
    fi
    if payload="$(PYTHONPATH="$(dirname "$HERMES_PR_KANBAN_ENQUEUE")" "$HERMES_PYTHON" -B -c \
      'import json,sys; from hermes_direct_pr_journal import identity; kind,repo,number,title,head,feedback,round_number=sys.argv[1:]; number=int(number); operation=identity(kind,repo,number,head,feedback_digest=feedback or None)["operation_id"]; value={"operation_id":operation,"repo":repo,"number":number,"url":f"https://github.com/{repo}/pull/{number}","title":title,"head_sha":head}; value.update({"feedback_digest":feedback,"round":int(round_number)}) if kind=="pr-maintain" else None; print(json.dumps(value,sort_keys=True,separators=(",",":"),ensure_ascii=False,allow_nan=False))' \
      "$KIND" "$repo" "$number" "$title" "$sha" "$feedback" "$round" 2>/dev/null)" && direct_enqueue "$KIND" "$payload"; then
      enq=$((enq+1)); log "admitted $KIND $repo#$number@$sha"
    else
      failed=$((failed+1)); log "kanban enqueue failed for $repo#$number@$sha"
    fi
    continue
  fi
  payload="$(jq -cn --arg repo "$repo" --arg pr "$number" --arg url "$url" --arg title "$title" \
    '{repo:$repo, number:($pr|tonumber), url:$url, title:$title}')"
  dedupe_key="${repo}#${number}@${sha}"
  # psql -c does NOT interpolate :'var'; feed the SQL via stdin so :'var' substitution applies.
  # A NULL return (dedupe/cap skip) prints empty; a numeric id means a row was inserted.
  inserted="$(psqlq -v payload="$payload" -v dk="$dedupe_key" -v kind="$KIND" \
    <<<"SELECT hermes_enqueue_request(:'kind', :'payload'::jsonb, :'dk');" 2>/dev/null || true)"
  if [[ "$inserted" =~ ^[0-9]+$ ]]; then enq=$((enq+1)); log "enqueued $KIND $dedupe_key (#$inserted)"; else dedupe=$((dedupe+1)); fi
done <<< "$prs"

if [[ "$QUEUE_ENGINE" == kanban ]]; then
  log "done: admitted=$enq failed=$failed skipped=$skip"
  (( failed == 0 )) || exit 1
else
  log "done: enqueued=$enq deduped=$dedupe skipped=$skip"
fi
