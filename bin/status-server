#!/usr/bin/env python3
"""Status and human-review web view for the agent fleet (M3 read + M4 writes).

Serves one auto-refreshing HTML page over the request Postgres. Writes are a SMALL whitelisted set:
cancel a queued row, force-inject a PR, update local human-review work, or retain an approved stored
decision to configured Hindsight shared memory — never f-string SQL or GitHub actions. All dynamic values
are HTML-escaped (request data is attacker-influenced).

Binds 127.0.0.1 in-code (not just compose). No auth by design (localhost single-user); writes are
CSRF-guarded (POST + custom header + Origin + Host + per-render token). Config from env:
REQUESTS_DB_HOST/PORT/USER/NAME + PGPASSWORD; PR_PRODUCER_ORGS/REPOSITORIES/ALLOW_ALL_REPOS reuse the
producer's repo allowlist so inject cannot target an out-of-scope repo; HINDSIGHT_URL configures
memory promotion to fleet-shared.
"""
import html
import json
import os
import re
import secrets
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, quote
from urllib.request import Request, urlopen

DB = {
    "host": os.environ.get("REQUESTS_DB_HOST", "db-requests"),
    "port": os.environ.get("REQUESTS_DB_PORT", "5432"),
    "user": os.environ.get("REQUESTS_DB_USER", "fleet"),
    "name": os.environ.get("REQUESTS_DB_NAME", "fleet"),
}
PORT = int(os.environ.get("STATUS_PORT", "8080"))
REFRESH_SECONDS = int(os.environ.get("STATUS_REFRESH_SECONDS", "5"))
HINDSIGHT_URL = os.environ.get("HINDSIGHT_URL", "http://hindsight:8888").rstrip("/")
HINDSIGHT_SHARED_BANK = "fleet-shared"
PUBLISH_LOCK = threading.Lock()
# Reuse the producer's repo-scope semantics so inject cannot target out-of-scope repos.
ALLOWED_REPOS = set(filter(None, os.environ.get("PR_PRODUCER_REPOSITORIES", "").split(",")))
ALLOWED_ORGS = set(filter(None, os.environ.get("PR_PRODUCER_ORGS", "").split(",")))
ALLOW_ALL_REPOS = os.environ.get("PR_PRODUCER_ALLOW_ALL_REPOS", "false") == "true"
KINDS = {"pr-review", "pr-maintain"}
CSRF_TOKEN = secrets.token_urlsafe(32)          # per-process; page embeds it, POST must echo it
ALLOWED_HOSTS = {f"127.0.0.1:{PORT}", f"localhost:{PORT}"}
ALLOWED_ORIGINS = {f"http://127.0.0.1:{PORT}", f"http://localhost:{PORT}"}


def repo_allowed(repo: str) -> bool:
    if ALLOW_ALL_REPOS:
        return True
    org = repo.split("/", 1)[0]
    return repo in ALLOWED_REPOS or org in ALLOWED_ORGS


def _psql(args: list[str], sql: str) -> subprocess.CompletedProcess:
    # SQL goes on STDIN, not -c: psql only interpolates :'var' in stdin/-f mode, NOT in -c strings.
    return subprocess.run(
        ["psql", "-h", DB["host"], "-p", DB["port"], "-U", DB["user"], "-d", DB["name"],
         "-qAt", "-v", "ON_ERROR_STOP=1", *args],
        input=sql, capture_output=True, text=True, timeout=15,
    )


def query(sql: str) -> list[list[str]]:
    """Run a SELECT via psql and return rows as lists of strings. Read-only by construction:
    callers pass fixed SELECT-only SQL; this helper never interpolates request data.
    Wraps the query in json_agg so multi-line/odd-byte cell values (e.g. a fail_response with
    embedded newlines) can't break row/column parsing — we parse one JSON doc, not split lines."""
    wrapped = f"SELECT coalesce(json_agg(t.*), '[]') FROM ({sql}) t"
    proc = _psql([], wrapped)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "psql failed")
    rows = []
    for obj in json.loads(proc.stdout or "[]"):
        # json_agg(t.*) yields objects keyed by column/alias, insertion-ordered to match SELECT.
        rows.append(["" if v is None else str(v) for v in obj.values()])
    return rows


# --- M4 writes: parameterized (psql -v), whitelisted, scoped. Never f-string interpolation. ---
def cancel_queued(req_id: int) -> str:
    """Delete a QUEUED row (zero side effects taken). Guarded by status='queued' so a row that
    started running between render and click is untouched. Returns a human result string."""
    proc = _psql(["-v", f"id={req_id}"],
                 "DELETE FROM requests WHERE id=:'id'::bigint AND status='queued' RETURNING id")
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "delete failed")
    if proc.stdout.strip():
        return f"cancelled queued #{req_id}"
    return f"#{req_id} not cancelled (already running or gone)"


def inject(repo: str, pr: str, kind: str) -> str:
    """Force-enqueue repo#pr even if a done/failed row exists. Scoped + validated. Distinct
    dedupe_key (@manual-<epoch>) so the partial unique index never blocks it; worker resolves the
    real head at run time."""
    if kind not in KINDS:
        raise ValueError("bad kind")
    if not re.fullmatch(r"[A-Za-z0-9._-]+/[A-Za-z0-9._-]+", repo) or not repo_allowed(repo):
        raise ValueError("repo not in allowlist")
    if not re.fullmatch(r"[1-9][0-9]*", pr):
        raise ValueError("pr must be a positive integer")
    payload = json.dumps({"repo": repo, "pr": pr,
                          "url": f"https://github.com/{repo}/pull/{pr}", "title": "manual inject"})
    dk = f"{repo}#{pr}@manual-{int(time.time())}"
    proc = _psql(["-v", f"kind={kind}", "-v", f"payload={payload}", "-v", f"dk={dk}"],
                 "INSERT INTO requests(kind,payload,dedupe_key) "
                 "VALUES (:'kind', :'payload'::jsonb, :'dk')")
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "insert failed")
    return f"injected {kind} {repo}#{pr}"


def update_human_review_state(review_id: int, state: str) -> str:
    """Mark one local maintenance-review item reviewed or dismissed."""
    if state not in ("reviewed", "dismissed"):
        raise ValueError("bad review state")
    proc = _psql(["-v", f"id={review_id}", "-v", f"state={state}"],
                 "UPDATE pending_maintenance_reviews SET state = :'state', reviewed_at = now() "
                 "WHERE id = :'id'::bigint AND state = 'pending' RETURNING id")
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "human-review update failed")
    return f"{state} human-review #{review_id}" if proc.stdout.strip() else f"#{review_id} not pending"


def _decision_from_psql(proc: subprocess.CompletedProcess) -> dict | None:
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "pending-decision update failed")
    return json.loads(proc.stdout) if proc.stdout.strip() else None


def claim_pending_decision(decision_id: int) -> dict | None:
    proc = _psql(["-v", f"id={decision_id}"],
                 "UPDATE pending_decisions SET state = 'publishing', publish_started_at = now(), "
                 "publish_error = NULL WHERE id = :'id'::bigint AND state = 'pending' "
                 "RETURNING json_build_object('id', id, 'request_id', request_id, 'kind', kind, "
                 "'proposal', proposal, 'provenance', provenance)::text")
    return _decision_from_psql(proc)


def retry_publishing_decision(decision_id: int) -> dict | None:
    proc = _psql(["-v", f"id={decision_id}"],
                 "SELECT json_build_object('id', id, 'request_id', request_id, 'kind', kind, "
                 "'proposal', proposal, 'provenance', provenance)::text FROM pending_decisions "
                 "WHERE id = :'id'::bigint AND state = 'publishing'")
    return _decision_from_psql(proc)


def reject_pending_decision(decision_id: int) -> str:
    proc = _psql(["-v", f"id={decision_id}"],
                 "UPDATE pending_decisions SET state = 'rejected', decided_at = now() "
                 "WHERE id = :'id'::bigint AND state = 'pending' RETURNING id")
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "pending-decision update failed")
    return f"rejected pending-decision #{decision_id}" if proc.stdout.strip() else f"#{decision_id} not pending"


def _mark_decision_publish_error(decision_id: int, error: str) -> None:
    proc = _psql(["-v", f"id={decision_id}", "-v", f"error={error}"],
                 "UPDATE pending_decisions SET publish_error = :'error' "
                 "WHERE id = :'id'::bigint AND state = 'publishing'")
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "pending-decision error update failed")


def _retain_decision(decision: dict) -> None:
    decision_id = int(decision["id"])
    content = json.dumps({"pending_decision_id": decision_id, "proposal": decision["proposal"],
                          "provenance": decision["provenance"]}, sort_keys=True, separators=(",", ":"))
    payload = json.dumps({
        "async": False,
        "items": [{
            "content": content,
            "document_id": f"pending-decision-{decision_id}",
            "metadata": {"pending_decision_id": str(decision_id),
                         "request_id": str(decision["request_id"]), "kind": str(decision["kind"])},
            "tags": ["human-approved", "pending-decision"],
            "update_mode": "replace",
        }],
    }).encode()
    request = Request(f"{HINDSIGHT_URL}/v1/default/banks/{quote(HINDSIGHT_SHARED_BANK, safe='')}/memories",
                      data=payload, headers={"content-type": "application/json"}, method="POST")
    response = urlopen(request, timeout=60)
    try:
        result = json.loads(response.read())
    finally:
        response.close()
    if not (isinstance(result, dict) and result.get("success") is True and result.get("async") is False
            and result.get("bank_id") == HINDSIGHT_SHARED_BANK and result.get("items_count") == 1):
        raise RuntimeError("unexpected Hindsight retain response")


def _publish_decision(decision: dict) -> str:
    decision_id = int(decision["id"])
    try:
        _retain_decision(decision)
        proc = _psql(["-v", f"id={decision_id}"],
                     "UPDATE pending_decisions SET state = 'approved', decided_at = now(), publish_error = NULL "
                     "WHERE id = :'id'::bigint AND state = 'publishing' RETURNING id")
        if proc.returncode != 0:
            raise RuntimeError(proc.stderr.strip() or "pending-decision approval update failed")
        if not proc.stdout.strip():
            raise RuntimeError("pending-decision no longer publishing")
    except Exception as ex:
        _mark_decision_publish_error(decision_id, f"publish failed ({type(ex).__name__})")
        return f"publish failed; retry pending-decision #{decision_id}"
    return f"approved pending-decision #{decision_id}"


def approve_pending_decision(decision_id: int) -> str:
    with PUBLISH_LOCK:
        decision = claim_pending_decision(decision_id)
        return _publish_decision(decision) if decision else f"#{decision_id} not pending"


def retry_pending_decision(decision_id: int) -> str:
    with PUBLISH_LOCK:
        decision = retry_publishing_decision(decision_id)
        return _publish_decision(decision) if decision else f"#{decision_id} not publishing"


def e(v) -> str:
    """HTML-escape a value. ALL dynamic data goes through here (attacker-influenced)."""
    return html.escape("" if v is None else str(v))


def github_pr_link(url: str) -> str:
    if not re.fullmatch(r"https://github\.com/[^/]+/[^/]+/pull/\d+", url):
        return e(url)
    return f'<a href="{html.escape(url, quote=True)}" target="_blank" rel="noopener">Open PR</a>'


def findings_html(raw: str) -> str:
    try:
        findings = json.loads(raw)
    except (TypeError, json.JSONDecodeError):
        return e(raw)
    if not findings:
        return "—"
    if not isinstance(findings, list):
        return e(raw)
    items = []
    for finding in findings:
        if not isinstance(finding, dict):
            items.append(f"<li>{e(finding)}</li>")
            continue
        location = str(finding.get("file", ""))
        if finding.get("line") is not None:
            location += f":{finding['line']}"
        severity = finding.get("severity")
        prefix = " — ".join(part for part in (str(severity) if severity is not None else "", location) if part)
        text = str(finding.get("text", ""))
        items.append(f"<li><strong>{e(prefix)}</strong>{': ' if prefix and text else ''}{e(text)}</li>")
    return "<ul>" + "".join(items) + "</ul>"


def human_review_table(rows: list[list[str]]) -> str:
    if not rows:
        return "<section><h2>Human review queue (0)</h2><p class=empty>nothing needs review</p></section>"
    body = ""
    for review_id, request_id, url, summary, findings, created, rtype in rows:
        type_chip = ('<span class="chip s-done">review-ready</span>' if rtype == "review-ready"
                     else '<span class="chip s-queued">maintenance</span>')
        body += ("<tr>"
                 f"<td>{e(review_id)}</td><td>{type_chip}</td><td>{github_pr_link(url)}</td>"
                 f"<td>{e(summary).replace(chr(10), '<br>')}</td><td>{findings_html(findings)}</td>"
                 f"<td>{e(created)}</td>"
                 f"<td><form class=inline method=post action=\"/human-reviews/{e(review_id)}/reviewed\">"
                 f"<input type=hidden name=token value=\"{e(CSRF_TOKEN)}\"><button>Reviewed</button></form>"
                 f"<form class=inline method=post action=\"/human-reviews/{e(review_id)}/dismissed\">"
                 f"<input type=hidden name=token value=\"{e(CSRF_TOKEN)}\"><button>Dismiss</button></form></td>"
                 "</tr>")
    return ("<section><h2>Human review queue (" + str(len(rows)) + ")</h2>"
            "<p class=hint>Agent-flagged work: <b>review-ready</b> PRs the agent judged done (your call to "
            "approve+merge on GitHub), and <b>maintenance</b> work it left for a human. Reviewed/Dismiss "
            "only update this local queue; they never write to GitHub.</p>"
            "<table><thead><tr><th>id</th><th>type</th><th>PR</th><th>agent summary</th>"
            "<th>findings</th><th>created</th><th>queue</th></tr></thead><tbody>" + body + "</tbody></table></section>")


def json_html(raw: str) -> str:
    try:
        return f"<pre>{e(json.dumps(json.loads(raw), indent=2, sort_keys=True))}</pre>"
    except (TypeError, json.JSONDecodeError):
        return f"<pre>{e(raw)}</pre>"


def pending_decision_table(rows: list[list[str]]) -> str:
    if not rows:
        return "<section><h2>Pending decisions (0)</h2><p class=empty>no pending decisions</p></section>"
    body = ""
    for decision_id, request_id, kind, url, proposal, provenance, state, created, started, publish_error in rows:
        try:
            proposal_data = json.loads(proposal)
        except (TypeError, json.JSONDecodeError):
            proposal_data = {}
        summary = proposal_data.get("summary", "") if isinstance(proposal_data, dict) else ""
        decisions = proposal_data.get("decisions", []) if isinstance(proposal_data, dict) else []
        findings = proposal_data.get("findings", []) if isinstance(proposal_data, dict) else []
        if state == "pending":
            actions = (f'<form class=inline method=post action="/pending-decisions/{e(decision_id)}/approve">'
                       f'<input type=hidden name=token value="{e(CSRF_TOKEN)}"><button>Approve</button></form>'
                       f'<form class=inline method=post action="/pending-decisions/{e(decision_id)}/reject">'
                       f'<input type=hidden name=token value="{e(CSRF_TOKEN)}"><button>Reject</button></form>')
        else:
            actions = (f'<form class=inline method=post action="/pending-decisions/{e(decision_id)}/retry">'
                       f'<input type=hidden name=token value="{e(CSRF_TOKEN)}"><button>Retry</button></form>')
        status = e(state) + (f"<br><span class=err>{e(publish_error)}</span>" if publish_error else "")
        body += ("<tr>"
                 f"<td>{e(decision_id)}</td><td>{github_pr_link(url)}</td><td>{e(kind)}</td>"
                 f"<td>{e(summary).replace(chr(10), '<br>')}<details><summary>proposal</summary>{json_html(proposal)}</details></td>"
                 f"<td>{json_html(json.dumps(decisions))}</td><td>{findings_html(json.dumps(findings))}</td>"
                 f"<td>{json_html(provenance)}</td><td>{status}<br>{e(started or created)}</td><td>{actions}</td></tr>")
    return (f"<section><h2>Pending decisions ({len(rows)})</h2>"
            "<p class=hint>Approve retains stored proposal and provenance to shared memory. Publishing items retry "
            "with the same document ID; reject only changes this local queue.</p>"
            "<table><thead><tr><th>id</th><th>source PR</th><th>kind</th><th>summary / proposal</th>"
            "<th>decisions</th><th>findings</th><th>provenance</th><th>state</th><th>decision</th>"
            "</tr></thead><tbody>" + body + "</tbody></table></section>")


def table(title: str, headers: list[str], rows: list[list[str]], empty: str) -> str:
    if not rows:
        return f"<section><h2>{e(title)}</h2><p class=empty>{e(empty)}</p></section>"
    head = "".join(f"<th>{e(h)}</th>" for h in headers)
    body = "".join(
        "<tr>" + "".join(f"<td>{e(c)}</td>" for c in r) + "</tr>" for r in rows
    )
    return (f"<section><h2>{e(title)}</h2>"
            f"<table><thead><tr>{head}</tr></thead><tbody>{body}</tbody></table></section>")


def render(flash: str = "") -> str:
    try:
        running = query(
            "SELECT id, kind, dedupe_key, "
            "to_char(now()-started_at,'HH24:MI:SS') AS elapsed "
            "FROM requests WHERE status='running' ORDER BY started_at")
        # Detailed queued list (id shown) so each row gets a cancel button.
        queued = query(
            "SELECT id, kind, dedupe_key, to_char(created_at,'MM-DD HH24:MI') AS queued_at "
            "FROM requests WHERE status='queued' ORDER BY id")
        recent = query(
            "SELECT id, kind, status, dedupe_key, coalesce(fail_response,''), "
            "to_char(finished_at,'MM-DD HH24:MI') "
            "FROM requests WHERE status IN ('done','failed') "
            "ORDER BY finished_at DESC NULLS LAST LIMIT 20")
        human_review = query(
            "SELECT d.id AS id, d.request_id AS request_id, "
            "coalesce(r.payload->>'url','') AS url, coalesce(d.proposal->>'summary','') AS summary, "
            "coalesce((d.proposal->'findings')::text,'[]') AS findings, "
            "to_char(d.created_at,'MM-DD HH24:MI') AS created, "
            "CASE WHEN d.proposal->>'ready' = 'true' THEN 'review-ready' ELSE 'maintenance' END AS rtype "
            "FROM pending_maintenance_reviews d JOIN requests r ON r.id = d.request_id "
            "WHERE d.state='pending' ORDER BY d.created_at DESC")
        pending = query(
            "SELECT d.id AS id, d.request_id AS request_id, d.kind AS kind, "
            "coalesce(r.payload->>'url','') AS url, d.proposal::text AS proposal, "
            "d.provenance::text AS provenance, d.state AS state, "
            "to_char(d.created_at,'MM-DD HH24:MI') AS created, "
            "coalesce(to_char(d.publish_started_at,'MM-DD HH24:MI'),'') AS started, "
            "coalesce(d.publish_error,'') AS publish_error "
            "FROM pending_decisions d JOIN requests r ON r.id = d.request_id "
            "WHERE d.state IN ('pending','publishing') ORDER BY d.created_at DESC LIMIT 20")
        today = query(
            "SELECT kind, status, count(*) FROM requests "
            "WHERE created_at::date = now()::date GROUP BY kind, status ORDER BY kind, status")
        capped = query(
            "SELECT kind, dedupe_key, count(*) AS fails, "
            "to_char(max(finished_at),'MM-DD HH24:MI') AS last_fail "
            "FROM requests WHERE status='failed' GROUP BY kind, dedupe_key "
            "HAVING count(*) >= 3 ORDER BY max(finished_at) DESC NULLS LAST LIMIT 20")
        db_err = None
    except Exception as ex:
        running = queued = recent = human_review = pending = today = capped = []
        db_err = str(ex)

    banner = (f"<p class=err>DB unreachable: {e(db_err)}</p>" if db_err else "")
    flash_html = f"<p class=flash>{e(flash)}</p>" if flash else ""
    # Queued section: each row gets a cancel button (POST /cancel, token+method-guarded).
    if queued:
        qrows = "".join(
            "<tr>" + "".join(f"<td>{e(c)}</td>" for c in r[:4])
            + f"<td>{cancel_button(r[0])}</td></tr>" for r in queued)
        queued_html = (f"<section><h2>Queued ({len(queued)})</h2><table><thead><tr>"
                       "<th>id</th><th>kind</th><th>dedupe_key</th><th>queued</th><th></th>"
                       f"</tr></thead><tbody>{qrows}</tbody></table></section>")
    else:
        queued_html = "<section><h2>Queued</h2><p class=empty>queue empty</p></section>"

    return f"""<!doctype html><html><head><meta charset=utf-8>
<meta http-equiv=refresh content={REFRESH_SECONDS}>
<title>agent-fleet status</title>
<style>
 :root{{--bg:#0f1117;--card:#181b24;--fg:#e6e8ee;--mut:#8b90a0;--line:#262a36;--acc:#e6197f}}
 *{{box-sizing:border-box}}
 body{{font:14px/1.55 -apple-system,BlinkMacSystemFont,system-ui,sans-serif;margin:0;padding:2rem;
   color:var(--fg);background:var(--bg)}}
 h1{{font-size:1.25rem;margin:0 0 .25rem;display:flex;align-items:center;gap:.5rem}}
 h2{{font-size:.95rem;margin:0 0 .6rem;color:var(--fg)}}
 .sub{{color:var(--mut);font-size:.8rem;font-weight:400}}
 section{{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:1rem 1.1rem;margin:1rem 0}}
 table{{border-collapse:collapse;width:100%}}
 th,td{{text-align:left;padding:.35rem .6rem;border-bottom:1px solid var(--line);font-variant-numeric:tabular-nums;vertical-align:top}}
 th{{color:var(--mut);font-weight:600;font-size:.78rem;text-transform:uppercase;letter-spacing:.03em}}
 tr:last-child td{{border-bottom:none}}
 td{{max-width:60ch;overflow-wrap:anywhere;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.85rem}}
 pre{{white-space:pre-wrap;margin:.4rem 0;font:inherit}}
 details summary{{cursor:pointer;color:var(--mut)}}
 .empty{{color:var(--mut)}} .hint{{color:var(--mut)}} .err{{color:#ff6b6b;font-weight:600}}
 .flash{{color:#111;background:#7ee787;border-radius:6px;padding:.4rem .7rem;font-weight:600}}
 .chip{{display:inline-block;padding:.05rem .5rem;border-radius:999px;font-size:.75rem;font-weight:600;font-family:system-ui}}
 .s-queued{{background:#2b2f3a;color:#c8ccd8}} .s-running{{background:#12324f;color:#5ab0ff}}
 .s-done{{background:#123a22;color:#7ee787}} .s-failed{{background:#3a1620;color:#ff8095}}
 button{{font:inherit;font-size:.8rem;background:#3a1620;color:#ff8095;border:1px solid #5a2230;
   border-radius:6px;padding:.15rem .6rem;cursor:pointer}}
 button:hover{{background:#5a2230}}
 form.inline{{display:inline}}
 .toolbar{{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center}}
 .toolbar input,.toolbar select{{font:inherit;background:var(--bg);color:var(--fg);border:1px solid var(--line);border-radius:6px;padding:.3rem .5rem}}
 .toolbar button{{background:#12324f;color:#5ab0ff;border-color:#1d4a72}}
 .toolbar button:hover{{background:#1d4a72}}
</style></head><body>
<h1><span style="color:var(--acc)">◉</span> agent-fleet <span class=sub>refreshes {REFRESH_SECONDS}s</span></h1>
{banner}{flash_html}
<section><h2>Force-inject a PR <span class=sub>re-run even if already done</span></h2>
<form class=toolbar method=post action=/inject onsubmit="return confirm('Inject this PR into the queue?')">
<input type=hidden name=token value="{e(CSRF_TOKEN)}">
<select name=kind><option value=pr-review>pr-review</option><option value=pr-maintain>pr-maintain</option></select>
<input name=repo placeholder="ORG/repo" size=24 required>
<input name=pr placeholder="PR #" size=6 required pattern="[1-9][0-9]*">
<button type=submit>inject</button>
</form></section>
{table("Running now", ["id","kind","dedupe_key","elapsed"], running, "nothing running")}
{queued_html}
{human_review_table(human_review)}
{pending_decision_table(pending)}
{recent_table(recent)}
{table(f"Capped — stopped retrying ({len(capped)})", ["kind","dedupe_key","fails","last_fail"], capped, "none capped")}
{table("Today by kind", ["kind","status","count"], today, "nothing today")}
</body></html>"""


def chip(status: str) -> str:
    s = status if status in ("queued", "running", "done", "failed") else "queued"
    return f'<span class="chip s-{s}">{e(status)}</span>'


def cancel_button(req_id) -> str:
    return (f'<form class=inline method=post action=/cancel '
            f'onsubmit="return confirm(\'Cancel queued #{e(req_id)}?\')">'
            f'<input type=hidden name=token value="{e(CSRF_TOKEN)}">'
            f'<input type=hidden name=id value="{e(req_id)}">'
            f'<button type=submit>cancel</button></form>')


def recent_table(rows) -> str:
    if not rows:
        return "<section><h2>Recent (last 20)</h2><p class=empty>no completed runs</p></section>"
    body = "".join(
        "<tr>" + f"<td>{e(r[0])}</td><td>{e(r[1])}</td><td>{chip(r[2])}</td>"
        + f"<td>{e(r[3])}</td><td>{e(r[4])}</td><td>{e(r[5])}</td></tr>" for r in rows)
    return ("<section><h2>Recent (last 20)</h2><table><thead><tr>"
            "<th>id</th><th>kind</th><th>status</th><th>dedupe_key</th><th>fail_response</th><th>finished</th>"
            f"</tr></thead><tbody>{body}</tbody></table></section>")


class Handler(BaseHTTPRequestHandler):
    # Cache the rendered page for the refresh window so a burst of concurrent GETs (tab storm,
    # aggressive refresh) shares ONE DB pass instead of each thread forking 5 psql procs.
    _lock = threading.Lock()
    _cache = None
    _cache_ts = 0.0

    @classmethod
    def cached_page(cls) -> bytes:
        now = time.monotonic()
        with cls._lock:
            if cls._cache is None or (now - cls._cache_ts) >= REFRESH_SECONDS:
                cls._cache = render().encode()
                cls._cache_ts = now
            return cls._cache

    def do_GET(self):
        if self.path not in ("/", "/index.html"):
            self.send_response(404); self.end_headers(); return
        try:
            page = self.cached_page()
        except Exception as ex:
            self.send_response(500); self.end_headers()
            self.wfile.write(f"error: {ex}".encode()); return
        self.send_response(200)
        self.send_header("content-type", "text/html; charset=utf-8")
        self.send_header("content-length", str(len(page)))
        self.end_headers()
        self.wfile.write(page)

    # --- writes (M4). CSRF-guarded: Host + Origin allowlist + per-process token. No auth by design
    # (localhost single-user). GET never mutates; only these two POST actions do. ---
    def _csrf_ok(self, params) -> bool:
        host = self.headers.get("Host", "")
        if host not in ALLOWED_HOSTS:
            return False
        origin = self.headers.get("Origin")
        if origin is not None and origin not in ALLOWED_ORIGINS:
            return False
        return secrets.compare_digest(params.get("token", [""])[0], CSRF_TOKEN)

    def _redirect(self, flash: str):
        # Re-render fresh (bypass cache) with a flash message, invalidate the GET cache.
        with Handler._lock:
            Handler._cache = None
        page = render(flash=flash).encode()
        self.send_response(200)
        self.send_header("content-type", "text/html; charset=utf-8")
        self.send_header("content-length", str(len(page)))
        self.end_headers(); self.wfile.write(page)

    def do_POST(self):
        length = int(self.headers.get("Content-Length", "0") or "0")
        body = self.rfile.read(length).decode("utf-8", "replace") if length else ""
        params = parse_qs(body)
        if not self._csrf_ok(params):
            self.send_response(403); self.end_headers()
            self.wfile.write(b"forbidden (csrf)"); return
        try:
            if self.path == "/cancel":
                rid = int(params.get("id", [""])[0])
                result = cancel_queued(rid)
            elif self.path == "/inject":
                result = inject(params.get("repo", [""])[0].strip(),
                                params.get("pr", [""])[0].strip(),
                                params.get("kind", [""])[0].strip())
            else:
                review_match = re.fullmatch(r"/human-reviews/(\d+)/(reviewed|dismissed)", self.path)
                decision_match = re.fullmatch(r"/pending-decisions/(\d+)/(approve|retry|reject)", self.path)
                if review_match:
                    result = update_human_review_state(int(review_match.group(1)), review_match.group(2))
                elif decision_match:
                    decision_id, action = int(decision_match.group(1)), decision_match.group(2)
                    if action == "approve":
                        result = approve_pending_decision(decision_id)
                    elif action == "retry":
                        result = retry_pending_decision(decision_id)
                    else:
                        result = reject_pending_decision(decision_id)
                else:
                    self.send_response(404); self.end_headers(); return
        except (ValueError, RuntimeError) as ex:
            result = f"rejected: {ex}"
        # Audit trail (single line, stderr) — mutating a work queue should not be silent.
        print(f"WRITE {self.path} {result}", flush=True)
        self._redirect(result)

    def log_message(self, *a):  # quiet
        pass


if __name__ == "__main__":
    # Compose explicitly sets 0.0.0.0 so its localhost-only port-map can reach this process.
    # Direct runs default to loopback; Host/Origin/CSRF provide defense in depth for POSTs.
    ThreadingHTTPServer((os.environ.get("STATUS_BIND", "127.0.0.1"), PORT), Handler).serve_forever()
