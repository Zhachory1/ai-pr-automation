#!/usr/bin/env python3
"""Status and human-review web view for the agent fleet (M3 read + M4 writes).

Serves one auto-refreshing HTML page over the request Postgres. Writes are a SMALL whitelisted set:
cancel a queued row, force-inject a PR, update local human-review work, or retain an approved stored
decision to configured Hindsight shared memory — never f-string SQL or GitHub actions. All dynamic values
are HTML-escaped (request data is attacker-influenced).

Binds 127.0.0.1 in-code (not just compose). No auth by design (localhost single-user); writes are
CSRF-guarded (POST + custom header + Origin + Host + per-render token). Config from env:
REQUESTS_DB_HOST/PORT/USER/NAME + PGPASSWORD; PR_PRODUCER_ORGS/REPOSITORIES/ALLOW_ALL_REPOS reuse the
producer's repo allowlist so inject cannot target an out-of-scope repo; HINDSIGHT_URL configures
memory promotion to fleet-shared.
"""
import html
import json
import os
import re
import secrets
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, quote
from urllib.request import Request, urlopen

DB = {
    "host": os.environ.get("REQUESTS_DB_HOST", "db-requests"),
    "port": os.environ.get("REQUESTS_DB_PORT", "5432"),
    "user": os.environ.get("REQUESTS_DB_USER", "fleet"),
    "name": os.environ.get("REQUESTS_DB_NAME", "fleet"),
}
PORT = int(os.environ.get("STATUS_PORT", "8080"))
REFRESH_SECONDS = int(os.environ.get("STATUS_REFRESH_SECONDS", "15"))
# Client-side behavior: (1) poll /fragment and swap only #live instead of a full-page reload, and
# (2) intercept button/form POSTs so a click submits via fetch and refreshes #live in place — no page
# reload, no scroll-to-top, no wiped input. Skip the poll swap while the user is interacting.
LIVE_JS = (
    "(function(){"
    "var ms=%d*1000;"
    "function busy(){"
    "var a=document.activeElement;"
    "if(a&&/^(INPUT|SELECT|TEXTAREA|BUTTON)$/.test(a.tagName))return true;"
    "var s=window.getSelection&&window.getSelection();"
    "if(s&&String(s).length)return true;"
    "return false;}"
    "function curTab(){return (location.hash.replace('#tab-','')||'review');}"
    "function applyTab(){var t=curTab();"
    "document.querySelectorAll('.tabpanel').forEach(function(p){p.classList.toggle('active',p.dataset.tab===t);});"
    "document.querySelectorAll('.navlink').forEach(function(a){a.classList.toggle('active',a.dataset.tab===t);});}"
    "async function refresh(){"
    "try{var r=await fetch('/fragment',{cache:'no-store'});"
    "if(!r.ok)return;var h=await r.text();"
    "document.getElementById('live').innerHTML=h;applyTab();}catch(e){}}"
    "async function tick(){if(document.hidden||busy())return;await refresh();}"
    "setInterval(tick,ms);"
    "window.addEventListener('hashchange',applyTab);"
    "applyTab();"
    "function flash(msg,ok){var f=document.getElementById('flash');"
    "if(!f){f=document.createElement('p');f.id='flash';document.querySelector('h1').after(f);}"
    "f.textContent=msg;f.className=ok?'flash':'err';"
    "clearTimeout(f._t);f._t=setTimeout(function(){f.textContent='';f.className='';},5000);}"
    "document.addEventListener('submit',async function(ev){"
    "var form=ev.target;"
    "if(!form.matches||!form.matches('form[method=post],form[method=POST]'))return;"
    "ev.preventDefault();"
    "var oc=form.getAttribute('onsubmit');"
    "if(oc&&/confirm\\(/.test(oc)){try{if(new Function(oc).call(form)===false)return;}catch(e){}}"
    "var btns=form.querySelectorAll('button,input[type=submit]');"
    "btns.forEach(function(b){b.disabled=true;});"
    "function undo(){btns.forEach(function(b){b.disabled=false;});}"
    "try{var r=await fetch(form.action,{method:'POST',headers:{'X-Requested-With':'fetch'},"
    "body:new URLSearchParams(new FormData(form))});"
    "var d={};try{d=await r.json();}catch(e){}"
    "flash(d.flash||(r.ok?'done':'request failed'),r.ok&&d.ok!==false);"
    "if(r.ok&&d.ok!==false&&form.reset)form.reset();"
    "undo();await refresh();}"
    "catch(e){flash('request failed',false);undo();}}"
    ",true);"
    "})();"
) % REFRESH_SECONDS
HINDSIGHT_URL = os.environ.get("HINDSIGHT_URL", "http://hindsight:8888").rstrip("/")
HINDSIGHT_SHARED_BANK = "fleet-shared"
PUBLISH_LOCK = threading.Lock()
# Reuse the producer's repo-scope semantics so inject cannot target out-of-scope repos.
ALLOWED_REPOS = set(filter(None, os.environ.get("PR_PRODUCER_REPOSITORIES", "").split(",")))
ALLOWED_ORGS = set(filter(None, os.environ.get("PR_PRODUCER_ORGS", "").split(",")))
ALLOW_ALL_REPOS = os.environ.get("PR_PRODUCER_ALLOW_ALL_REPOS", "false") == "true"
KINDS = {"pr-review", "pr-maintain"}
HANDOFF_ROOT = os.environ.get("HANDOFF_ROOT", "")   # for validating swe-implement handoff submissions
CSRF_TOKEN = secrets.token_urlsafe(32)          # per-process; page embeds it, POST must echo it
ALLOWED_HOSTS = {f"127.0.0.1:{PORT}", f"localhost:{PORT}"}
ALLOWED_ORIGINS = {f"http://127.0.0.1:{PORT}", f"http://localhost:{PORT}"}


def repo_allowed(repo: str) -> bool:
    if ALLOW_ALL_REPOS:
        return True
    org = repo.split("/", 1)[0]
    return repo in ALLOWED_REPOS or org in ALLOWED_ORGS


def _psql(args: list[str], sql: str) -> subprocess.CompletedProcess:
    # SQL goes on STDIN, not -c: psql only interpolates :'var' in stdin/-f mode, NOT in -c strings.
    return subprocess.run(
        ["psql", "-h", DB["host"], "-p", DB["port"], "-U", DB["user"], "-d", DB["name"],
         "-qAt", "-v", "ON_ERROR_STOP=1", *args],
        input=sql, capture_output=True, text=True, timeout=15,
    )


def query(sql: str) -> list[list[str]]:
    """Run a SELECT via psql and return rows as lists of strings. Read-only by construction:
    callers pass fixed SELECT-only SQL; this helper never interpolates request data.
    Wraps the query in json_agg so multi-line/odd-byte cell values (e.g. a fail_response with
    embedded newlines) can't break row/column parsing — we parse one JSON doc, not split lines."""
    wrapped = f"SELECT coalesce(json_agg(t.*), '[]') FROM ({sql}) t"
    proc = _psql([], wrapped)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "psql failed")
    rows = []
    for obj in json.loads(proc.stdout or "[]"):
        # json_agg(t.*) yields objects keyed by column/alias, insertion-ordered to match SELECT.
        rows.append(["" if v is None else str(v) for v in obj.values()])
    return rows


# --- M4 writes: parameterized (psql -v), whitelisted, scoped. Never f-string interpolation. ---
def cancel_queued(req_id: int) -> str:
    """Delete a QUEUED row (zero side effects taken). Guarded by status='queued' so a row that
    started running between render and click is untouched. Returns a human result string."""
    proc = _psql(["-v", f"id={req_id}"],
                 "DELETE FROM requests WHERE id=:'id'::bigint AND status='queued' RETURNING id")
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "delete failed")
    if proc.stdout.strip():
        return f"cancelled queued #{req_id}"
    return f"#{req_id} not cancelled (already running or gone)"


def inject(repo: str, pr: str, kind: str) -> str:
    """Force-enqueue repo#pr even if a done/failed row exists. Scoped + validated. Distinct
    dedupe_key (@manual-<epoch>) so the partial unique index never blocks it; worker resolves the
    real head at run time."""
    if kind not in KINDS:
        raise ValueError("bad kind")
    if not re.fullmatch(r"[A-Za-z0-9._-]+/[A-Za-z0-9._-]+", repo) or not repo_allowed(repo):
        raise ValueError("repo not in allowlist")
    if not re.fullmatch(r"[1-9][0-9]*", pr):
        raise ValueError("pr must be a positive integer")
    payload = json.dumps({"repo": repo, "pr": pr,
                          "url": f"https://github.com/{repo}/pull/{pr}", "title": "manual inject"})
    dk = f"{repo}#{pr}@manual-{int(time.time())}"
    proc = _psql(["-v", f"kind={kind}", "-v", f"payload={payload}", "-v", f"dk={dk}"],
                 "INSERT INTO requests(kind,payload,dedupe_key) "
                 "VALUES (:'kind', :'payload'::jsonb, :'dk')")
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "insert failed")
    return f"injected {kind} {repo}#{pr}"


def _swe_enqueue(payload: dict, dedupe_key: str) -> str:
    """Enqueue a 'swe-implement' request (credential-free write; the swe-implement-server does the
    actual clone/agent/PR). Parameterized SQL; dedups on an already-active task."""
    payload_json = json.dumps(payload, separators=(",", ":"))
    proc = _psql(
        ["-v", f"payload={payload_json}", "-v", f"dk={dedupe_key}"],
        "INSERT INTO requests(kind,payload,dedupe_key) "
        "SELECT 'swe-implement', :'payload'::jsonb, :'dk' "
        "WHERE NOT EXISTS (SELECT 1 FROM requests WHERE kind='swe-implement' "
        "AND dedupe_key=:'dk' AND status IN ('queued','running')) "
        "ON CONFLICT DO NOTHING RETURNING 1")
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "insert failed")
    return "enqueued swe-implement" if proc.stdout.strip() == "1" else "already queued/running (deduped)"


DOC_TYPES = ("seprd", "mlprd", "launchpad", "dd")
DOC_WRITE_DAILY_CAP = int(os.environ.get("DOC_WRITE_DAILY_CAP", "30"))


def _slug(text: str) -> str:
    s = re.sub(r"[^a-z0-9]+", "-", (text or "").lower()).strip("-")
    return (s[:48] or "untitled")


def _doc_enqueue(payload: dict, dedupe_key: str) -> str:
    """Enqueue a 'doc-write' request. Credential-free; the doc-writer-server runs the persona. Each
    round is its own request (round in the dedupe key), so refine advances even past a done round.
    A daily cap bounds paid model spend since the UI is credential-free."""
    payload_json = json.dumps(payload, separators=(",", ":"))
    proc = _psql(
        ["-v", f"payload={payload_json}", "-v", f"dk={dedupe_key}", "-v", f"cap={DOC_WRITE_DAILY_CAP}"],
        "INSERT INTO requests(kind,payload,dedupe_key) "
        "SELECT 'doc-write', :'payload'::jsonb, :'dk' "
        "WHERE NOT EXISTS (SELECT 1 FROM requests WHERE kind='doc-write' "
        "  AND dedupe_key=:'dk' AND status IN ('queued','running')) "
        "AND (SELECT count(*) FROM requests WHERE kind='doc-write' "
        "  AND created_at::date = now()::date) < :'cap'::int "
        "ON CONFLICT DO NOTHING RETURNING 1")
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "insert failed")
    if proc.stdout.strip() == "1":
        return "enqueued doc-write"
    return f"not enqueued (already active, or daily cap {DOC_WRITE_DAILY_CAP} reached)"


def doc_write(doc_type: str, title: str, requirements: str) -> str:
    """Enqueue a new document request from the Documents form."""
    doc_type = (doc_type or "").strip().lower()
    title = (title or "").strip()
    requirements = (requirements or "").strip()
    if doc_type not in DOC_TYPES:
        raise ValueError(f"doc_type must be one of {', '.join(DOC_TYPES)}")
    if not title:
        raise ValueError("title is required")
    if not requirements:
        raise ValueError("requirements are required")
    dk = f"doc:{doc_type}:{_slug(title)}@round-1-{int(time.time())}"
    return _doc_enqueue({"doc_type": doc_type, "title": title, "requirements": requirements,
                         "round": 1}, dk)


def doc_refine(review_id: int, answers: str, finalize: bool) -> str:
    """From a doc-open-questions queue item: enqueue the next round with the human's answers (or
    finalize straight to council+write). Closes the current queue row so the queue does not accrete."""
    proc = _psql(["-v", f"rid={review_id}"],
                 "SELECT proposal::text FROM pending_maintenance_reviews "
                 "WHERE id=:'rid'::bigint AND state='pending'")
    if proc.returncode != 0 or not proc.stdout.strip():
        raise RuntimeError("review item not found or already handled")
    prop = json.loads(proc.stdout.strip())
    if prop.get("kind") != "doc-open-questions":
        raise ValueError("not a document review item")
    doc_type = prop["doc_type"]; title = prop["title"]
    prior = prop.get("draft_path", ""); nxt = int(prop.get("round", 1)) + 1
    answers = (answers or "").strip()
    if not finalize and not answers:
        raise ValueError("enter answers, or click Finalize to skip remaining questions")
    # Close-then-enqueue, and let the CLOSE be the concurrency guard: the UPDATE flips exactly one
    # pending->reviewed and RETURNs its id, so a double-click (or a second refine on the same row)
    # finds nothing to close and does NOT enqueue a duplicate round. Only after we own the close do
    # we enqueue the next action; if that enqueue is capped/suppressed we surface it (the row stays
    # closed, so the queue never accretes, and the operator can resubmit from the Documents form).
    proc = _psql(["-v", f"rid={review_id}"],
                 "UPDATE pending_maintenance_reviews SET state='reviewed', reviewed_at=now() "
                 "WHERE id=:'rid'::bigint AND state='pending' RETURNING id")
    if proc.returncode != 0 or proc.stdout.strip() != str(review_id):
        raise RuntimeError("review item already handled (nothing to refine)")
    dk = f"doc:{doc_type}:{_slug(title)}@round-{nxt}-{int(time.time())}"
    result = _doc_enqueue({"doc_type": doc_type, "title": title, "requirements": "",
                           "round": nxt, "prior_draft": prior, "answers": answers,
                           "finalize": bool(finalize)}, dk)
    if not result.startswith("enqueued"):
        # closed but not enqueued (cap/suppressed): tell the operator plainly, no silent drop.
        return f"answers recorded but next round NOT queued — {result}. Resubmit from Documents."
    return ("finalizing document (council + write)" if finalize else f"refining (round {nxt})")


def swe_implement_handoff(handoff_path: str) -> str:
    """Enqueue a swe-implement task from a handoff path (as shown in the human-review queue). The
    path is validated to be a non-empty .md under HANDOFF_ROOT; the server re-derives everything."""
    if not HANDOFF_ROOT:
        raise ValueError("HANDOFF_ROOT not configured")
    rp = os.path.realpath(handoff_path)
    root = os.path.realpath(HANDOFF_ROOT)
    if not (rp == root or rp.startswith(root + os.sep)) or not rp.endswith(".md"):
        raise ValueError("handoff path not under HANDOFF_ROOT")
    return _swe_enqueue({"source": "handoff", "handoff_path": rp, "no_pr": False},
                        f"handoff:{os.path.basename(rp)}")


def swe_implement_issue(issue: str) -> str:
    if not re.fullmatch(r"[^/\s]+/[^#\s]+#[1-9][0-9]*", issue):
        raise ValueError("issue must be owner/repo#N")
    return _swe_enqueue({"source": "issue", "issue": issue, "no_pr": False}, f"issue:{issue}")


def swe_implement_prompt(repo: str, prompt: str) -> str:
    if not re.fullmatch(r"[^/\s]+/[^/\s]+", repo):
        raise ValueError("repo must be owner/repo")
    if not prompt.strip():
        raise ValueError("prompt is empty")
    dk = f"prompt:{repo}:{abs(hash(prompt)) & 0xffffffff:08x}"
    return _swe_enqueue({"source": "prompt", "repo": repo, "prompt": prompt, "no_pr": False}, dk)


def update_human_review_state(review_id: int, state: str) -> str:
    """Mark one local maintenance-review item reviewed or dismissed."""
    if state not in ("reviewed", "dismissed"):
        raise ValueError("bad review state")
    proc = _psql(["-v", f"id={review_id}", "-v", f"state={state}"],
                 "UPDATE pending_maintenance_reviews SET state = :'state', reviewed_at = now() "
                 "WHERE id = :'id'::bigint AND state = 'pending' RETURNING id")
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "human-review update failed")
    return f"{state} human-review #{review_id}" if proc.stdout.strip() else f"#{review_id} not pending"


def _decision_from_psql(proc: subprocess.CompletedProcess) -> dict | None:
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "pending-decision update failed")
    return json.loads(proc.stdout) if proc.stdout.strip() else None


def claim_pending_decision(decision_id: int) -> dict | None:
    proc = _psql(["-v", f"id={decision_id}"],
                 "UPDATE pending_decisions SET state = 'publishing', publish_started_at = now(), "
                 "publish_error = NULL WHERE id = :'id'::bigint AND state = 'pending' "
                 "RETURNING json_build_object('id', id, 'request_id', request_id, 'kind', kind, "
                 "'proposal', proposal, 'provenance', provenance)::text")
    return _decision_from_psql(proc)


def retry_publishing_decision(decision_id: int) -> dict | None:
    proc = _psql(["-v", f"id={decision_id}"],
                 "SELECT json_build_object('id', id, 'request_id', request_id, 'kind', kind, "
                 "'proposal', proposal, 'provenance', provenance)::text FROM pending_decisions "
                 "WHERE id = :'id'::bigint AND state = 'publishing'")
    return _decision_from_psql(proc)


def reject_pending_decision(decision_id: int) -> str:
    proc = _psql(["-v", f"id={decision_id}"],
                 "UPDATE pending_decisions SET state = 'rejected', decided_at = now() "
                 "WHERE id = :'id'::bigint AND state = 'pending' RETURNING id")
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "pending-decision update failed")
    return f"rejected pending-decision #{decision_id}" if proc.stdout.strip() else f"#{decision_id} not pending"


def _mark_decision_publish_error(decision_id: int, error: str) -> None:
    proc = _psql(["-v", f"id={decision_id}", "-v", f"error={error}"],
                 "UPDATE pending_decisions SET publish_error = :'error' "
                 "WHERE id = :'id'::bigint AND state = 'publishing'")
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "pending-decision error update failed")


def _retain_decision(decision: dict) -> None:
    decision_id = int(decision["id"])
    content = json.dumps({"pending_decision_id": decision_id, "proposal": decision["proposal"],
                          "provenance": decision["provenance"]}, sort_keys=True, separators=(",", ":"))
    payload = json.dumps({
        "async": False,
        "items": [{
            "content": content,
            "document_id": f"pending-decision-{decision_id}",
            "metadata": {"pending_decision_id": str(decision_id),
                         "request_id": str(decision["request_id"]), "kind": str(decision["kind"])},
            "tags": ["human-approved", "pending-decision"],
            "update_mode": "replace",
        }],
    }).encode()
    request = Request(f"{HINDSIGHT_URL}/v1/default/banks/{quote(HINDSIGHT_SHARED_BANK, safe='')}/memories",
                      data=payload, headers={"content-type": "application/json"}, method="POST")
    response = urlopen(request, timeout=60)
    try:
        result = json.loads(response.read())
    finally:
        response.close()
    if not (isinstance(result, dict) and result.get("success") is True and result.get("async") is False
            and result.get("bank_id") == HINDSIGHT_SHARED_BANK and result.get("items_count") == 1):
        raise RuntimeError("unexpected Hindsight retain response")


def _publish_decision(decision: dict) -> str:
    decision_id = int(decision["id"])
    try:
        _retain_decision(decision)
        proc = _psql(["-v", f"id={decision_id}"],
                     "UPDATE pending_decisions SET state = 'approved', decided_at = now(), publish_error = NULL "
                     "WHERE id = :'id'::bigint AND state = 'publishing' RETURNING id")
        if proc.returncode != 0:
            raise RuntimeError(proc.stderr.strip() or "pending-decision approval update failed")
        if not proc.stdout.strip():
            raise RuntimeError("pending-decision no longer publishing")
    except Exception as ex:
        _mark_decision_publish_error(decision_id, f"publish failed ({type(ex).__name__})")
        return f"publish failed; retry pending-decision #{decision_id}"
    return f"approved pending-decision #{decision_id}"


def approve_pending_decision(decision_id: int) -> str:
    with PUBLISH_LOCK:
        decision = claim_pending_decision(decision_id)
        return _publish_decision(decision) if decision else f"#{decision_id} not pending"


def retry_pending_decision(decision_id: int) -> str:
    with PUBLISH_LOCK:
        decision = retry_publishing_decision(decision_id)
        return _publish_decision(decision) if decision else f"#{decision_id} not publishing"


def e(v) -> str:
    """HTML-escape a value. ALL dynamic data goes through here (attacker-influenced)."""
    return html.escape("" if v is None else str(v))


def github_pr_link(url: str) -> str:
    m = re.fullmatch(r"https://github\.com/([^/]+)/([^/]+)/pull/(\d+)", url)
    if not m:
        return e(url)
    label = f"{m.group(1)}/{m.group(2)}#{m.group(3)}"
    return f'<a href="{html.escape(url, quote=True)}" target="_blank" rel="noopener">{e(label)}</a>'


def findings_html(raw: str) -> str:
    try:
        findings = json.loads(raw)
    except (TypeError, json.JSONDecodeError):
        return e(raw)
    if not findings:
        return "—"
    if not isinstance(findings, list):
        return e(raw)
    items = []
    for finding in findings:
        if not isinstance(finding, dict):
            items.append(f"<li>{e(finding)}</li>")
            continue
        location = str(finding.get("file", ""))
        if finding.get("line") is not None:
            location += f":{finding['line']}"
        severity = finding.get("severity")
        prefix = " — ".join(part for part in (str(severity) if severity is not None else "", location) if part)
        text = str(finding.get("text", finding.get("claim", "")))
        risk = str(finding.get("risk", ""))
        remediation = str(finding.get("recommended_remediation", ""))
        detail = " — ".join(part for part in (text, risk, remediation) if part)
        items.append(f"<li><strong>{e(prefix)}</strong>{': ' if prefix and detail else ''}{e(detail)}</li>")
    return "<ul>" + "".join(items) + "</ul>"


def _doc_review_row(review_id, summary, open_questions_raw, draft_path, created) -> str:
    """Render one doc-open-questions queue item: the agent's open questions + an answers box with
    Refine / Finalize / Dismiss. Refine re-runs the writer with the answers; Finalize skips remaining
    questions and goes straight to council + write to private-docs."""
    try:
        questions = json.loads(open_questions_raw) if open_questions_raw else []
    except (ValueError, TypeError):
        questions = []
    qlist = "".join(f"<li>{e(q)}</li>" for q in questions) or "<li>(review the draft directly)</li>"
    rid = e(review_id)
    answer_form = (
        f'<form class=inline method=post action="/doc-reviews/{rid}/refine">'
        f'<input type=hidden name=token value="{e(CSRF_TOKEN)}">'
        f'<textarea name=answers rows=4 cols=48 placeholder="Answer the open questions here..."></textarea><br>'
        f'<button type=submit>Refine</button></form>'
        f'<form class=inline method=post action="/doc-reviews/{rid}/finalize" '
        f'onsubmit="return confirm(\'Finalize now? Skips remaining questions, runs council, writes to private-docs.\')">'
        f'<input type=hidden name=token value="{e(CSRF_TOKEN)}"><button>Finalize</button></form>'
        f'<form class=inline method=post action="/human-reviews/{rid}/dismissed">'
        f'<input type=hidden name=token value="{e(CSRF_TOKEN)}"><button>Dismiss</button></form>')
    return ("<tr>"
            f"<td>{rid}</td><td><span class=\"chip s-queued\">doc</span></td><td>{e(draft_path)}</td>"
            f"<td>{e(summary)}<ul>{qlist}</ul></td><td></td><td>{answer_form}</td>"
            f"<td>{e(created)}</td><td></td></tr>")


def human_review_table(rows: list[list[str]]) -> str:
    if not rows:
        return "<section><h2>Human review queue (0)</h2><p class=empty>nothing needs review</p></section>"
    body = ""
    for row in rows:
        # Tolerate the pre-doc 8-tuple and the doc-aware 10-tuple: doc fields default to empty.
        review_id, request_id, url, summary, findings, handoff, created, rtype = row[:8]
        open_questions = row[8] if len(row) > 8 else "[]"
        draft_path = row[9] if len(row) > 9 else ""
        # Document open-questions items get their own renderer: the draft's questions + an answers box
        # and Refine/Finalize/Dismiss, instead of the maintenance Reviewed/Dismiss.
        if rtype == "doc-open-questions":
            body += _doc_review_row(review_id, summary, open_questions, draft_path, created)
            continue
        type_chip = ('<span class="chip s-done">review-ready</span>' if rtype == "review-ready"
                     else '<span class="chip s-running">pr-safety</span>' if rtype == "pr-safety-review"
                     else '<span class="chip s-queued">maintenance</span>')
        implement = ""
        if handoff:
            implement = (f"<form class=inline method=post action=/swe-implement/handoff "
                         f"onsubmit=\"return confirm('Enqueue swe-implement from this handoff? Opens a draft PR.')\">"
                         f"<input type=hidden name=token value=\"{e(CSRF_TOKEN)}\">"
                         f"<input type=hidden name=handoff_path value=\"{e(handoff)}\">"
                         f"<button type=submit>Implement</button></form>")
        body += ("<tr>"
                 f"<td>{e(review_id)}</td><td>{type_chip}</td><td>{github_pr_link(url)}</td>"
                 f"<td>{e(summary).replace(chr(10), '<br>')}</td><td>{findings_html(findings)}</td>"
                 f"<td>{e(handoff)}<br>{implement}</td><td>{e(created)}</td>"
                 f"<td><form class=inline method=post action=\"/human-reviews/{e(review_id)}/reviewed\">"
                 f"<input type=hidden name=token value=\"{e(CSRF_TOKEN)}\"><button>Reviewed</button></form>"
                 f"<form class=inline method=post action=\"/human-reviews/{e(review_id)}/dismissed\">"
                 f"<input type=hidden name=token value=\"{e(CSRF_TOKEN)}\"><button>Dismiss</button></form></td>"
                 "</tr>")
    return ("<section><h2>Human review queue (" + str(len(rows)) + ")</h2>"
            "<p class=hint>Agent-flagged work: <b>review-ready</b> PRs the agent judged done (your call to "
            "approve+merge on GitHub), <b>maintenance</b> work it left for a human, and <b>pr-safety</b> "
            "handoff recommendations. Reviewed/Dismiss only update this local queue; they never write to GitHub.</p>"
            "<table><thead><tr><th>id</th><th>type</th><th>PR</th><th>agent summary</th>"
            "<th>findings</th><th>handoff</th><th>created</th><th>queue</th></tr></thead><tbody>" + body + "</tbody></table></section>")


def json_html(raw: str) -> str:
    try:
        return f"<pre>{e(json.dumps(json.loads(raw), indent=2, sort_keys=True))}</pre>"
    except (TypeError, json.JSONDecodeError):
        return f"<pre>{e(raw)}</pre>"


def pending_decision_table(rows: list[list[str]]) -> str:
    if not rows:
        return "<section><h2>Pending decisions (0)</h2><p class=empty>no pending decisions</p></section>"
    body = ""
    for decision_id, request_id, kind, url, proposal, provenance, state, created, started, publish_error in rows:
        try:
            proposal_data = json.loads(proposal)
        except (TypeError, json.JSONDecodeError):
            proposal_data = {}
        summary = proposal_data.get("summary", "") if isinstance(proposal_data, dict) else ""
        decisions = proposal_data.get("decisions", []) if isinstance(proposal_data, dict) else []
        findings = proposal_data.get("findings", []) if isinstance(proposal_data, dict) else []
        if state == "pending":
            actions = (f'<form class=inline method=post action="/pending-decisions/{e(decision_id)}/approve">'
                       f'<input type=hidden name=token value="{e(CSRF_TOKEN)}"><button>Approve</button></form>'
                       f'<form class=inline method=post action="/pending-decisions/{e(decision_id)}/reject">'
                       f'<input type=hidden name=token value="{e(CSRF_TOKEN)}"><button>Reject</button></form>')
        else:
            actions = (f'<form class=inline method=post action="/pending-decisions/{e(decision_id)}/retry">'
                       f'<input type=hidden name=token value="{e(CSRF_TOKEN)}"><button>Retry</button></form>')
        status = e(state) + (f"<br><span class=err>{e(publish_error)}</span>" if publish_error else "")
        body += ("<tr>"
                 f"<td>{e(decision_id)}</td><td>{github_pr_link(url)}</td><td>{e(kind)}</td>"
                 f"<td>{e(summary).replace(chr(10), '<br>')}<details><summary>proposal</summary>{json_html(proposal)}</details></td>"
                 f"<td>{json_html(json.dumps(decisions))}</td><td>{findings_html(json.dumps(findings))}</td>"
                 f"<td>{json_html(provenance)}</td><td>{status}<br>{e(started or created)}</td><td>{actions}</td></tr>")
    return (f"<section><h2>Pending decisions ({len(rows)})</h2>"
            "<p class=hint>Approve retains stored proposal and provenance to shared memory. Publishing items retry "
            "with the same document ID; reject only changes this local queue.</p>"
            "<table><thead><tr><th>id</th><th>source PR</th><th>kind</th><th>summary / proposal</th>"
            "<th>decisions</th><th>findings</th><th>provenance</th><th>state</th><th>decision</th>"
            "</tr></thead><tbody>" + body + "</tbody></table></section>")


def table(title: str, headers: list[str], rows: list[list[str]], empty: str) -> str:
    if not rows:
        return f"<section><h2>{e(title)}</h2><p class=empty>{e(empty)}</p></section>"
    head = "".join(f"<th>{e(h)}</th>" for h in headers)
    body = "".join(
        "<tr>" + "".join(f"<td>{e(c)}</td>" for c in r) + "</tr>" for r in rows
    )
    return (f"<section><h2>{e(title)}</h2>"
            f"<table><thead><tr>{head}</tr></thead><tbody>{body}</tbody></table></section>")


def render(flash: str = "", fragment: bool = False) -> str:
    try:
        running = query(
            "SELECT id, kind, dedupe_key, "
            "to_char(now()-started_at,'HH24:MI:SS') AS elapsed "
            "FROM requests WHERE status='running' ORDER BY started_at")
        # Detailed queued list (id shown) so each row gets a cancel button.
        queued = query(
            "SELECT id, kind, dedupe_key, to_char(created_at,'MM-DD HH24:MI') AS queued_at "
            "FROM requests WHERE status='queued' ORDER BY id")
        recent = query(
            "SELECT id, kind, status, dedupe_key, coalesce(fail_response,''), "
            "to_char(finished_at,'MM-DD HH24:MI') "
            "FROM requests WHERE status IN ('done','failed','reconcile') "
            "ORDER BY finished_at DESC NULLS LAST LIMIT 20")
        human_review = query(
            "SELECT d.id AS id, d.request_id AS request_id, "
            "coalesce(r.payload->>'url','') AS url, coalesce(d.proposal->>'summary', d.proposal->>'status','') AS summary, "
            "coalesce((d.proposal->'findings')::text,'[]') AS findings, "
            "coalesce(d.proposal->>'handoff_path','') AS handoff, "
            "to_char(d.created_at,'MM-DD HH24:MI') AS created, "
            "CASE WHEN d.proposal->>'kind' = 'doc-open-questions' THEN 'doc-open-questions' "
            "     WHEN d.proposal->>'ready' = 'true' THEN 'review-ready' ELSE r.kind END AS rtype, "
            "coalesce((d.proposal->'open_questions')::text,'[]') AS open_questions, "
            "coalesce(d.proposal->>'draft_path','') AS draft_path "
            "FROM pending_maintenance_reviews d JOIN requests r ON r.id = d.request_id "
            "WHERE d.state='pending' ORDER BY d.created_at DESC")
        pending = query(
            "SELECT d.id AS id, d.request_id AS request_id, d.kind AS kind, "
            "coalesce(r.payload->>'url','') AS url, d.proposal::text AS proposal, "
            "d.provenance::text AS provenance, d.state AS state, "
            "to_char(d.created_at,'MM-DD HH24:MI') AS created, "
            "coalesce(to_char(d.publish_started_at,'MM-DD HH24:MI'),'') AS started, "
            "coalesce(d.publish_error,'') AS publish_error "
            "FROM pending_decisions d JOIN requests r ON r.id = d.request_id "
            "WHERE d.state IN ('pending','publishing') ORDER BY d.created_at DESC LIMIT 20")
        today = query(
            "SELECT kind, status, count(*) FROM requests "
            "WHERE created_at::date = now()::date GROUP BY kind, status ORDER BY kind, status")
        capped = query(
            "SELECT kind, dedupe_key, count(*) AS fails, "
            "to_char(max(finished_at),'MM-DD HH24:MI') AS last_fail "
            "FROM requests WHERE status='failed' GROUP BY kind, dedupe_key "
            "HAVING count(*) >= 3 ORDER BY max(finished_at) DESC NULLS LAST LIMIT 20")
        swe = query(
            "SELECT id, status, dedupe_key AS task, coalesce(posted_ref,'') AS result, "
            "coalesce(fail_response,'') AS detail, "
            "to_char(coalesce(finished_at,started_at,created_at),'MM-DD HH24:MI') AS updated "
            "FROM requests WHERE kind='swe-implement' ORDER BY id DESC LIMIT 20")
        docs = query(
            "SELECT id, status, payload->>'doc_type' AS type, payload->>'title' AS title, "
            "coalesce(payload->>'round','1') AS round, coalesce(posted_ref,'') AS result, "
            "coalesce(fail_response,'') AS detail, "
            "to_char(coalesce(finished_at,started_at,created_at),'MM-DD HH24:MI') AS updated "
            "FROM requests WHERE kind='doc-write' ORDER BY id DESC LIMIT 20")
        db_err = None
    except Exception as ex:
        running = queued = recent = human_review = pending = today = capped = swe = docs = []
        db_err = str(ex)

    banner = (f"<p class=err>DB unreachable: {e(db_err)}</p>" if db_err else "")
    flash_html = f"<p class=flash>{e(flash)}</p>" if flash else ""
    # Queued section: each row gets a cancel button (POST /cancel, token+method-guarded).
    if queued:
        qrows = "".join(
            "<tr>" + "".join(f"<td>{e(c)}</td>" for c in r[:4])
            + f"<td>{cancel_button(r[0])}</td></tr>" for r in queued)
        queued_html = (f"<section><h2>Queued ({len(queued)})</h2><table><thead><tr>"
                       "<th>id</th><th>kind</th><th>dedupe_key</th><th>queued</th><th></th>"
                       f"</tr></thead><tbody>{qrows}</tbody></table></section>")
    else:
        queued_html = "<section><h2>Queued</h2><p class=empty>queue empty</p></section>"

    # Force-inject form (was in the page shell; now a tab so everything lives in one navigable region).
    inject_html = (
        "<section><h2>Force-inject a PR <span class=sub>re-run even if already done</span></h2>"
        "<form class=toolbar method=post action=/inject onsubmit=\"return confirm('Inject this PR into the queue?')\">"
        f"<input type=hidden name=token value=\"{e(CSRF_TOKEN)}\">"
        "<select name=kind><option value=pr-review>pr-review</option><option value=pr-maintain>pr-maintain</option></select>"
        "<input name=repo placeholder=\"ORG/repo\" size=24 required>"
        "<input name=pr placeholder=\"PR #\" size=6 required pattern=\"[1-9][0-9]*\">"
        "<button type=submit>inject</button></form></section>")

    # The live-updating region, organized into TABS. One tab is visible at a time (CSS), the active
    # tab is remembered in the URL hash so it survives the live-refresh swap of #live. Counts in the
    # nav give an at-a-glance badge without opening each tab.
    need_review = len(human_review) + len(pending)
    tabs = [
        ("review", f"Review" + (f" ({need_review})" if need_review else ""),
         f'{human_review_table(human_review)}{pending_decision_table(pending)}'),
        ("queue", f"Queue" + (f" ({len(running)+len(queued)})" if (running or queued) else ""),
         f'{table("Running now", ["id","kind","dedupe_key","elapsed"], running, "nothing running")}'
         f'{queued_html}'
         f'{recent_table(recent)}'
         f'{table(f"Capped — stopped retrying ({len(capped)})", ["kind","dedupe_key","fails","last_fail"], capped, "none capped")}'
         f'{table("Today by kind", ["kind","status","count"], today, "nothing today")}'),
        ("documents", "Documents", doc_section(docs)),
        ("swe", "swe-implement", swe_implement_section(swe)),
        ("inject", "Inject", inject_html),
    ]
    # Mark the first tab active server-side so the page is never blank before JS runs; JS then
    # honors the URL hash. Default landing = Review (things that need you).
    nav = "".join(
        f'<a class="navlink{" active" if i == 0 else ""}" data-tab="{tid}" href="#tab-{tid}">{e(label)}</a>'
        for i, (tid, label, _) in enumerate(tabs))
    panels = "".join(
        f'<div class="tabpanel{" active" if i == 0 else ""}" data-tab="{tid}">{content}</div>'
        for i, (tid, _, content) in enumerate(tabs))
    inner = f'<nav class="tabnav">{nav}</nav>{panels}'
    if fragment:
        return inner

    return f"""<!doctype html><html><head><meta charset=utf-8>
<title>agent-fleet status</title>
<style>
 :root{{--bg:#0f1117;--card:#181b24;--fg:#e6e8ee;--mut:#8b90a0;--line:#262a36;--acc:#e6197f}}
 *{{box-sizing:border-box}}
 body{{font:14px/1.55 -apple-system,BlinkMacSystemFont,system-ui,sans-serif;margin:0;padding:2rem;
   color:var(--fg);background:var(--bg)}}
 h1{{font-size:1.25rem;margin:0 0 .25rem;display:flex;align-items:center;gap:.5rem}}
 h2{{font-size:.95rem;margin:0 0 .6rem;color:var(--fg)}}
 .sub{{color:var(--mut);font-size:.8rem;font-weight:400}}
 section{{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:1rem 1.1rem;margin:1rem 0}}
 table{{border-collapse:collapse;width:100%}}
 th,td{{text-align:left;padding:.35rem .6rem;border-bottom:1px solid var(--line);font-variant-numeric:tabular-nums;vertical-align:top}}
 th{{color:var(--mut);font-weight:600;font-size:.78rem;text-transform:uppercase;letter-spacing:.03em}}
 tr:last-child td{{border-bottom:none}}
 td{{max-width:60ch;overflow-wrap:anywhere;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.85rem}}
 pre{{white-space:pre-wrap;margin:.4rem 0;font:inherit}}
 details summary{{cursor:pointer;color:var(--mut)}}
 .empty{{color:var(--mut)}} .hint{{color:var(--mut)}} .err{{color:#ff6b6b;font-weight:600}}
 .flash{{color:#111;background:#7ee787;border-radius:6px;padding:.4rem .7rem;font-weight:600}}
 .chip{{display:inline-block;padding:.05rem .5rem;border-radius:999px;font-size:.75rem;font-weight:600;font-family:system-ui}}
 .s-queued{{background:#2b2f3a;color:#c8ccd8}} .s-running{{background:#12324f;color:#5ab0ff}}
 .s-done{{background:#123a22;color:#7ee787}} .s-failed{{background:#3a1620;color:#ff8095}}
 .s-skipped{{background:#2b2f3a;color:#9aa0ac}}
 button{{font:inherit;font-size:.8rem;background:#3a1620;color:#ff8095;border:1px solid #5a2230;
   border-radius:6px;padding:.15rem .6rem;cursor:pointer}}
 button:hover{{background:#5a2230}}
 form.inline{{display:inline}}
 .toolbar{{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center}}
 .toolbar input,.toolbar select{{font:inherit;background:var(--bg);color:var(--fg);border:1px solid var(--line);border-radius:6px;padding:.3rem .5rem}}
 .toolbar button{{background:#12324f;color:#5ab0ff;border-color:#1d4a72}}
 .toolbar button:hover{{background:#1d4a72}}
 .tabnav{{display:flex;gap:.25rem;flex-wrap:wrap;position:sticky;top:0;background:var(--bg);
   padding:.5rem 0;margin-bottom:.5rem;border-bottom:1px solid var(--line);z-index:5}}
 .navlink{{text-decoration:none;color:var(--mut);font-weight:600;font-size:.85rem;
   padding:.35rem .8rem;border-radius:8px;border:1px solid transparent}}
 .navlink:hover{{color:var(--fg);background:var(--card)}}
 .navlink.active{{color:var(--fg);background:var(--card);border-color:var(--line)}}
 .tabpanel{{display:none}} .tabpanel.active{{display:block}}
</style></head><body>
<h1><span style="color:var(--acc)">◉</span> agent-fleet <span class=sub>live · updates {REFRESH_SECONDS}s</span></h1>
{banner}{flash_html}
<div id=live>{inner}</div>
<script>{LIVE_JS}</script>
</body></html>"""


def _doc_ref(result: str) -> str:
    """A finished doc's result is a private-docs file path; show its basename (not a link — it is a
    host file, not served). An in-progress result is a short status string."""
    if result.startswith("/") and result.endswith(".md"):
        return f"<code>{e(os.path.basename(result))}</code>"
    return e(result)


def doc_section(rows: list[list[str]]) -> str:
    """Documents form (PRD/DD writer) + a table of doc-write requests. Open questions are answered
    from the human-review queue above; finished docs land in private-docs/inbox."""
    if rows:
        body = "".join(
            "<tr>"
            f"<td>{e(r[0])}</td><td>{chip(r[1])}</td><td>{e(r[2])}</td><td>{e(r[3])}</td>"
            f"<td>{e(r[4])}</td><td>{_doc_ref(r[5])}</td><td>{e(r[6])}</td><td>{e(r[7])}</td></tr>"
            for r in rows)
        tbl = ("<table><thead><tr><th>id</th><th>status</th><th>type</th><th>title</th><th>round</th>"
               f"<th>result</th><th>detail</th><th>updated</th></tr></thead><tbody>{body}</tbody></table>")
    else:
        tbl = "<p class=empty>no document requests yet</p>"
    return ("<section><h2>Documents <span class=sub>PRD / Design Doc writer (Rokt)</span></h2>"
            "<p class=hint>Draft a Rokt PRD (SEPRD / MLPRD / Launchpad) or a Design Doc. The writer drafts, "
            "then sends its <b>open questions</b> to the human-review queue above — answer them and <b>Refine</b>, "
            "or <b>Finalize</b> to run council and write the doc into <code>~/private-docs/inbox</code>.</p>"
            "<form class=toolbar method=post action=/doc-write "
            "onsubmit=\"return confirm('Draft this document?')\">"
            f"<input type=hidden name=token value=\"{e(CSRF_TOKEN)}\">"
            "<select name=doc_type>"
            "<option value=seprd>SEPRD (software)</option>"
            "<option value=mlprd>MLPRD (ML)</option>"
            "<option value=launchpad>Launchpad</option>"
            "<option value=dd>Design Doc</option></select>"
            "<input name=title placeholder=\"document title\" size=32 required>"
            "<input name=requirements placeholder=\"goals & requirements\" size=48 required>"
            "<button type=submit>draft document</button></form>"
            f"{tbl}</section>")


def swe_implement_section(rows: list[list[str]]) -> str:
    """Submit form (issue / prompt) + a table of swe-implement requests with draft-PR links. Handoff
    tasks are submitted inline from the human-review queue's Implement button, not here."""
    if rows:
        body = "".join(
            "<tr>"
            f"<td>{e(r[0])}</td><td>{chip(r[1])}</td><td>{e(r[2])}</td>"
            f"<td>{_swe_ref(r[3])}</td><td>{e(r[4])}</td><td>{e(r[5])}</td></tr>"
            for r in rows)
        tbl = ("<table><thead><tr><th>id</th><th>status</th><th>task</th><th>result</th>"
               f"<th>detail</th><th>updated</th></tr></thead><tbody>{body}</tbody></table>")
    else:
        tbl = "<p class=empty>no swe-implement requests yet</p>"
    return ("<section><h2>swe-implement <span class=sub>task → draft PR (opened by swe-implement-server)</span></h2>"
            "<p class=hint>Implement a handoff via its <b>Implement</b> button above, or submit an issue / prompt here. "
            "Enqueue only — the swe-implement-server clones fresh, implements, and opens a DRAFT PR.</p>"
            "<form class=toolbar method=post action=/swe-implement/issue "
            "onsubmit=\"return confirm('Enqueue swe-implement from this issue?')\">"
            f"<input type=hidden name=token value=\"{e(CSRF_TOKEN)}\">"
            "<input name=issue placeholder=\"ORG/repo#123\" size=24 required>"
            "<button type=submit>implement issue</button></form>"
            "<form class=toolbar method=post action=/swe-implement/prompt "
            "onsubmit=\"return confirm('Enqueue swe-implement from this prompt?')\" style=margin-top:.5rem>"
            f"<input type=hidden name=token value=\"{e(CSRF_TOKEN)}\">"
            "<input name=repo placeholder=\"ORG/repo\" size=20 required>"
            "<input name=prompt placeholder=\"task prompt\" size=48 required>"
            "<button type=submit>implement prompt</button></form>"
            f"{tbl}</section>")


def _swe_ref(ref: str) -> str:
    ref = (ref or "").strip()
    if ref.startswith("http"):
        return f'<a href="{e(ref)}" target="_blank" rel="noopener">draft PR</a>'
    return e(ref)


def chip(status: str) -> str:
    s = "failed" if status == "reconcile" else status if status in ("queued", "running", "done", "failed", "skipped") else "queued"
    return f'<span class="chip s-{s}">{e(status)}</span>'


def cancel_button(req_id) -> str:
    return (f'<form class=inline method=post action=/cancel '
            f'onsubmit="return confirm(\'Cancel queued #{e(req_id)}?\')">'
            f'<input type=hidden name=token value="{e(CSRF_TOKEN)}">'
            f'<input type=hidden name=id value="{e(req_id)}">'
            f'<button type=submit>cancel</button></form>')


def recent_table(rows) -> str:
    if not rows:
        return "<section><h2>Recent (last 20)</h2><p class=empty>no completed runs</p></section>"
    body = "".join(
        "<tr>" + f"<td>{e(r[0])}</td><td>{e(r[1])}</td><td>{chip(r[2])}</td>"
        + f"<td>{e(r[3])}</td><td>{e(r[4])}</td><td>{e(r[5])}</td></tr>" for r in rows)
    return ("<section><h2>Recent (last 20)</h2><table><thead><tr>"
            "<th>id</th><th>kind</th><th>status</th><th>dedupe_key</th><th>fail_response</th><th>finished</th>"
            f"</tr></thead><tbody>{body}</tbody></table></section>")


class Handler(BaseHTTPRequestHandler):
    # Cache the rendered page for the refresh window so a burst of concurrent GETs (tab storm,
    # aggressive refresh) shares ONE DB pass instead of each thread forking 5 psql procs.
    _lock = threading.Lock()
    _cache = None
    _cache_ts = 0.0
    _frag = None
    _frag_ts = 0.0

    @classmethod
    def cached_page(cls) -> bytes:
        now = time.monotonic()
        with cls._lock:
            if cls._cache is None or (now - cls._cache_ts) >= REFRESH_SECONDS:
                cls._cache = render().encode()
                cls._cache_ts = now
            return cls._cache

    @classmethod
    def cached_fragment(cls) -> bytes:
        now = time.monotonic()
        with cls._lock:
            if cls._frag is None or (now - cls._frag_ts) >= REFRESH_SECONDS:
                cls._frag = render(fragment=True).encode()
                cls._frag_ts = now
            return cls._frag

    def do_GET(self):
        if self.path in ("/fragment", "/fragment.html"):
            try:
                frag = self.cached_fragment()
            except Exception as ex:
                self.send_response(500); self.end_headers()
                self.wfile.write(f"error: {ex}".encode()); return
            self.send_response(200)
            self.send_header("content-type", "text/html; charset=utf-8")
            self.send_header("content-length", str(len(frag)))
            self.end_headers()
            self.wfile.write(frag); return
        if self.path not in ("/", "/index.html"):
            self.send_response(404); self.end_headers(); return
        try:
            page = self.cached_page()
        except Exception as ex:
            self.send_response(500); self.end_headers()
            self.wfile.write(f"error: {ex}".encode()); return
        self.send_response(200)
        self.send_header("content-type", "text/html; charset=utf-8")
        self.send_header("content-length", str(len(page)))
        self.end_headers()
        self.wfile.write(page)

    # --- writes (M4). CSRF-guarded: Host + Origin allowlist + per-process token. No auth by design
    # (localhost single-user). GET never mutates; only these two POST actions do. ---
    def _csrf_ok(self, params) -> bool:
        host = self.headers.get("Host", "")
        if host not in ALLOWED_HOSTS:
            return False
        origin = self.headers.get("Origin")
        if origin is not None and origin not in ALLOWED_ORIGINS:
            return False
        return secrets.compare_digest(params.get("token", [""])[0], CSRF_TOKEN)

    def _redirect(self, flash: str):
        # Re-render fresh (bypass cache) with a flash message, invalidate both caches so the next
        # poll reflects the write immediately.
        with Handler._lock:
            Handler._cache = None
            Handler._frag = None
        page = render(flash=flash).encode()
        self.send_response(200)
        self.send_header("content-type", "text/html; charset=utf-8")
        self.send_header("content-length", str(len(page)))
        self.end_headers(); self.wfile.write(page)

    def do_POST(self):
        length = int(self.headers.get("Content-Length", "0") or "0")
        body = self.rfile.read(length).decode("utf-8", "replace") if length else ""
        params = parse_qs(body)
        if not self._csrf_ok(params):
            self.send_response(403); self.end_headers()
            self.wfile.write(b"forbidden (csrf)"); return
        try:
            if self.path == "/cancel":
                rid = int(params.get("id", [""])[0])
                result = cancel_queued(rid)
            elif self.path == "/inject":
                result = inject(params.get("repo", [""])[0].strip(),
                                params.get("pr", [""])[0].strip(),
                                params.get("kind", [""])[0].strip())
            elif self.path == "/swe-implement/handoff":
                result = swe_implement_handoff(params.get("handoff_path", [""])[0].strip())
            elif self.path == "/swe-implement/issue":
                result = swe_implement_issue(params.get("issue", [""])[0].strip())
            elif self.path == "/swe-implement/prompt":
                result = swe_implement_prompt(params.get("repo", [""])[0].strip(),
                                              params.get("prompt", [""])[0].strip())
            elif self.path == "/doc-write":
                result = doc_write(params.get("doc_type", [""])[0],
                                   params.get("title", [""])[0],
                                   params.get("requirements", [""])[0])
            else:
                review_match = re.fullmatch(r"/human-reviews/(\d+)/(reviewed|dismissed)", self.path)
                decision_match = re.fullmatch(r"/pending-decisions/(\d+)/(approve|retry|reject)", self.path)
                doc_review_match = re.fullmatch(r"/doc-reviews/(\d+)/(refine|finalize)", self.path)
                if doc_review_match:
                    result = doc_refine(int(doc_review_match.group(1)),
                                        params.get("answers", [""])[0],
                                        doc_review_match.group(2) == "finalize")
                elif review_match:
                    result = update_human_review_state(int(review_match.group(1)), review_match.group(2))
                elif decision_match:
                    decision_id, action = int(decision_match.group(1)), decision_match.group(2)
                    if action == "approve":
                        result = approve_pending_decision(decision_id)
                    elif action == "retry":
                        result = retry_pending_decision(decision_id)
                    else:
                        result = reject_pending_decision(decision_id)
                else:
                    self.send_response(404); self.end_headers(); return
        except (ValueError, RuntimeError) as ex:
            result = f"rejected: {ex}"
        # Audit trail (single line, stderr) — mutating a work queue should not be silent.
        print(f"WRITE {self.path} {result}", flush=True)
        # AJAX submit (button click without a page reload): return a small JSON result and let the
        # client refresh the live region. A normal form post still gets the full-page redirect.
        if self.headers.get("X-Requested-With") == "fetch":
            with Handler._lock:
                Handler._cache = None; Handler._frag = None   # next /fragment reflects this write
            payload = json.dumps({"ok": not result.lower().startswith("rejected"),
                                  "flash": result}).encode()
            self.send_response(200)
            self.send_header("content-type", "application/json")
            self.send_header("content-length", str(len(payload)))
            self.end_headers(); self.wfile.write(payload); return
        self._redirect(result)

    def log_message(self, *a):  # quiet
        pass


if __name__ == "__main__":
    # Compose explicitly sets 0.0.0.0 so its localhost-only port-map can reach this process.
    # Direct runs default to loopback; Host/Origin/CSRF provide defense in depth for POSTs.
    ThreadingHTTPServer((os.environ.get("STATUS_BIND", "127.0.0.1"), PORT), Handler).serve_forever()
