#!/usr/bin/env bash
# swe-implement-server — serial queue-draining worker for the 'swe-implement' kind.
#
# Claims one swe-implement request at a time and runs bin/swe-implement (the harness) to turn
# an approved task into a DRAFT corrective PR. Mirrors bin/agent-server's concurrency machinery
# (per-kind single-instance advisory lock held for process life; reclaim; FOR UPDATE SKIP LOCKED
# claim; heartbeat self-exit) via lib/queue.sh, but the per-request work is the harness, not the
# PR-review runner.
#
# Request payload (requests.kind = 'swe-implement'):
#   { "source": "handoff" | "issue" | "prompt",
#     "handoff_path": "<abs path>",          # source=handoff
#     "issue": "owner/repo#N",               # source=issue
#     "prompt": "<text>", "repo": "owner/repo",  # source=prompt
#     "no_pr": true|false }                  # optional; default false (opens a draft PR)
# The harness owns all safety (fresh clone, evidence re-verify, draft-only, fail-closed). On success
# the draft PR url is stored in requests.posted_ref.
set -euo pipefail
umask 077

HERE="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/queue.sh
. "$HERE/lib/queue.sh"

KIND=swe-implement
POLL_INTERVAL="${SWE_IMPLEMENT_POLL_INTERVAL:-15}"
PER_REQUEST_TIMEOUT="${SWE_IMPLEMENT_PER_REQUEST_TIMEOUT:-2400}"   # 40m ceiling (clone+agent+validate)
LOOP_HEARTBEAT_MAX="${SWE_IMPLEMENT_LOOP_HEARTBEAT_MAX:-7200}"
HARNESS="${SWE_IMPLEMENT_HARNESS:-$HERE/bin/swe-implement}"
# Renewable DB lease + nonce fencing (same model as agent-server since #58). A background heartbeat
# renews the lease while the long-running harness works; reclaim only requeues expired leases.
LEASE_SECONDS="${SWE_IMPLEMENT_LEASE_SECONDS:-120}"
LEASE_HEARTBEAT="${SWE_IMPLEMENT_LEASE_HEARTBEAT:-30}"
LEASE_DB_TIMEOUT="${SWE_IMPLEMENT_LEASE_DB_TIMEOUT:-10}"
[[ "$LEASE_SECONDS" =~ ^[1-9][0-9]*$ && "$LEASE_HEARTBEAT" =~ ^[1-9][0-9]*$ && "$LEASE_DB_TIMEOUT" =~ ^[1-9][0-9]*$ ]] \
  || { echo "lease seconds, heartbeat, and DB timeout must be positive integers" >&2; exit 2; }
(( LEASE_HEARTBEAT * 3 <= LEASE_SECONDS && 2 * (LEASE_HEARTBEAT + LEASE_DB_TIMEOUT) + 2 <= LEASE_SECONDS )) \
  || { echo "lease must cover two heartbeat+DB-timeout windows with safety margin" >&2; exit 2; }

ts() { date '+%Y-%m-%dT%H:%M:%S%z'; }
log() { echo "$(ts) swe-implement-server $*"; }
need() { command -v "$1" >/dev/null 2>&1 || { echo "missing dependency: $1" >&2; exit 2; }; }
need psql; need jq; need git; need gh
[[ -x "$HARNESS" ]] || { echo "missing harness: $HARNESS" >&2; exit 2; }
: "${GH_TOKEN:?set GH_TOKEN (push + SAML authorized for the target org)}"
TIMEOUT_BIN="$(command -v timeout || command -v gtimeout || true)"
[[ -n "$TIMEOUT_BIN" ]] || { echo "GNU timeout required (coreutils)" >&2; exit 2; }
db_up() { _psql <<<"SELECT 1;" >/dev/null 2>&1; }

# --- renewable lease heartbeat (mirrors agent-server) ---
WORKER_PID="$$"
ACTIVE_CHILD=""
LEASE_HEARTBEAT_PID=""
SHUTDOWN_REQUESTED=false
request_shutdown() { SHUTDOWN_REQUESTED=true; log "shutdown requested; draining active request"; }
abort_lost_lease() {
  log "worker lost its lease; aborting active request"
  stop_lease_heartbeat
  if [[ -n "$ACTIVE_CHILD" ]]; then
    kill -TERM "$ACTIVE_CHILD" 2>/dev/null || true; sleep 2
    kill -KILL "$ACTIVE_CHILD" 2>/dev/null || true; wait "$ACTIVE_CHILD" 2>/dev/null || true
  fi
  exit 143
}
trap request_shutdown TERM INT
trap abort_lost_lease USR1
start_lease_heartbeat() {
  local id="$1" nonce="$2"
  (
    failures=0
    while sleep "$LEASE_HEARTBEAT"; do
      state="$("$TIMEOUT_BIN" --kill-after=2s "${LEASE_DB_TIMEOUT}s" bash -c \
        '. "$1"; queue_renew_lease "$2" "$3" "$4"' _ "$HERE/lib/queue.sh" "$id" "$nonce" "$LEASE_SECONDS" \
        2>/dev/null)" || state=error
      case "$state" in
        renewed) failures=0 ;;
        finished) exit 0 ;;
        lost) log "FATAL: lease lost for request $id; stopping worker"; kill -USR1 "$WORKER_PID"; exit 1 ;;
        *) failures=$((failures + 1)); (( failures < 2 )) && continue
           log "FATAL: lease renewal failed twice for request $id; stopping worker"; kill -USR1 "$WORKER_PID"; exit 1 ;;
      esac
    done
  ) &
  LEASE_HEARTBEAT_PID="$!"
}
stop_lease_heartbeat() {
  [[ -n "$LEASE_HEARTBEAT_PID" ]] || return 0
  kill "$LEASE_HEARTBEAT_PID" 2>/dev/null || true
  wait "$LEASE_HEARTBEAT_PID" 2>/dev/null || true
  LEASE_HEARTBEAT_PID=""
}

# Build harness args from the request payload. Prints NUL-free args one per line into the named
# array via stdout capture (caller reads with mapfile). Rejects an unknown/invalid source.
harness_args_from_payload() {
  local payload="$1" source
  source="$(jq -r '.source // empty' <<<"$payload")"
  case "$source" in
    handoff)
      local hp; hp="$(jq -r '.handoff_path // empty' <<<"$payload")"
      [[ -n "$hp" ]] || { log "payload: handoff source missing handoff_path"; return 1; }
      printf '%s\n%s\n' --handoff "$hp" ;;
    issue)
      local iss; iss="$(jq -r '.issue // empty' <<<"$payload")"
      [[ "$iss" =~ ^[^/]+/[^#]+#[1-9][0-9]*$ ]] || { log "payload: issue source needs owner/repo#N"; return 1; }
      printf '%s\n%s\n' --issue "$iss" ;;
    prompt)
      local pt repo; pt="$(jq -r '.prompt // empty' <<<"$payload")"; repo="$(jq -r '.repo // empty' <<<"$payload")"
      [[ -n "$pt" && "$repo" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]] || { log "payload: prompt source needs prompt + repo"; return 1; }
      printf '%s\n%s\n%s\n%s\n' --prompt "$pt" --repo "$repo" ;;
    *) log "payload: unknown source '$source'"; return 1 ;;
  esac
  [[ "$(jq -r '.no_pr // false' <<<"$payload")" == "true" ]] && printf '%s\n' --no-pr
  return 0
}

process_one() {
  local id="$1" payload="$2" run_id="$3" nonce="$4"
  local argfile; argfile="$(mktemp)"; local rc=0
  if ! harness_args_from_payload "$payload" > "$argfile"; then
    queue_mark_failed "$id" "invalid swe-implement payload" "$nonce" >/dev/null; rm -f "$argfile"; return 0
  fi
  local -a args=(); local line
  while IFS= read -r line; do args+=("$line"); done < "$argfile"
  rm -f "$argfile"

  # Record the intent to make a side effect (draft PR) BEFORE running, so an expired lease leaves the
  # row as running-with-side_effect and reclaim routes it to 'reconcile' rather than blind requeue.
  queue_mark_side_effect "$id" "$nonce" >/dev/null 2>&1 || true

  # Run the harness with output to a FILE, not $(...) capture: command substitution would keep the
  # pipe open until every process the harness spawned - including mewritecode's daemonized mcp-remote
  # MCP children - closes it, entangling this worker's lifetime with those subprocesses. Track the
  # child PID so a lost lease (USR1) can abort it.
  local outfile; outfile="$(mktemp)"
  "$TIMEOUT_BIN" --kill-after=15s "${PER_REQUEST_TIMEOUT}s" "$HARNESS" "${args[@]}" >"$outfile" 2>&1 </dev/null &
  ACTIVE_CHILD="$!"
  wait "$ACTIVE_CHILD" || rc=$?
  ACTIVE_CHILD=""
  sed 's/^/  harness: /' "$outfile"

  if (( rc == 0 )); then
    # harness prints "draft PR: <url>" on success (or nothing for --no-pr).
    local url; url="$(sed -n 's/.*draft PR: //p' "$outfile" | tail -1)"
    queue_mark_done "$id" "$url" "$nonce" >/dev/null
    log "request $id done${url:+ (}$url${url:+)}"
  else
    # harness exit 1 = agent produced no commit (nothing to fix); >1 = a real error. Both are
    # terminal for this request; a new head re-enqueues a fresh row.
    local reason; reason="$(sed -n 's/^.*swe-implement: //p' "$outfile" | tail -1)"
    queue_mark_failed "$id" "swe-implement rc=$rc${reason:+: }$reason" "$nonce" >/dev/null
    log "request $id failed rc=$rc"
  fi
  rm -f "$outfile"
}

log "swe-implement-server up (leased, kind=$KIND); poll ${POLL_INTERVAL}s, lease ${LEASE_SECONDS}s/${LEASE_HEARTBEAT}s heartbeat"
last_progress="$(date +%s)"

while true; do
  [[ "$SHUTDOWN_REQUESTED" == true ]] && { stop_lease_heartbeat; exit 0; }
  now="$(date +%s)"
  if (( now - last_progress > LOOP_HEARTBEAT_MAX )); then
    log "FATAL: no loop progress in ${LOOP_HEARTBEAT_MAX}s; self-exiting for restart"; exit 3
  fi
  if ! db_up; then log "db unreachable; backing off"; sleep "$POLL_INTERVAL"; continue; fi

  nonce="$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  run_id="$(date '+%Y%m%d-%H%M%S')-${HOSTNAME:-worker}-${nonce:0:8}"
  if ! claim="$(queue_claim_one "$KIND" "$run_id" "$nonce" "$LEASE_SECONDS")"; then
    log "claim failed; backing off"; sleep "$POLL_INTERVAL"; continue
  fi
  if [[ -z "$claim" || "$claim" == "null" ]]; then sleep "$POLL_INTERVAL"; continue; fi

  id="$(jq -r '.id' <<<"$claim")"
  payload="$(jq -c '.payload' <<<"$claim")"
  dedupe_key="$(jq -r '.dedupe_key' <<<"$claim")"
  log "claimed request $id ($dedupe_key)"
  start_lease_heartbeat "$id" "$nonce"
  process_one "$id" "$payload" "$run_id" "$nonce" || log "process_one error for $id"
  stop_lease_heartbeat
  last_progress="$(date +%s)"
  [[ "$SHUTDOWN_REQUESTED" == true ]] && exit 0
done
