#!/usr/bin/env bash
# Fleet memory curator: ruminate recent source material (agent-fleet transcripts, Rokt code notes,
# private-docs), ask the memory-curator persona what is worth remembering, then deterministically
# filter + dedup + WRITE the keepers to the shared Hindsight bank via REST.
#
# The agent PROPOSES (strict JSON); this wrapper is the gate that actually writes. Even "autonomous"
# does not mean the model holds the write syscall: a reject-shape filter drops completion/verdict/
# provenance-only/secret/too-short/too-long content, so junk never reaches the bank even if proposed.
# Writes go over REST /memories, which the fleet-shared MCP read-only lock (#77) does not gate.
set -euo pipefail
umask 077

HERE="$(cd "$(dirname "$0")/.." && pwd)"
MEWRITE="${MEWRITECODE_BIN:-mewritecode}"
# Stronger model than the high-volume analyst: curation judgment IS the product, and volume is low.
MODEL="${MEMORY_CURATOR_MODEL:-openai/gpt-5.6-sol}"
AGENT_DEF="${MEMORY_CURATOR_AGENT:-$HOME/.mewrite/agents/memory-curator.md}"
HS="${HINDSIGHT_URL:-http://localhost:8888}"
BANK="${HINDSIGHT_SHARED_BANK:-fleet-shared}"
CURATOR_VERSION="curator/v1"

# Source roots (host paths). Empty/absent sources are skipped, not fatal.
TASKS_DIR="${MEMORY_CURATOR_TASKS_DIR:-$HOME/.mewrite/agent/tasks}"
PRIVATE_DOCS="${MEMORY_CURATOR_PRIVATE_DOCS:-$HOME/private-docs}"
STATE_DIR="${MEMORY_CURATOR_STATE_DIR:-$HOME/.local/share/ai-pr-automation/curator}"
WATERMARK="$STATE_DIR/last-run"

# Bounds.
MAX_MEMORIES="${MEMORY_CURATOR_MAX_MEMORIES:-15}"       # hard cap written per run
MAX_SOURCE_DOCS="${MEMORY_CURATOR_MAX_SOURCE_DOCS:-40}" # transcript/doc slice per run
LOOKBACK_HOURS="${MEMORY_CURATOR_LOOKBACK_HOURS:-24}"   # first-run window when no watermark
RUN_TIMEOUT="${MEMORY_CURATOR_TIMEOUT:-1200}"           # agent wallclock ceiling (s)
TTL_DAYS="${MEMORY_CURATOR_TTL_DAYS:-90}"               # sweep curator memories older than this

need() { command -v "$1" >/dev/null 2>&1 || { echo "missing dependency: $1" >&2; exit 2; }; }
need jq; need curl; need find; need python3
command -v "$MEWRITE" >/dev/null || { echo "missing mewritecode ($MEWRITE)" >&2; exit 2; }
[[ -f "$AGENT_DEF" ]] || { echo "missing curator persona: $AGENT_DEF" >&2; exit 2; }
TIMEOUT_BIN="$(command -v timeout || command -v gtimeout || true)"
[[ -n "$TIMEOUT_BIN" ]] || { echo "GNU timeout required (coreutils)" >&2; exit 2; }
log() { printf '%s memory-curator %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*"; }
mkdir -p "$STATE_DIR"

# Single instance: don't let overlapping schedules double-write. mkdir is atomic and portable
# (macOS has no flock). Stale locks older than 2h are reclaimed.
LOCK="$STATE_DIR/.lock"
mtime_of() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }  # GNU then BSD
if [[ -d "$LOCK" ]]; then
  lock_age=$(( $(date +%s) - $(mtime_of "$LOCK") ))
  (( lock_age > 7200 )) && rmdir "$LOCK" 2>/dev/null || true
fi
mkdir "$LOCK" 2>/dev/null || { log "another curator run holds the lock; exiting"; exit 0; }
srcdir=""
cleanup() { [[ -n "$srcdir" ]] && rm -rf "$srcdir"; rmdir "$LOCK" 2>/dev/null || true; }
trap cleanup EXIT

# --- 0) kill-switch / TTL sweep: evict curator memories older than TTL_DAYS ------------------------
sweep_stale() {
  local cutoff; cutoff="$(python3 -c "import time;print(int(time.time())-$TTL_DAYS*86400)")"
  local listed; listed="$(curl -fsS "$HS/v1/default/banks/$BANK/memories/list?tags=curator&limit=500" 2>/dev/null || echo '{}')"
  # Only evict rows we can positively date as stale. Hindsight's async extraction can spawn derived
  # rows without our metadata; treat a missing/unparseable written_at as "keep" (never evict blind).
  echo "$listed" | jq -r --argjson cut "$cutoff" '
    (.memories // .results // [])[]
    | (.metadata.written_at // "") as $wa
    | select($wa != "" and (($wa | tonumber?) // null) != null and ($wa | tonumber) < $cut)
    | .document_id // empty' 2>/dev/null | sort -u | while read -r doc; do
      [[ -n "$doc" ]] || continue
      # doc_id comes from the server; only act on our own well-formed ids and urlencode to be safe.
      [[ "$doc" =~ ^curator-[0-9a-f]{12}$ ]] || continue
      curl -fsS -G -X DELETE "$HS/v1/default/banks/$BANK/memories" --data-urlencode "document_id=$doc" >/dev/null 2>&1 \
        && log "swept stale memory $doc"
    done
}
sweep_stale || log "sweep failed (non-fatal)"

# --- 1) gather a bounded slice of source material since the watermark -----------------------------
since_epoch=0
if [[ -f "$WATERMARK" ]]; then since_epoch="$(cat "$WATERMARK" 2>/dev/null || echo 0)"; fi
[[ "$since_epoch" =~ ^[0-9]+$ ]] || since_epoch=0
if [[ "$since_epoch" -eq 0 ]]; then
  since_epoch="$(python3 -c "import time;print(int(time.time())-$LOOKBACK_HOURS*3600)")"
fi
now_epoch="$(date +%s)"
srcdir="$(mktemp -d)"
manifest="$srcdir/manifest.txt"; : >"$manifest"
# Reference file stamped at the watermark, so `find -newer` works on both BSD (macOS) and GNU find
# (`-newermt "@epoch"` is GNU-only and silently fails on macOS).
since_ref="$srcdir/.since"
touch -t "$(python3 -c "import time;print(time.strftime('%Y%m%d%H%M.%S', time.localtime($since_epoch)))")" "$since_ref"

# Collect ALL candidates (path + mtime) first, then keep the NEWEST MAX_SOURCE_DOCS after sorting.
# Truncating before sorting (the old bug) would drop an arbitrary subset; combined with the watermark
# that subset would never be reconsidered. mtime-sort ensures we always process the freshest docs.
cand="$srcdir/cand.txt"; : >"$cand"
add_cand() { # $1 = file path
  local f="$1"; [[ -f "$f" ]] || return 0
  local m; m="$(mtime_of "$f")"
  printf '%s\t%s\n' "$m" "$f" >>"$cand"
}
# agent-fleet transcripts newer than the watermark, EXCLUDING the curator's own runs (no feedback loop).
if [[ -d "$TASKS_DIR" ]]; then
  while IFS= read -r f; do add_cand "$f"; done < <(
    find "$TASKS_DIR" -type f -name 'final.txt' -newer "$since_ref" 2>/dev/null | grep -v -- '-memory-curator-')
fi
# private-docs changed since the watermark (git-tracked deltas; fall back to mtime).
if [[ -d "$PRIVATE_DOCS" ]]; then
  if git -C "$PRIVATE_DOCS" rev-parse --git-dir >/dev/null 2>&1; then
    while IFS= read -r f; do add_cand "$f"; done < <(
      git -C "$PRIVATE_DOCS" log --since="@$since_epoch" --name-only --pretty=format: -- '*.md' 2>/dev/null \
        | awk 'NF' | sort -u | sed "s#^#$PRIVATE_DOCS/#")
  else
    while IFS= read -r f; do add_cand "$f"; done < <(
      find "$PRIVATE_DOCS" -type f -name '*.md' -newer "$since_ref" 2>/dev/null)
  fi
fi

# Keep newest MAX_SOURCE_DOCS by mtime. If we truncate, cap the watermark to the OLDEST included
# mtime so the excess (older) docs stay in-window next run instead of being lost behind the watermark.
total_cand="$(grep -c . "$cand" 2>/dev/null | head -1 || echo 0)"; [[ "$total_cand" =~ ^[0-9]+$ ]] || total_cand=0
sort -rn "$cand" | head -n "$MAX_SOURCE_DOCS" | cut -f2- >"$manifest"
watermark_cap="$now_epoch"
if (( total_cand > MAX_SOURCE_DOCS )); then
  watermark_cap="$(sort -rn "$cand" | head -n "$MAX_SOURCE_DOCS" | tail -1 | cut -f1)"
  log "note: $total_cand candidates > cap $MAX_SOURCE_DOCS; watermark held at $watermark_cap so older docs remain in-window"
fi
sort -u "$manifest" -o "$manifest"
n_src="$(grep -c . "$manifest" 2>/dev/null | head -1 || echo 0)"
[[ "$n_src" =~ ^[0-9]+$ ]] || n_src=0
if [[ "$n_src" -eq 0 ]]; then
  log "no new source material since $since_epoch; nothing to curate"
  echo "$now_epoch" >"$WATERMARK"
  exit 0
fi
log "curating from $n_src source docs (since $since_epoch)"

# Build the prompt: persona body + the source material (path-labelled, size-capped per doc). The
# whole prompt is passed as a single argv to mewritecode, so it must stay under ARG_MAX; cap the
# TOTAL bytes (not just doc count). Docs are newest-first, so truncation drops the oldest, which the
# watermark-cap already keeps in-window for next run.
PROMPT_MAX_BYTES="${MEMORY_CURATOR_PROMPT_MAX_BYTES:-96000}"
PER_DOC_BYTES="${MEMORY_CURATOR_PER_DOC_BYTES:-8000}"
persona="$(awk 'BEGIN{fm=0} /^---$/{fm++;next} fm>=2{print}' "$AGENT_DEF")"
promptfile="$srcdir/prompt.md"
{
  printf '%s\n\n---\n\n# Source material for this run\n\n' "$persona"
  printf 'Consider ONLY the documents below. Cite them by their `id:` when you emit a memory.\n\n'
} >"$promptfile"
included=0
while IFS= read -r f; do
  [[ -f "$f" ]] || continue
  cur=$(wc -c <"$promptfile")
  (( cur >= PROMPT_MAX_BYTES )) && { log "prompt byte budget reached ($PROMPT_MAX_BYTES); including $included of $n_src docs"; break; }
  { printf '## id: %s\n\n```\n' "$f"; head -c "$PER_DOC_BYTES" "$f" 2>/dev/null; printf '\n```\n\n'; } >>"$promptfile"
  included=$((included+1))
done <"$manifest"
printf 'Emit ONLY the JSON object per your output contract. Empty is fine.\n' >>"$promptfile"

# --- 2) run the curator persona -------------------------------------------------------------------
log "running memory-curator ($MODEL)"
agent_ok=1
raw="$("$TIMEOUT_BIN" "${RUN_TIMEOUT}s" \
  "$MEWRITE" exec --model "$MODEL" "$(<"$promptfile")" 2>"$srcdir/agent.err" </dev/null)" || agent_ok=0
[[ "$agent_ok" -eq 1 ]] || log "agent run failed/timed out; will NOT advance watermark (source stays in-window)"

# Extract the JSON object even if the model wrapped it in prose/fences.
json="$(printf '%s' "$raw" | python3 -c '
import sys,re,json
s=sys.stdin.read()
m=re.search(r"\{.*\}", s, re.S)
if not m: print("{\"memories\":[]}"); sys.exit()
try:
    d=json.loads(m.group(0)); print(json.dumps(d))
except Exception:
    print("{\"memories\":[]}")
')"

# --- 3) deterministic filter + dedup + WRITE ------------------------------------------------------
# Reject-shape: the wrapper never trusts the model verbatim. Drop junk shapes, secrets, bad sizes.
reject_shape() {
  local c="$1"
  local len=${#c}
  (( len < 40 || len > 1200 )) && return 0
  # Anchor to completion/status PHRASING (not bare words like "verdict"/"run id" which appear in
  # legitimate durable memories) so we drop provenance noise without false-positiving good content.
  printf '%s' "$c" | grep -Eqi 'reviewed with (a )?verdict|verdict (of|was) (comment|approve|request)|head (commit|sha) (is|=)|run (id|identifier) (is|=)|^PR [^ ]+#[0-9]+ (reviewed|approved|merged)' && return 0
  # Broadened secret shapes: all GitHub token prefixes + fine-grained PATs, Google API keys, AWS
  # access-key IDs, JWTs, Slack tokens, PEM blocks, URL-embedded creds, bearer/x-access tokens, and a
  # generic `secret/token/password: <value>` heuristic. This is the only deterministic backstop
  # before content reaches the world-readable bank, so it errs toward over-matching.
  printf '%s' "$c" | grep -Eqi \
    'gh[oprsu]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|ddpat_[A-Za-z0-9]|xox[baprs]-|slack-|AIza[0-9A-Za-z_-]{20,}|AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.|-----BEGIN|x-access-token:|https?://[^ ]*:[^ @]*@|(secret|token|password|api[_-]?key|bearer)["'"'"' ]*[:=]["'"'"' ]*[A-Za-z0-9/_+.-]{12,}' && return 0
  return 1
}

written=0; rejected=0; deduped=0
count="$(printf '%s' "$json" | jq '.memories | length' 2>/dev/null || echo 0)"
[[ "$count" =~ ^[0-9]+$ ]] || count=0
for (( i=0; i<count; i++ )); do
  (( written >= MAX_MEMORIES )) && { log "reached MAX_MEMORIES=$MAX_MEMORIES"; break; }
  item="$(printf '%s' "$json" | jq -c ".memories[$i]" 2>/dev/null)" || continue
  content="$(printf '%s' "$item" | jq -r '.content // empty')"
  [[ -n "$content" ]] || continue
  is_conv="$(printf '%s' "$item" | jq -r '.convention // false')"
  n_sources="$(printf '%s' "$item" | jq -r '(.sources // []) | length')"

  # convention phrasing requires >=2 independent sources.
  if [[ "$is_conv" == "true" && "${n_sources:-0}" -lt 2 ]]; then
    log "reject (convention <2 sources): ${content:0:60}"; rejected=$((rejected+1)); continue
  fi
  if reject_shape "$content"; then
    log "reject (shape/secret/size): ${content:0:60}"; rejected=$((rejected+1)); continue
  fi

  # dedup: recall the bank; skip if ANY of the top hits is a near-duplicate (not just the first).
  hits="$(curl -fsS -X POST "$HS/v1/default/banks/$BANK/memories/recall" -H 'content-type: application/json' \
        -d "$(jq -cn --arg q "$content" '{query:$q,limit:5}')" 2>/dev/null \
        | jq -r '((.results // .memories // [])[].text // empty)' 2>/dev/null || echo "")"
  if [[ -n "$hits" ]] && printf '%s' "$hits" | python3 -c '
import sys
cand=set(sys.argv[1].lower().split())
for line in sys.stdin:
    b=set(line.lower().split())
    if b and len(cand&b)/max(1,len(cand|b))>=0.6: sys.exit(0)
sys.exit(1)
' "$content"
  then
    log "dedup skip (near-match exists): ${content:0:60}"; deduped=$((deduped+1)); continue
  fi

  doc="curator-$(printf '%s' "$content" | python3 -c 'import sys,hashlib;print(hashlib.sha1(sys.stdin.buffer.read()).hexdigest()[:12])')"
  body="$(jq -cn --arg c "$content" --arg d "$doc" --arg wa "$now_epoch" --arg ver "$CURATOR_VERSION" \
    --argjson src "$(printf '%s' "$item" | jq -c '.sources // []')" '
    {async:false, items:[{content:$c, document_id:$d, update_mode:"replace",
      tags:["curator", $ver], metadata:{curator_version:$ver, written_at:$wa, source_docs:($src|join(","))}}]}')"
  resp="$(curl -fsS -X POST "$HS/v1/default/banks/$BANK/memories" -H 'content-type: application/json' -d "$body" 2>/dev/null || echo '{}')"
  if [[ "$(printf '%s' "$resp" | jq -r '.success // false' 2>/dev/null)" == "true" ]]; then
    written=$((written+1)); log "wrote $doc: ${content:0:70}"
  else
    log "WRITE FAILED for $doc: $(printf '%s' "$resp" | head -c 200)"
  fi
done

log "run complete: written=$written rejected=$rejected deduped=$deduped (from $n_src docs)"
# Advance the watermark only if the agent actually ran. On failure, leave it so the whole window is
# reprocessed next run (writes are idempotent: stable doc_id + replace + dedup). When we truncated to
# the newest MAX_SOURCE_DOCS, cap the watermark to the oldest included mtime so the older excess is
# reconsidered next run instead of being lost.
if [[ "$agent_ok" -eq 1 ]]; then
  echo "$watermark_cap" >"$WATERMARK"
else
  log "watermark NOT advanced (agent run failed); source window will be retried next run"
fi
