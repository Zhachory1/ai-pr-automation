#!/usr/bin/env bash
# doc-writer-server — serial queue-draining worker for the 'doc-write' kind.
#
# Claims one doc-write request at a time and runs bin/doc-writer (the harness) to draft a Rokt PRD
# or Design Doc. Mirrors bin/agent-server's concurrency machinery (renewable DB lease + nonce
# fencing; reclaim; FOR UPDATE SKIP LOCKED claim; heartbeat self-exit) via lib/queue.sh. No GitHub
# token — documents are local; exact approved bytes are the only inbox side effect.
#
# Request payload (requests.kind = 'doc-write'):
#   { "doc_type": "seprd"|"mlprd"|"launchpad"|"dd",
#     "title": "<title>", "requirements": "<goals & requirements>",
#     "round": N,                            # refine round (1 = first draft)
#     "prior_draft": "<stage path>",         # round>1: the prior draft to revise
#     "answers": "<human answers>",          # round>1: answers to the open questions
#     "finalize": true|false }               # skip remaining questions -> council + write
# The harness routes: open questions -> human-review queue (answer loop); finalize/no-questions ->
# council review + exact-byte approval; approved publication sets requests.posted_ref.
set -euo pipefail
umask 077

HERE="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/queue.sh
. "$HERE/lib/queue.sh"

KIND=doc-write
POLL_INTERVAL="${DOC_WRITER_POLL_INTERVAL:-15}"
PER_REQUEST_TIMEOUT="${DOC_WRITER_PER_REQUEST_TIMEOUT:-1800}"   # 25m ceiling (agent draft + council)
LOOP_HEARTBEAT_MAX="${DOC_WRITER_LOOP_HEARTBEAT_MAX:-7200}"
ONCE="${DOC_WRITER_ONCE:-false}"
HARNESS="${DOC_WRITER_HARNESS:-$HERE/bin/doc-writer}"
RUNTIME="${DOC_WRITER_RUNTIME:-legacy}"
HERMES_API_KEY="${HERMES_DOC_API_KEY:-}"
HERMES_PROVIDER_KEY="${HERMES_DOC_PROVIDER_KEY:-}"
LEGACY_API_KEY="${OPENAI_API_KEY:-}"
PUBLICATION_BIN="${DOC_WRITER_PUBLICATION_BIN:-$HERE/bin/doc-writer-publication}"
STAGE_DIR="${DOC_WRITER_STAGE_DIR:-$HOME/.local/share/ai-pr-automation/doc-writer}"
INBOX_DIR="${DOC_WRITER_INBOX_DIR:-$HOME/private-docs/inbox}"
# Renewable DB lease + nonce fencing (same model as agent-server since #58). A background heartbeat
# renews the lease while the long-running harness works; reclaim only requeues expired leases.
LEASE_SECONDS="${DOC_WRITER_LEASE_SECONDS:-120}"
LEASE_HEARTBEAT="${DOC_WRITER_LEASE_HEARTBEAT:-30}"
LEASE_DB_TIMEOUT="${DOC_WRITER_LEASE_DB_TIMEOUT:-10}"
[[ "$LEASE_SECONDS" =~ ^[1-9][0-9]*$ && "$LEASE_HEARTBEAT" =~ ^[1-9][0-9]*$ && "$LEASE_DB_TIMEOUT" =~ ^[1-9][0-9]*$ ]] \
  || { echo "lease seconds, heartbeat, and DB timeout must be positive integers" >&2; exit 2; }
(( LEASE_HEARTBEAT * 3 <= LEASE_SECONDS && 2 * (LEASE_HEARTBEAT + LEASE_DB_TIMEOUT) + 2 <= LEASE_SECONDS )) \
  || { echo "lease must cover two heartbeat+DB-timeout windows with safety margin" >&2; exit 2; }

ts() { date '+%Y-%m-%dT%H:%M:%S%z'; }
log() { echo "$(ts) doc-writer-server $*"; }
trip_guardrail() {
  if [[ "$RUNTIME" == hermes ]]; then
    SHUTDOWN_REQUESTED=true
    log "Hermes guardrail tripped; stopping before next claim"
  fi
}
need() { command -v "$1" >/dev/null 2>&1 || { echo "missing dependency: $1" >&2; exit 2; }; }
need psql; need jq; need python3
[[ -x "$HARNESS" ]] || { echo "missing harness: $HARNESS" >&2; exit 2; }
[[ -x "$PUBLICATION_BIN" ]] || { echo "missing publication helper: $PUBLICATION_BIN" >&2; exit 2; }
TIMEOUT_BIN="$(command -v timeout || command -v gtimeout || true)"
[[ -n "$TIMEOUT_BIN" ]] || { echo "GNU timeout required (coreutils)" >&2; exit 2; }
db_up() { _psql <<<"SELECT 1;" >/dev/null 2>&1; }
case "$RUNTIME" in
  hermes)
    [[ "${HERMES_DOC_APPROVED_GENERATION:-}" =~ ^[0-9a-f]{64}$ ]] \
      || { echo "HERMES_DOC_APPROVED_GENERATION must be SHA-256" >&2; exit 2; }
    [[ -n "${HERMES_DOC_URL:-}" && ${#HERMES_API_KEY} -ge 16 && ${#HERMES_PROVIDER_KEY} -ge 20 ]] \
      || { echo "Hermes URL, API key, and provider key are required" >&2; exit 2; }
    ;;
  legacy)
    [[ ${#LEGACY_API_KEY} -ge 20 ]] || { echo "OPENAI_API_KEY is required for legacy runtime" >&2; exit 2; }
    ;;
  *) echo "DOC_WRITER_RUNTIME must be legacy or hermes" >&2; exit 2 ;;
esac

# --- renewable lease heartbeat (mirrors agent-server) ---
WORKER_PID="$$"
ACTIVE_CHILD=""
LEASE_HEARTBEAT_PID=""
SHUTDOWN_REQUESTED=false
request_shutdown() { SHUTDOWN_REQUESTED=true; log "shutdown requested; draining active request"; }
abort_lost_lease() {
  log "worker lost its lease; aborting active request"
  stop_lease_heartbeat
  if [[ -n "$ACTIVE_CHILD" ]]; then
    kill -TERM "$ACTIVE_CHILD" 2>/dev/null || true; sleep 2
    kill -KILL "$ACTIVE_CHILD" 2>/dev/null || true; wait "$ACTIVE_CHILD" 2>/dev/null || true
  fi
  exit 143
}
trap request_shutdown TERM INT
trap abort_lost_lease USR1
start_lease_heartbeat() {
  local id="$1" nonce="$2"
  (
    failures=0
    while sleep "$LEASE_HEARTBEAT"; do
      state="$("$TIMEOUT_BIN" --kill-after=2s "${LEASE_DB_TIMEOUT}s" bash -c \
        '. "$1"; queue_renew_lease "$2" "$3" "$4"' _ "$HERE/lib/queue.sh" "$id" "$nonce" "$LEASE_SECONDS" \
        2>/dev/null)" || state=error
      case "$state" in
        renewed) failures=0 ;;
        finished) exit 0 ;;
        lost) log "FATAL: lease lost for request $id; stopping worker"; kill -USR1 "$WORKER_PID"; exit 1 ;;
        *) failures=$((failures + 1)); (( failures < 2 )) && continue
           log "FATAL: lease renewal failed twice for request $id; stopping worker"; kill -USR1 "$WORKER_PID"; exit 1 ;;
      esac
    done
  ) &
  LEASE_HEARTBEAT_PID="$!"
}
stop_lease_heartbeat() {
  [[ -n "$LEASE_HEARTBEAT_PID" ]] || return 0
  kill "$LEASE_HEARTBEAT_PID" 2>/dev/null || true
  wait "$LEASE_HEARTBEAT_PID" 2>/dev/null || true
  LEASE_HEARTBEAT_PID=""
}

# Insert a doc-open-questions item into the human-review queue so the operator can answer and refine.
queue_doc_review() {
  local id="$1" nonce="$2" doc_type="$3" title="$4" draft_path="$5" oq_json="$6" round="$7"
  local n; n="$(printf '%s' "$oq_json" | jq 'length')"
  local proposal prov
  proposal="$(jq -cn --arg dt "$doc_type" --arg t "$title" --arg dp "$draft_path" \
    --argjson oq "$oq_json" --argjson r "$round" --arg s "$n open question(s) on '$title' ($doc_type), round $round" \
    '{kind:"doc-open-questions", doc_type:$dt, title:$t, draft_path:$dp, open_questions:$oq, round:$r, summary:$s}')"
  prov="$(jq -cn --arg rid "$id" --argjson r "$round" '{request_id:$rid, round:$r}')"
  pending_doc_review_finish "$id" "$proposal" "$prov" "queued: awaiting answers (round $round)" "$nonce" | grep -qx 1
}

process_publication() {
  local id="$1" nonce="$2" publication staged target digest generation result status
  publication="$(doc_publication_claimed "$id" "$nonce")"
  [[ -n "$publication" ]] || { queue_mark_reconcile "$id" "approved publication state missing" "$nonce" >/dev/null; return; }
  staged="$(jq -r .staged_path <<<"$publication")"
  target="$(jq -r .target_path <<<"$publication")"
  digest="$(jq -r .content_digest <<<"$publication")"
  generation="$(jq -r .document_generation <<<"$publication")"
  if [[ -z "$(doc_publication_prepare "$id" "$target" "$digest" "$generation" "$nonce")" ]]; then
    queue_mark_reconcile "$id" "publication prepare lost queue ownership" "$nonce" >/dev/null 2>&1 || true
    return
  fi
  local outfile rc=0
  outfile="$(mktemp)"
  "$PUBLICATION_BIN" publish --stage-root "$STAGE_DIR" --inbox-root "$INBOX_DIR" \
    --staged-path "$staged" --target-path "$target" --digest "$digest" >"$outfile" &
  ACTIVE_CHILD="$!"
  wait "$ACTIVE_CHILD" || rc=$?
  ACTIVE_CHILD=""
  result="$(cat "$outfile")"
  rm -f "$outfile"
  if (( rc != 0 )); then
    log "request $id reconcile (publication helper failed)"
    return
  fi
  status="$(jq -r '.status // empty' <<<"$result")"
  if [[ "$status" == published || "$status" == matching ]]; then
    if [[ -n "$(doc_publication_mark_published "$id" "$target" "$digest" "$generation")" ]]; then
      log "request $id done: published $target"
    else
      log "request $id reconcile (target published but DB settlement failed)"
    fi
  else
    log "request $id reconcile (publication status=$status)"
  fi
}

process_one() {
  local id="$1" payload="$2" run_id="$3" nonce="$4" generated_at="$5"
  local doc_type title round; doc_type="$(jq -r '.doc_type // empty' <<<"$payload")"
  title="$(jq -r '.title // empty' <<<"$payload")"; round="$(jq -r '.round // 1' <<<"$payload")"
  if [[ -z "$doc_type" || -z "$title" ]]; then
    queue_mark_failed "$id" "invalid doc-write payload (need doc_type,title)" "$nonce" >/dev/null; return 0
  fi
  if [[ "$(jq -r '.publication_only // false' <<<"$payload")" == true ]]; then
    process_publication "$id" "$nonce"
    return 0
  fi

  local outfile; outfile="$(mktemp)"; local rc=0
  DOC_WRITER_REQUEST_ID="$id" DOC_WRITER_QUEUE_NONCE="$nonce" DOC_WRITER_GENERATED_AT="$generated_at" \
    "$TIMEOUT_BIN" --kill-after=15s "${PER_REQUEST_TIMEOUT}s" \
    "$HARNESS" --payload "$payload" >"$outfile" 2>>/dev/stderr &
  ACTIVE_CHILD="$!"
  wait "$ACTIVE_CHILD" || rc=$?
  ACTIVE_CHILD=""

  # The harness prints exactly one machine-JSON result line on stdout; logs went to stderr.
  local result; result="$(grep -E '^\{"status":' "$outfile" | tail -1)"
  rm -f "$outfile"
  local status=""
  [[ -z "$result" ]] || status="$(jq -r '.status // empty' <<<"$result" 2>/dev/null || true)"
  if [[ "$status" == reconcile ]]; then
    local reason; reason="$(jq -r '.reason // "Hermes model phase requires reconciliation"' <<<"$result")"
    queue_mark_reconcile "$id" "$reason" "$nonce" >/dev/null
    log "request $id reconcile (model phase)"; trip_guardrail; return 0
  fi
  if (( rc != 0 )) || [[ -z "$result" ]]; then
    if [[ "$RUNTIME" == hermes && "$status" != failed ]]; then
      queue_mark_reconcile "$id" "Hermes harness ended without terminal metadata (rc=$rc)" "$nonce" >/dev/null
      log "request $id reconcile (ambiguous harness exit rc=$rc)"
    else
      queue_mark_failed "$id" "doc-writer harness rc=$rc" "$nonce" >/dev/null
      log "request $id failed (rc=$rc)"
    fi
    [[ "$RUNTIME" == hermes ]] && trip_guardrail
    return 0
  fi
  case "$status" in
    open_questions)
      local draft_path oq_json
      draft_path="$(jq -r '.draft_path' <<<"$result")"
      oq_json="$(jq -c '.open_questions' <<<"$result")"
      if queue_doc_review "$id" "$nonce" "$doc_type" "$title" "$draft_path" "$oq_json" "$round"; then
        log "request $id queued for human answers (round $round)"
      else
        queue_mark_reconcile "$id" "draft staged but human-review insert failed" "$nonce" >/dev/null
        log "request $id reconcile (review insert failed)"; trip_guardrail
      fi ;;
    awaiting_approval)
      local staged_path target_path digest generation council proposal prov
      staged_path="$(jq -r '.staged_path' <<<"$result")"
      target_path="$(jq -r '.target_path' <<<"$result")"
      digest="$(jq -r '.content_digest' <<<"$result")"
      generation="$(jq -r '.document_generation' <<<"$result")"
      council="$(jq -r '.council' <<<"$result")"
      proposal="$(jq -cn --arg kind doc-publication-approval --arg title "$title" --arg target "$target_path" \
        --arg staged "$staged_path" --arg digest "$digest" --arg generation "$generation" --arg council "$council" \
        --arg summary "'$title' is staged for exact-byte publication approval" \
        '{kind:$kind,title:$title,target_path:$target,staged_path:$staged,content_digest:$digest,
          document_generation:$generation,council:$council,summary:$summary}')"
      prov="$(jq -cn --arg rid "$id" '{request_id:$rid,approval:"exact-bytes"}')"
      if [[ -n "$(doc_publication_stage "$id" "$target_path" "$digest" "$generation" "$proposal" "$prov" "$nonce")" ]]; then
        log "request $id done: awaiting exact publication approval for $target_path"
      else
        queue_mark_reconcile "$id" "failed to record publication approval" "$nonce" >/dev/null
        log "request $id reconcile (publication approval insert failed)"; trip_guardrail
      fi ;;
    *)
      queue_mark_failed "$id" "doc-writer returned status=$status" "$nonce" >/dev/null
      log "request $id failed (status=$status)"; trip_guardrail ;;
  esac
  return 0
}

db_up || { echo "request database unavailable during startup" >&2; exit 2; }
if [[ "$RUNTIME" == legacy ]]; then
  hermes_doc_quarantine >/dev/null
else
  [[ "$(hermes_doc_active_count)" == 0 ]] || {
    echo "unresolved active Hermes request blocks controller startup" >&2
    exit 2
  }
fi

log "doc-writer-server up (leased, kind=$KIND, runtime=$RUNTIME); poll ${POLL_INTERVAL}s, lease ${LEASE_SECONDS}s/${LEASE_HEARTBEAT}s heartbeat"
last_progress="$(date +%s)"

while true; do
  [[ "$SHUTDOWN_REQUESTED" == true ]] && { stop_lease_heartbeat; exit 0; }
  now="$(date +%s)"
  if (( now - last_progress > LOOP_HEARTBEAT_MAX )); then
    log "FATAL: no loop progress in ${LOOP_HEARTBEAT_MAX}s; self-exiting for restart"; exit 3
  fi
  if ! db_up; then log "db unreachable; backing off"; sleep "$POLL_INTERVAL"; continue; fi

  nonce="$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  run_id="$(date '+%Y%m%d-%H%M%S')-${HOSTNAME:-worker}-${nonce:0:8}"
  if ! claim="$(queue_claim_one "$KIND" "$run_id" "$nonce" "$LEASE_SECONDS")"; then
    log "claim failed; backing off"; sleep "$POLL_INTERVAL"; continue
  fi
  last_progress="$now"
  if [[ -z "$claim" || "$claim" == "null" ]]; then sleep "$POLL_INTERVAL"; continue; fi

  id="$(jq -r '.id' <<<"$claim")"
  payload="$(jq -c '.payload' <<<"$claim")"
  dedupe_key="$(jq -r '.dedupe_key' <<<"$claim")"
  generated_at="$(jq -r '.created_at' <<<"$claim")"
  log "claimed request $id ($dedupe_key)"
  start_lease_heartbeat "$id" "$nonce"
  process_one "$id" "$payload" "$run_id" "$nonce" "$generated_at" || log "process_one error for $id"
  stop_lease_heartbeat
  if [[ "$RUNTIME" == hermes ]]; then
    final_status="$(_psql -v id="$id" <<<"SELECT status FROM requests WHERE id=:'id';")"
    [[ "$final_status" == "done" ]] || trip_guardrail
  fi
  [[ "$ONCE" == true ]] && exit 0
  last_progress="$(date +%s)"
  [[ "$SHUTDOWN_REQUESTED" == true ]] && exit 0
done
