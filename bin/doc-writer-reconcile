#!/usr/bin/env bash
set -euo pipefail
umask 077

HERE="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/queue.sh
. "$HERE/lib/queue.sh"
PUBLICATION_BIN="${DOC_WRITER_PUBLICATION_BIN:-$HERE/bin/doc-writer-publication}"
STAGE_DIR="${DOC_WRITER_STAGE_DIR:-$HOME/.local/share/ai-pr-automation/doc-writer}"
INBOX_DIR="${DOC_WRITER_INBOX_DIR:-$HOME/private-docs/inbox}"

id="${1:-}"
action="${2:-}"
[[ "$id" =~ ^[1-9][0-9]*$ ]] || { echo "usage: doc-writer-reconcile <request-id> --inspect|--complete-matching|--publish-absent" >&2; exit 2; }
case "$action" in --inspect|--complete-matching|--publish-absent) ;; *) echo "invalid action" >&2; exit 2;; esac
[[ -x "$PUBLICATION_BIN" ]] || { echo "missing publication helper" >&2; exit 2; }

publication="$(doc_publication_reconcile_state "$id")"
[[ -n "$publication" ]] || { echo "request $id has no reconcilable approved publication" >&2; exit 1; }
staged="$(jq -r .staged_path <<<"$publication")"
target="$(jq -r .target_path <<<"$publication")"
digest="$(jq -r .content_digest <<<"$publication")"
generation="$(jq -r .document_generation <<<"$publication")"
inspection="$($PUBLICATION_BIN inspect --inbox-root "$INBOX_DIR" --target-path "$target" --digest "$digest")"
status="$(jq -r .status <<<"$inspection")"

if [[ "$action" == --inspect ]]; then
  jq -cn --argjson publication "$publication" --argjson inspection "$inspection" \
    '{publication:$publication,target:$inspection}'
  exit 0
fi
if [[ "$action" == --complete-matching ]]; then
  [[ "$status" == matching ]] || { echo "target is $status, not matching" >&2; exit 1; }
else
  [[ "$status" == absent ]] || { echo "target is $status, not absent" >&2; exit 1; }
  result="$($PUBLICATION_BIN publish --stage-root "$STAGE_DIR" --inbox-root "$INBOX_DIR" \
    --staged-path "$staged" --target-path "$target" --digest "$digest")"
  published="$(jq -r .status <<<"$result")"
  [[ "$published" == published || "$published" == matching ]] || { echo "publication failed: $published" >&2; exit 1; }
fi

[[ -n "$(doc_publication_reconcile_published "$id" "$target" "$digest" "$generation")" ]] \
  || { echo "database reconciliation failed" >&2; exit 1; }
echo "reconciled request $id as published: $target"
