    <key>HERMES_KANBAN_BRIDGE_HOST_HEADER</key><string>__BRIDGE_HOST_HEADER__</string>
    <key>HERMES_KANBAN_BRIDGE_STATE_ROOT</key><string>__BRIDGE_STATE_ROOT__</string>
    <key>HERMES_KANBAN_BRIDGE_KEY_FILE</key><string>__BRIDGE_KEY_FILE__</string>
