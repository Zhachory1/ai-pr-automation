<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.ai-pr-automation-hermes-dashboard</string>
  <key>UserName</key><string>__HERMES_USER__</string>
  <key>ProgramArguments</key><array>
    <string>__HERMES_BIN__</string><string>dashboard</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>9119</string>
    <string>--no-open</string><string>--isolated</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>__SERVICE_HOME__</string>
    <key>HERMES_HOME</key><string>__HERMES_HOME__</string>
    <key>PATH</key><string>__SERVICE_HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>WorkingDirectory</key><string>__SERVICE_HOME__</string>
  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>__LOG_ROOT__/dashboard.out.log</string>
  <key>StandardErrorPath</key><string>__LOG_ROOT__/dashboard.err.log</string>
</dict></plist>
