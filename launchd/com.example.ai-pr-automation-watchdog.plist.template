<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.ai-pr-automation-watchdog</string>
  <!-- Runs as root: it must create the root-owned maintenance file and boot out system daemons. -->
  <key>ProgramArguments</key><array><string>__WATCHDOG__</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>HERMES_MAINTENANCE_FILE</key><string>__MAINTENANCE_FILE__</string>
    <key>HERMES_GATEWAY_LABEL</key><string>com.example.ai-pr-automation-hermes</string>
    <key>HERMES_DISPATCHER_LABEL</key><string>com.example.ai-pr-automation-dispatcher</string>
    <key>REQUESTS_DB_HOST</key><string>127.0.0.1</string>
    <key>REQUESTS_DB_PORT</key><string>__DB_PORT__</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>__LOG_ROOT__/watchdog.out.log</string>
  <key>StandardErrorPath</key><string>__LOG_ROOT__/watchdog.err.log</string>
</dict></plist>
